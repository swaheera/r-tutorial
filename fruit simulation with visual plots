# a pipeline is homogeneous if both forecasted series use the same model name
same_model <- function(...) {
  m <- cbind(...)
  apply(m, 1, function(r) {
    r <- r[!is.na(r)]
    if (length(unique(r)) == 1) r[1] else NA_character_
  })
}

