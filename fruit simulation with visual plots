# E. CV TABLE FOR THE WINNER(S): one row per fold
# =============================================================================
section("E. CV table per fold for the winner(s)")
# actual / forecast = sum over the 12 test months
# monthly_mape = average % error per month; yearly_mape = % error of the 12-month sum

cv_table <- function(combo_name) {
  d       <- series_list[[FA]]
  o       <- cv_origins(d)
  tr_from <- if (is.null(WINDOW)) rep(1, length(o)) else pmax(1, o - WINDOW + 1)
  folds   <- tibble(origin = d$date[o],
                    trained_on = paste(ym(d$date[tr_from]), "to", ym(d$date[o])),
                    tested_on  = paste(ym(d$date[o + 1]), "to", ym(d$date[o + H])))

  wide_tbl <- grid_long |>
    filter(combo == combo_name) |>
    group_by(origin, series) |>
    summarise(monthly_mape = mean(abs(actual - fc) / actual) * 100,
              act_sum      = sum(actual),
              fc_sum       = sum(fc),
              .groups      = "drop") |>
    mutate(yearly_mape = abs(act_sum - fc_sum) / act_sum * 100) |>
    rename(actual = act_sum, forecast = fc_sum) |>
    pivot_wider(names_from = series, values_from = c(actual, forecast, monthly_mape, yearly_mape),
                names_glue = "{series}_{.value}")

  cols <- unlist(lapply(c("total", FA, FB),
                        function(s) paste0(s, c("_actual", "_forecast", "_monthly_mape", "_yearly_mape"))))
  tbl <- folds |>
    left_join(wide_tbl, by = "origin") |>
    select(trained_on, tested_on, all_of(cols)) |>
    mutate(across(ends_with(c("_actual", "_forecast")), round),
           across(ends_with("_mape"), ~ round(.x, 2)))

  # last row: average MAPE over folds
  avg_row <- tbl |>
    summarise(across(ends_with("_mape"), ~ round(mean(.x, na.rm = TRUE), 2))) |>
    mutate(trained_on = "Average over folds", tested_on = "")
  bind_rows(tbl, avg_row)
}

