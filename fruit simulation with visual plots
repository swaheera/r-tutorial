  summarise(e = mean(fcg - fc0), .groups = "drop") |>
  group_by(series, label = model) |>
  summarise(estimate = mean(e, na.rm = TRUE), sd = sd(e, na.rm = TRUE), .groups = "drop") |>
  mutate(kind = "Single model on its own series") |>
  eff_finish()

# winning pipelines: rebuild the three series under both scenarios, per strategy
pipeline_eff <- function(combo_name, kind) {
  row  <- filter(overall, combo == combo_name)
  comp <- function(m, s, nm) {
    if (is.na(m)) return(NULL)
    base |> filter(model == m, series == s) |>
      transmute(origin, date, !!paste0(nm, "0") := fc0, !!paste0(nm, "g") := fcg)
  }
  parts <- Filter(Negate(is.null), list(comp(row$m_t, "total", "t"), comp(row$m_a, FA, "a"),
                                        comp(row$m_b, FB, "b"), comp(row$m_s, "share", "s")))
  dd <- Reduce(function(x, y) inner_join(x, y, by = c("origin", "date")), parts)
  derive <- function(v) {
    t <- dd[[paste0("t", v)]]; a <- dd[[paste0("a", v)]]; b <- dd[[paste0("b", v)]]; sh <- dd[[paste0("s", v)]]
    if (row$strategy == S_AB) return(setNames(list(a, b, a + b), series_lvls))
    if (row$strategy == S_TA) return(setNames(list(a, t - a, t), series_lvls))
    if (row$strategy == S_TB) return(setNames(list(t - b, b, t), series_lvls))
    setNames(list(t * sh, t * (1 - sh), t), series_lvls)
  }
  d0 <- derive("0")
  dg <- derive("g")
  bind_rows(lapply(series_lvls, function(s) {
    tibble(origin = dd$origin, diff = dg[[s]] - d0[[s]]) |>
      group_by(origin) |>
      summarise(e = mean(diff), .groups = "drop") |>
      summarise(estimate = mean(e, na.rm = TRUE), sd = sd(e, na.rm = TRUE)) |>
      mutate(series = s, label = combo_name, kind = kind)
  })) |>
    eff_finish()
}

