# sales: one column per fruit
wide <- dat |>
  select(date, fruit, sales) |>
  pivot_wider(names_from = fruit, values_from = sales, values_fn = sum) |>
  full_join(pop_df, by = "date") |>
  arrange(date) |>
  mutate(total    = .data[[FA]] + .data[[FB]],
         share    = .data[[FA]] / total,                   # share of fruit A in total
         pop_yoy  = population / lag(population, 12) - 1, # uses population history before sales start
         sales_ok = !is.na(.data[[FA]]) & !is.na(.data[[FB]]))

make_series <- function(s) {
  wide |>
    transmute(date, pop = population, pop_yoy, sales_ok, y = .data[[s]]) |>
    mutate(pop_lag12 = lag(pop, 12),      # population same month last year
           y_lag12   = lag(y, 12),        # value same month last year
           y_pc      = y / pop,           # per capita
           pc_lag12  = lag(y_pc, 12)) |>  # per capita same month last year
    filter(sales_ok) |>                   # same months for every series, so CV folds line up
    mutate(t      = row_number(),
           month  = as.integer(format(date, "%m")),
           growth = y_pc / pc_lag12)      # YoY growth of per-capita value (ML target)
}

series_list <- sapply(c(FA, FB, "total", "share"), make_series, simplify = FALSE)
for (s in names(series_list)) {
