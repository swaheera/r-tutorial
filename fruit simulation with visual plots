# Comes straight from the CV - no refitting. In each fold the fitted model forecast the 12 test months
# twice: population unchanged from a year earlier (fc0) and population POP_GROWTH higher than a year earlier (fcg).
# Effect = average of (fcg - fc0) over the 12 months = extra sales per month due to that population growth.
# The spread across folds shows how stable the effect is when the model is refitted on more data.

eff_finish <- function(x) mutate(x, lo = estimate - 1.96 * sd, hi = estimate + 1.96 * sd, crosses_zero = lo < 0 & hi > 0)

# individual population-using models, each on its own series
