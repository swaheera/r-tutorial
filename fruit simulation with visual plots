set.seed(123)

sim_dates <- seq(as.Date("2019-01-01"), as.Date("2026-09-01"), by = "month")
sim_t     <- seq_along(sim_dates)
sim_mon   <- as.integer(format(sim_dates, "%m"))

# population: ~1.5%/yr growth + a 2% step in mid-2022 (e.g. immigration wave)
sim_pop <- round(1e6 * exp(0.015 * sim_t / 12) *
                   (1 + 0.02 * (sim_dates >= as.Date("2022-07-01"))) *
                   (1 + rnorm(length(sim_t), 0, 0.001)))

# per-capita sales: own trend + seasonality + noise
apple_pc  <- 0.020 * (1 + 0.020 * sim_t / 12) * (1 + 0.15 * sin(2 * pi * (sim_mon - 3) / 12)) *
  exp(rnorm(length(sim_t), 0, 0.04))
banana_pc <- 0.015 * (1 + 0.010 * sim_t / 12) * (1 + 0.10 * cos(2 * pi * (sim_mon - 7) / 12)) *
  exp(rnorm(length(sim_t), 0, 0.05))

# long format: date, population, fruit, sales (sales only from 2020-04)
df <- bind_rows(
  tibble(date = sim_dates, population = sim_pop, fruit = "apple",  sales = sim_pop * apple_pc),
  tibble(date = sim_dates, population = sim_pop, fruit = "banana", sales = sim_pop * banana_pc)
) |>
  mutate(sales = if_else(date < as.Date("2020-04-01"), NA_real_, round(sales))) |>
  arrange(date, fruit)

