# helper: print clear winner or near ties
report_ties <- function(cands, label) {
  best <- cands$score[1]
  ties <- filter(cands, score <= best * (1 + TIE_TOL))
  if (nrow(ties) == 1) {
    log_msg("%s: clear winner %s (score %.2f)", label, cands$combo[1], best)
  } else {
    log_msg("%s: no clear winner, %d candidates within %.0f%% of best score (%.2f):",
            label, nrow(ties), TIE_TOL * 100, best)
    print(select(ties, any_of(c("single_model", "strategy", "combo", "score"))), n = Inf)
  }
}

