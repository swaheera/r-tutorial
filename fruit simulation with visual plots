# ---- 0a. Data config: edit these to match your data ---------------------------
# Expected input: long format, one row per date x fruit, monthly dates without gaps.
DF_NAME   <- "df"              # name of your data frame object (as a string)
DATE_COL  <- "date"            # date column (Date, or something as.Date() can parse)
POP_COL   <- "population"      # population column
FRUIT_COL <- "fruit"           # column holding the fruit name
SALES_COL <- "sales"           # sales column
FRUIT_A   <- "apple"           # value in FRUIT_COL for the first fruit
FRUIT_B   <- "banana"          # value in FRUIT_COL for the second fruit

# ---- 0b. Model / CV settings ----------------------------------------------------
H         <- 12     # forecast horizon (months)
INITIAL   <- 36     # months in the first training window
STEP      <- 3      # months between forecast origins
WINDOW    <- NULL   # NULL = expanding window (train from first month); a number (e.g. 36) = sliding window
TIE_TOL   <- 0.02   # candidates within 2% of the best score count as "near ties"
TOP_K     <- 20     # number of top heterogeneous pipelines used to count which models show up most
TOP_N_UNC <- 10     # number of top heterogeneous pipelines shown in the uncertainty plot
BAND      <- c(0.10, 0.90)  # spread bars in MAPE uncertainty plots: 10th to 90th percentile across folds
POP_MODE  <- "forecast"  # "forecast" = population in the test period is forecast with auto.arima
                         #              from data up to the origin (realistic)
                         # "actual"   = actual future population is used (optimistic upper bound)
ARIMA_DEEP <- FALSE      # TRUE = full auto.arima search (stepwise = FALSE, approximation = FALSE); slower
POP_GROWTH <- 0.005      # population effect scenario: population this much higher than a year earlier
                         # (0.005 = 0.5%), compared with population unchanged from a year earlier
PLOT_DIR   <- "plots"    # every plot is also saved here as PNG (full size, readable)
PLOT_W     <- 14         # PNG width (inches)
PLOT_H     <- 8.5        # PNG height (inches)
stopifnot(POP_MODE %in% c("forecast", "actual"))

log_msg <- function(...) cat(format(Sys.time(), "%H:%M:%S"), "|", sprintf(...), "\n")
section <- function(title) cat("\n==== ", title, " ", strrep("=", max(0, 60 - nchar(title))), "\n", sep = "")
ym      <- function(x) format(x, "%Y-%m")
pct_lab <- function(x) paste0(x, "%")
fmt_num <- function(x) format(round(x), big.mark = ",", scientific = FALSE, trim = TRUE)

# auto.arima wrapper so the search depth is set in one place
aa <- function(y, ...) auto.arima(y, stepwise = !ARIMA_DEEP, approximation = !ARIMA_DEEP, ...)

FA <- FRUIT_A
FB <- FRUIT_B
stopifnot(FA != FB,
          !any(c(FA, FB) %in% c("date", "population", "total", "share", "pop_yoy")))

# labels used in tables and plots
S_AB <- paste(FA, "+", FB)
S_TA <- paste("total -", FA)
S_TB <- paste("total -", FB)
S_TS <- paste("total x", FA, "share")
strategy_cols <- setNames(c("steelblue", "darkgreen", "orange", "purple"), c(S_AB, S_TA, S_TB, S_TS))
series_lvls   <- c(FA, FB, "total")

