# =============================================================================
# Fruit sales forecasting with coherent pipelines
#
# A PIPELINE forecasts two series with one model each and derives the third, so that
# fruit A + fruit B = total always holds. Four strategies:
#   1. A + B          : forecast A and B; total = A + B
#   2. total - A      : forecast total and A; B = total - A
#   3. total - B      : forecast total and B; A = total - B
#   4. total x A share: forecast total and A's share of total; A = total * share, B = total * (1 - share)
#
# HETEROGENEOUS pipelines: the two forecasted series may use different models (e.g. ARIMA for total, ETS for A)
# HOMOGENEOUS pipelines  : the same model is used for both forecasted series (simpler to explain)
#
# Every model is evaluated with rolling-origin cross-validation (12-month horizon).
# Metrics per series: monthly MAPE and yearly MAPE (|sum actual - sum fc| / sum actual over 12 months).
# The winner minimises the average of the 6 MAPEs (3 series x monthly/yearly).
#
# Population effect: in every CV fold each fitted model also forecasts two what-if scenarios -
# population unchanged from a year earlier vs population POP_GROWTH (e.g. 0.5%) higher than a year earlier.
# The difference = extra sales per month due to that population growth. No extra model fitting is needed.
# =============================================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(ggrepel)
library(forecast)
library(ranger)
library(xgboost)

