# ---- Formal statistics for the winners' component models -----------------------
section("Formal coefficients and p-values of the winners' components")
# Each component model is refitted on ALL data. Effects are for population POP_GROWTH higher than a year
# earlier (vs unchanged), at the current sales level (average of the last 12 months).

fmt_p <- function(p) if (p < 0.001) "p < 0.001" else sprintf("p = %.3f", p)
sig   <- function(p) if (p < 0.05) "significant at 5%" else "NOT significant at 5%"

describe_pop_stats <- function(model, s) {
  d   <- series_list[[s]]
  hdr <- sprintf("%s for %s:", model, s)
  if (s == "share") return(paste(hdr, "share model - no population term."))
  last_pop  <- tail(d$pop, 1)
  avg_sales <- mean(tail(d$y, 12))
  to_sales  <- function(b) avg_sales * ((1 + POP_GROWTH)^b - 1)   # coefficient on log population -> extra sales/month
  scen      <- sprintf("population %s higher than a year ago (vs unchanged)", growth_txt)

  if (model == "lm_logpop") {
    fit <- lm(log(y) ~ log(pop) + t + factor(month), data = d)
    co  <- summary(fit)$coefficients["log(pop)", ]; ci <- confint(fit)["log(pop)", ]
    return(sprintf("%s %s -> %s more sales per month (95%% CI %s to %s), %s, %s. Holding trend and season fixed.",
                   hdr, scen, fmt_num(to_sales(co[1])), fmt_num(to_sales(ci[1])), fmt_num(to_sales(ci[2])),
                   fmt_p(co[4]), sig(co[4])))
  }
  if (model == "lm_growth") {
    fit <- lm(log(y / y_lag12) ~ log(1 + pop_yoy), data = filter(d, !is.na(y_lag12), !is.na(pop_yoy)))
    nm  <- "log(1 + pop_yoy)"
    co  <- summary(fit)$coefficients[nm, ]; ci <- confint(fit)[nm, ]
    return(sprintf("%s %s -> %s more sales per month (95%% CI %s to %s), %s, %s.",
                   hdr, scen, fmt_num(to_sales(co[1])), fmt_num(to_sales(ci[1])), fmt_num(to_sales(ci[2])),
                   fmt_p(co[4]), sig(co[4])))
  }
  if (model == "adl") {
    fit   <- adl_fit(d)
    cf    <- coef(fit); V <- vcov(fit); st <- summary(fit)$coefficients
    phi   <- cf[["g_l1"]]
    lr    <- (cf[["pg"]] + cf[["pg_l1"]]) / (1 - phi)                 # long-run effect
    grad  <- c(0, lr / (1 - phi), 1 / (1 - phi), 1 / (1 - phi))        # delta method: d lr / d coef
    lr_se <- sqrt(as.numeric(t(grad) %*% V %*% grad))
    lr_p  <- 2 * pnorm(-abs(lr / lr_se))
    sr_se <- st["pg", 2]
    return(sprintf(paste0("%s %s ->\n",
                          "      short run (same month): %s more sales per month (95%% CI %s to %s), %s, %s;\n",
                          "      long run (fully adjusted): %s more sales per month (95%% CI %s to %s), %s, %s."),
                   hdr, scen,
                   fmt_num(to_sales(cf[["pg"]])), fmt_num(to_sales(cf[["pg"]] - 1.96 * sr_se)),
                   fmt_num(to_sales(cf[["pg"]] + 1.96 * sr_se)), fmt_p(st["pg", 4]), sig(st["pg", 4]),
                   fmt_num(to_sales(lr)), fmt_num(to_sales(lr - 1.96 * lr_se)), fmt_num(to_sales(lr + 1.96 * lr_se)),
                   fmt_p(lr_p), sig(lr_p)))
  }
  if (model == "arima_pop") {
    fit    <- aa(to_ts(d$y, d), xreg = d$pop)
    k      <- grep("xreg", names(coef(fit)), value = TRUE)[1]
    b      <- coef(fit)[k]; se <- sqrt(diag(fit$var.coef))[k]; p <- 2 * pnorm(-abs(b / se))
    people <- POP_GROWTH * last_pop / (1 + POP_GROWTH)   # extra people vs a year earlier
    return(sprintf("%s %s; %s (about %s people) -> %s more sales per month (95%% CI %s to %s), %s, %s.",
                   hdr, tryCatch(as.character(fit), error = function(e) "ARIMA"), scen, fmt_num(people),
                   fmt_num(b * people), fmt_num((b - 1.96 * se) * people), fmt_num((b + 1.96 * se) * people),
                   fmt_p(p), sig(p)))
  }
  if (model %in% c("ets_percap", "arima_percap")) {
    return(sprintf("%s per-capita model: sales move in proportion to population by assumption -> %s = about %s more sales per month (no p-value).",
                   hdr, scen, fmt_num(avg_sales * POP_GROWTH)))
  }
  if (model %in% c("rf_growth", "xgb_growth")) {
    return(paste(hdr, "ML model: no coefficient or p-value; see the population effect plots."))
  }
  if (model == "avg3") {
    parts <- vapply(AVG3_PARTS, function(m) describe_pop_stats(m, s), character(1))
    return(paste0(hdr, " average of ", paste(AVG3_PARTS, collapse = ", "),
                  "; its combined effect is in the population effect plots. Components:\n",
                  paste0("      * ", parts, collapse = "\n")))
  }
  paste(hdr, "univariate model - does not use population.")
}

