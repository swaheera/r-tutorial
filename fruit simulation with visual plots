# save every plot as PNG, then try to draw it; a too-small plot pane no longer stops the script
dir.create(PLOT_DIR, showWarnings = FALSE)
show_plot <- function(p, name) {
  file <- file.path(PLOT_DIR, paste0(name, ".png"))
  ggsave(file, p, width = PLOT_W, height = PLOT_H, dpi = 150)
  tryCatch(print(p),
