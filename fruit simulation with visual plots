# ---- 3. Models ---------------------------------------------------------------
# Each model is a function(train) that fits ONCE and returns a predictor function(test) -> forecast.
# The same fitted model can then forecast the real test period and the population what-if scenarios.

to_ts <- function(x, d) {
  ts(x, frequency = 12,
     start = c(as.integer(format(d$date[1], "%Y")), as.integer(format(d$date[1], "%m"))))
}

ml_features <- c("month", "pop_yoy", "t")
ml_train    <- function(tr) filter(tr, !is.na(growth), !is.na(pop_yoy))

# ADL data: g = log sales growth vs last year, pg = log population growth vs last year, plus 1-month lags
adl_data <- function(d) {
  d |>
    mutate(g = log(y / y_lag12), pg = log(pop / pop_lag12), g_l1 = lag(g), pg_l1 = lag(pg))
}
adl_fit <- function(d) {
  lm(g ~ g_l1 + pg + pg_l1, data = filter(adl_data(d), !is.na(g), !is.na(g_l1), !is.na(pg), !is.na(pg_l1)))
}

# models for sales levels (fruit A, fruit B, total)
sales_models <- list(
  # -- univariate: sales history only, no population --
  snaive       = function(tr) { y <- to_ts(tr$y, tr); function(te) snaive(y, h = nrow(te))$mean },
  ets          = function(tr) { fit <- ets(to_ts(tr$y, tr)); function(te) forecast(fit, h = nrow(te))$mean },
  arima        = function(tr) { fit <- aa(to_ts(tr$y, tr)); function(te) forecast(fit, h = nrow(te))$mean },
  # -- statistical models using population --
  arima_pop    = function(tr) {
    fit <- aa(to_ts(tr$y, tr), xreg = tr$pop)
    function(te) forecast(fit, xreg = te$pop)$mean
  },
  ets_percap   = function(tr) {
    fit <- ets(to_ts(tr$y_pc, tr))
    function(te) forecast(fit, h = nrow(te))$mean * te$pop
  },
  arima_percap = function(tr) {
    fit <- aa(to_ts(tr$y_pc, tr))
    function(te) forecast(fit, h = nrow(te))$mean * te$pop
  },
  lm_logpop    = function(tr) {
    fit <- lm(log(y) ~ log(pop) + t + factor(month), data = tr)
    function(te) exp(predict(fit, newdata = te))
  },
  # sales growth vs last year = a + b x population growth vs last year (in logs)
  lm_growth    = function(tr) {
    fit <- lm(log(y / y_lag12) ~ log(1 + pop_yoy), data = filter(tr, !is.na(y_lag12), !is.na(pop_yoy)))
    function(te) te$y_lag12 * exp(predict(fit, newdata = te))
  },
  # ADL: g_t = a + phi*g_(t-1) + b0*pg_t + b1*pg_(t-1); forecast recursively month by month
  adl          = function(tr) {
    cf   <- coef(adl_fit(tr))
    hist <- adl_data(tr)
    g0   <- tail(hist$g, 1)
    pg0  <- tail(hist$pg, 1)
    function(te) {
      pg_te   <- log(te$pop / te$pop_lag12)
      g_prev  <- g0
      pg_prev <- pg0
      out     <- numeric(nrow(te))
      for (k in seq_len(nrow(te))) {
        g_k     <- cf[["(Intercept)"]] + cf[["g_l1"]] * g_prev + cf[["pg"]] * pg_te[k] + cf[["pg_l1"]] * pg_prev
        out[k]  <- te$y_lag12[k] * exp(g_k)
        g_prev  <- g_k
        pg_prev <- pg_te[k]
      }
      out
    }
  },
  # -- ML models using population growth --
  rf_growth    = function(tr) {
    fit <- ranger(growth ~ month + pop_yoy + t, data = ml_train(tr), num.trees = 500, seed = 1)
    function(te) predict(fit, te[, ml_features])$predictions * te$pc_lag12 * te$pop
  },
  xgb_growth   = function(tr) {
    trm <- ml_train(tr)
    X   <- function(d) as.matrix(d[, ml_features])
    fit <- xgb.train(params  = list(objective = "reg:squarederror", eta = 0.05, max_depth = 3),
                     data    = xgb.DMatrix(X(trm), label = trm$growth),
                     nrounds = 200, verbose = 0)
    function(te) predict(fit, xgb.DMatrix(X(te))) * te$pc_lag12 * te$pop
  }
)
AVG3_PARTS <- c("ets_percap", "arima_pop", "xgb_growth")  # models averaged into "avg3"

# models for fruit A's share (a proportion, so no population scaling).
# Names that match a sales model (snaive, ets, arima) let the share strategy count as homogeneous.
share_models <- list(
  snaive    = function(tr) { y <- to_ts(tr$y, tr); function(te) snaive(y, h = nrow(te))$mean },
  ets       = function(tr) { fit <- ets(to_ts(tr$y, tr)); function(te) forecast(fit, h = nrow(te))$mean },
  arima     = function(tr) { fit <- aa(to_ts(tr$y, tr)); function(te) forecast(fit, h = nrow(te))$mean },
  lm_season = function(tr) { fit <- lm(y ~ t + factor(month), data = tr); function(te) predict(fit, newdata = te) }
)

# model type, for tables
model_type <- c(snaive = "univariate", ets = "univariate", arima = "univariate", lm_season = "univariate",
                arima_pop = "population", ets_percap = "population", arima_percap = "population",
                lm_logpop = "population", lm_growth = "population", adl = "population",
                rf_growth = "ML + population", xgb_growth = "ML + population", avg3 = "ensemble")

# ---- 4. Rolling-origin CV: base forecasts + population scenarios ----------------
section("4. Cross-validation (base forecasts + population scenarios)")
# Expanding window: train on months 1..o. Sliding window: train on the last WINDOW months up to o.
# Forecast the next H months, then move the origin by STEP. Origins are counted back from the end,
# so the last fold always ends at the latest month.
# Each model is fitted once per fold and forecasts three versions of the test period:
#   fc  = real forecast (population actual or forecast, see POP_MODE)
#   fc0 = what-if: population in every forecast month equal to the same month a year earlier (0% growth)
#   fcg = what-if: population POP_GROWTH higher than the same month a year earlier
log_msg("Population in test periods: %s | ARIMA search: %s",
        POP_MODE, if (ARIMA_DEEP) "full (slower)" else "stepwise (default)")

cv_origins <- function(d) rev(seq(nrow(d) - H, INITIAL, by = -STEP))
cv_split   <- function(d, o) {
  start <- if (is.null(WINDOW)) 1 else max(1, o - WINDOW + 1)
  list(tr = d[start:o, ], te = d[(o + 1):(o + H), ])
}

# what-if test set: population = same month a year earlier x (1 + g)
scenario <- function(te, g) {
  te$pop     <- te$pop_lag12 * (1 + g)
  te$pop_yoy <- g
  te
}

# Population forecast per origin: auto.arima on all population history up to the origin
# (including months before sales start). Cached, since every series uses the same origins.
pop_cache <- list()
get_pop_fc <- function(origin_date, h) {
  k <- as.character(origin_date)
  if (is.null(pop_cache[[k]])) {
    hist <- filter(pop_df, date <= origin_date, !is.na(population))
    pop_cache[[k]] <<- as.numeric(forecast(aa(to_ts(hist$population, hist)), h = h)$mean)
  }
  pop_cache[[k]]
}

run_cv <- function(d, model_list, name) {
  stopifnot(H <= 12)  # 12-month lags are used; H <= 12 keeps them leak-free
  origins <- cv_origins(d)
  log_msg("[%s] %s window | %d folds | %d models",
          name, if (is.null(WINDOW)) "expanding" else paste0("sliding ", WINDOW, "-month"),
          length(origins), length(model_list))
  out <- list()
  for (i in seq_along(origins)) {
    o  <- origins[i]
    sp <- cv_split(d, o)
    tr <- sp$tr
    te <- sp$te
    te_list <- list(fc0 = scenario(te, 0), fcg = scenario(te, POP_GROWTH))  # scenarios use actual history
    if (POP_MODE == "forecast") {
      pop_actual <- te$pop
      te$pop     <- get_pop_fc(d$date[o], H)
      te$pop_yoy <- te$pop / te$pop_lag12 - 1
      pop_note   <- sprintf("pop fc error %.2f%%", 100 * mean(abs(te$pop - pop_actual) / pop_actual))
    } else {
      pop_note <- "pop actual"
    }
    te_list <- c(list(fc = te), te_list)

    res <- lapply(names(model_list), function(m) {
      tryCatch({
        pred <- model_list[[m]](tr)                              # fit once
        lapply(te_list, function(x) as.numeric(pred(x)))         # predict 3 versions
      }, error = function(e) {
        log_msg("  ! [%s] %s failed on fold %d: %s", name, m, i, conditionMessage(e))
        lapply(te_list, function(x) rep(NA_real_, nrow(te)))
      })
    })
    names(res) <- names(model_list)
    if (all(AVG3_PARTS %in% names(res))) {                       # simple model average
      res$avg3 <- setNames(lapply(names(te_list), function(k) rowMeans(sapply(res[AVG3_PARTS], `[[`, k))),
                           names(te_list))
    }
    out[[i]] <- bind_rows(lapply(names(res), function(m) {
      tibble(origin = d$date[o], date = te$date, model = m,
             fc = res[[m]]$fc, fc0 = res[[m]]$fc0, fcg = res[[m]]$fcg)
    }))
    log_msg("[%s] fold %2d/%d | train %s to %s (%d mo) | test %s to %s | %s",
            name, i, length(origins), ym(tr$date[1]), ym(tr$date[nrow(tr)]), nrow(tr),
            ym(te$date[1]), ym(te$date[H]), pop_note)
  }
  bind_rows(out)
}

base <- bind_rows(
  lapply(c(FA, FB, "total"),
         function(s) run_cv(series_list[[s]], sales_models, s) |> mutate(series = s)),
  run_cv(series_list[["share"]], share_models, "share") |> mutate(series = "share")
)
log_msg("Base forecasts: %d rows", nrow(base))

# ---- Scoring helpers ------------------------------------------------------------
actuals <- wide |>
  select(date, all_of(c(FA, FB)), total, share) |>
  pivot_longer(-date, names_to = "series", values_to = "actual")

# per fold: monthly MAPE and yearly APE over the 12-month window
fold_scores <- function(x, ...) {
  x |>
    group_by(..., origin) |>
    summarise(window_end = max(date),
              monthly    = mean(abs(actual - fc) / actual) * 100,
              yearly     = abs(sum(actual) - sum(fc)) / sum(actual) * 100,
              .groups    = "drop")
}
# average over folds, plus the spread across folds (BAND percentiles)
avg_scores <- function(f, ...) {
  f |>
    group_by(...) |>
    summarise(monthly_mape = mean(monthly), yearly_mape = mean(yearly),
              m_lo = quantile(monthly, BAND[1], na.rm = TRUE), m_hi = quantile(monthly, BAND[2], na.rm = TRUE),
              y_lo = quantile(yearly,  BAND[1], na.rm = TRUE), y_hi = quantile(yearly,  BAND[2], na.rm = TRUE),
              .groups = "drop")
}

# ---- 5. Individual models, each on its own series (diagnostic) ----------------
section("5. Individual models on their own series (diagnostic, not coherent)")

model_metrics <- base |>
  select(origin, date, model, fc, series) |>
  left_join(actuals, by = c("date", "series")) |>
  fold_scores(series, model) |>
  avg_scores(series, model) |>
  mutate(avg_mape = (monthly_mape + yearly_mape) / 2, type = unname(model_type[model])) |>
  group_by(series) |>
  arrange(avg_mape, .by_group = TRUE) |>
  mutate(rank = row_number()) |>
  ungroup()

print(select(model_metrics, series, rank, model, type, monthly_mape, yearly_mape, avg_mape), n = Inf)
cat("\nBest individual model per series:\n")
print(select(filter(model_metrics, rank == 1), series, model, type, monthly_mape, yearly_mape))

mm_plot <- model_metrics |>
  filter(series %in% series_lvls) |>
  mutate(series = factor(series, levels = series_lvls), best = rank == 1)

p_models <- ggplot(mm_plot, aes(monthly_mape, yearly_mape)) +
  geom_point(aes(colour = best), size = 3) +
  geom_text_repel(aes(label = model, colour = best), size = 3, show.legend = FALSE, max.overlaps = Inf) +
  scale_colour_manual(values = c(`FALSE` = "grey40", `TRUE` = "red"),
                      labels = c(`FALSE` = "Other models", `TRUE` = "Best model for this series"), name = NULL) +
  scale_x_continuous(breaks = scales::breaks_pretty(8), labels = pct_lab) +
  scale_y_continuous(breaks = scales::breaks_pretty(8), labels = pct_lab) +
  facet_wrap(~ series) +
  labs(x = "Monthly MAPE (average over CV folds)", y = "Yearly MAPE (average over CV folds)",
