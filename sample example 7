library(dplyr)
library(forecast)

# ==============================================================================
# SIMULATE DATA
# ==============================================================================
set.seed(42)

dates <- seq(as.Date("2020-04-01"), as.Date("2026-03-31"), by = "month")
n <- length(dates)

population <- 100000 + cumsum(rnorm(n, 50, 20))
apples     <- exp(0.5 * log(population) + rnorm(n, 5, 0.05))
banana     <- exp(0.3 * log(population) + rnorm(n, 4, 0.08))
total      <- apples + banana

mydf <- data.frame(
  date       = dates,
  population = population,
  total      = total,
  apples     = apples,
  banana     = banana
)

# ==============================================================================
# SETTINGS
# ==============================================================================
train_dates <- seq(as.Date("2020-04-01"), as.Date("2026-03-31"), by = "month")
fc_dates    <- seq(as.Date("2026-04-01"), as.Date("2027-03-31"), by = "month")

# ==============================================================================
# PREP: USE ALL TRAIN DATA, DISCARD FIRST OBS DUE TO LAG
# ==============================================================================
train_raw <- mydf %>%
  dplyr::filter(date >= min(train_dates) & date <= max(train_dates)) %>%
  arrange(date)

train <- train_raw %>%
  mutate(pop_lag1 = dplyr::lag(population, 1)) %>%
  dplyr::filter(!is.na(pop_lag1))

# ==============================================================================
# FIT MODELS
# ==============================================================================
xreg_train <- log(train$pop_lag1)

model_total  <- auto.arima(log(train$total),  xreg = xreg_train)
model_apples <- auto.arima(log(train$apples), xreg = xreg_train)

# ==============================================================================
# PART 1: SINGLE SCENARIO
# ==============================================================================
scenario_pct <- -3

k         <- length(fc_dates)
base_pop  <- train_raw$population[nrow(train_raw)]
end_pop   <- base_pop * (1 + scenario_pct / 100)
pop_scen  <- base_pop + (1:k) / k * (end_pop - base_pop)
xreg_fc   <- log(pop_scen)

fc_total  <- exp(as.numeric(forecast(model_total,  xreg = xreg_fc)$mean))
fc_apples <- exp(as.numeric(forecast(model_apples, xreg = xreg_fc)$mean))

results_single <- data.frame(
  date   = fc_dates,
  total  = fc_total,
  apples = fc_apples,
  banana = fc_total - fc_apples
)

print(results_single)

# ==============================================================================
# PART 2: MULTIPLE SCENARIOS
# ==============================================================================
scenario_pct <- c(-3, 0, 3)

results_multi <- do.call(rbind, lapply(scenario_pct, function(s) {
  end_pop   <- base_pop * (1 + s / 100)
  pop_scen  <- base_pop + (1:k) / k * (end_pop - base_pop)
  xreg_fc   <- log(pop_scen)

  fc_total  <- exp(as.numeric(forecast(model_total,  xreg = xreg_fc)$mean))
  fc_apples <- exp(as.numeric(forecast(model_apples, xreg = xreg_fc)$mean))

  data.frame(
    scenario = s,
    date     = fc_dates,
    total    = fc_total,
    apples   = fc_apples,
    banana   = fc_total - fc_apples
  )
}))

print(results_multi)
