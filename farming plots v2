library(dplyr)
library(ggplot2)
library(lubridate)
library(tidyr)

# Long format
farm_long <- master %>%
    select(date, province, USA = usa_imports, `Non-USA` = non_usa_imports) %>%
    pivot_longer(c(USA, `Non-USA`), names_to = "source", values_to = "value")

# Yearly aggregation
farm_yearly <- farm_long %>%
    mutate(year = floor_date(date, "year")) %>%
    group_by(province, year, source) %>%
    summarise(value = sum(value, na.rm = TRUE), .groups = "drop")

# Colors
usa_col <- "#2C5F7C"
non_usa_col <- "#D4A03C"

# Smarter formatting with better precision
format_smart <- function(val_thousands) {
    val_actual <- val_thousands * 1000
    if (is.na(val_actual) || val_actual == 0) return("$0")
    abs_val <- abs(val_actual)
    
    if (abs_val >= 1e9) {
        scaled <- val_actual / 1e9
        if (abs(scaled) >= 100)      return(paste0("$", round(scaled), "B"))
        if (abs(scaled) >= 10)       return(paste0("$", format(round(scaled, 1), nsmall = 1), "B"))
        return(paste0("$", format(round(scaled, 2), nsmall = 2), "B"))
    } else if (abs_val >= 1e6) {
        scaled <- val_actual / 1e6
        if (abs(scaled) >= 100)      return(paste0("$", round(scaled), "M"))
        if (abs(scaled) >= 10)       return(paste0("$", format(round(scaled, 1), nsmall = 1), "M"))
        return(paste0("$", format(round(scaled, 2), nsmall = 2), "M"))
    } else if (abs_val >= 1e3) {
        scaled <- val_actual / 1e3
        if (abs(scaled) >= 100)      return(paste0("$", round(scaled), "K"))
        if (abs(scaled) >= 10)       return(paste0("$", format(round(scaled, 1), nsmall = 1), "K"))
        return(paste0("$", format(round(scaled, 2), nsmall = 2), "K"))
    } else {
        return(paste0("$", round(val_actual)))
    }
}

# Y-axis unit per province
get_axis_unit <- function(max_thousands) {
    max_actual <- max_thousands * 1000
    if (max_actual >= 1e9) {
        return(list(divisor = 1e6, unit = "B", unit_long = "billions"))
    } else if (max_actual >= 5e6) {
        return(list(divisor = 1e3, unit = "M", unit_long = "millions"))
    } else {
        return(list(divisor = 1, unit = "K", unit_long = "thousands"))
    }
}

# --- Individual plots per province ---
for (prov in unique(master$province)) {
    prov_data <- farm_yearly %>% filter(province == prov)
    
    max_total <- prov_data %>%
        group_by(year) %>%
        summarise(t = sum(value), .groups = "drop") %>%
        pull(t) %>% max()
    
    ax <- get_axis_unit(max_total)
    
    prov_data <- prov_data %>%
        mutate(value_scaled = value / ax$divisor)
    
    prov_data <- prov_data %>%
        group_by(year) %>%
        mutate(
            total_scaled = sum(value_scaled),
            pct = round(value_scaled / total_scaled * 100, 1)
        ) %>%
        ungroup() %>%
        arrange(year, desc(source)) %>%
        group_by(year) %>%
        mutate(ypos = cumsum(value_scaled) - value_scaled / 2) %>%
        ungroup()
    
    max_bar <- max(prov_data$total_scaled)
    
    prov_data <- prov_data %>%
        mutate(
            segment_share = value_scaled / total_scaled,
            bar_relative = total_scaled / max_bar,
            bar_big_enough = bar_relative >= 0.15,
            show_full = bar_big_enough & segment_share >= 0.25,
            show_pct_only = bar_big_enough & segment_share >= 0.12 & !show_full,
            dollar_label = sapply(value, format_smart),
            # Display whole % if close to integer, otherwise 1 decimal
            pct_label = ifelse(
                abs(pct - round(pct)) < 0.05,
                paste0(round(pct), "%"),
                paste0(format(pct, nsmall = 1), "%")
            )
        )
    
    prov_totals <- prov_data %>%
        group_by(year) %>%
        summarise(
            total_scaled = sum(value_scaled),
            total_raw = sum(value),
            .groups = "drop"
        ) %>%
        mutate(total_label = sapply(total_raw, format_smart))
    
    p <- ggplot(prov_data, aes(x = year, y = value_scaled, fill = source)) +
        geom_col(width = 300) +
        geom_text(
            data = prov_data %>% filter(show_full),
            aes(y = ypos, label = dollar_label),
            size = 3.2, color = "white", fontface = "bold"
        ) +
        geom_text(
            data = prov_data %>% filter(show_full),
            aes(y = ypos, label = paste0("(", pct_label, ")")),
            size = 2.8, color = "white", vjust = 2.2
        ) +
        geom_text(
            data = prov_data %>% filter(show_pct_only),
            aes(y = ypos, label = pct_label),
            size = 2.5, color = "white", fontface = "bold"
        ) +
        geom_text(
            data = prov_totals,
            aes(x = year, y = total_scaled, label = total_label, fill = NULL),
            size = 3.5, fontface = "bold", color = "grey20", vjust = -0.5
        ) +
        scale_fill_manual(values = c("USA" = usa_col, "Non-USA" = non_usa_col)) +
        scale_y_continuous(
            labels = function(x) paste0("$", x, ax$unit),
            expand = expansion(mult = c(0, 0.1))
        ) +
        scale_x_date(date_labels = "%Y", date_breaks = "1 year") +
        labs(
            title = paste0(prov, ": Imports of Farm, Fishing & Food Products"),
            subtitle = "USA vs Non-USA sources, 2017\u2013present",
            x = NULL, y = NULL, fill = NULL,
            caption = paste0(
                "Source: Statistics Canada, Table 12-10-0175-01 | Values in ",
                ax$unit_long, " of Canadian dollars"
            )
        ) +
        theme_minimal(base_size = 13) +
        theme(
            plot.title = element_text(face = "bold", size = 18, margin = margin(b = 4)),
            plot.subtitle = element_text(color = "grey40", size = 13, margin = margin(b = 15)),
            plot.caption = element_text(color = "grey50", size = 9, margin = margin(t = 15)),
            plot.margin = margin(20, 25, 15, 20),
            panel.grid.major.x = element_blank(),
            panel.grid.minor = element_blank(),
            panel.grid.major.y = element_line(color = "grey90", linewidth = 0.3),
            axis.text = element_text(color = "grey30"),
            axis.text.x = element_text(size = 11),
            legend.position = "top",
            legend.justification = "left",
            legend.text = element_text(size = 12),
            legend.key.size = unit(0.5, "cm")
        )
    
    plot_name <- paste0("plot_", tolower(gsub(" ", "_", prov)))
    assign(plot_name, p, envir = .GlobalEnv)
}
