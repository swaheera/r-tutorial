# Build a DLM with local linear trend + seasonal component
# State vector: [level, slope, seasonal_1, seasonal_2, ..., seasonal_11]
# Total state dimension: 2 + 11 = 13 for monthly data

build_dlm <- function(parm) {
    # parm[1] = log(V) - observation variance
    # parm[2] = log(W_level) - level state variance
    # parm[3] = log(W_slope) - slope state variance  
    # parm[4] = log(W_seasonal) - seasonal state variance
   
    V <- exp(parm[1])
    W_level <- exp(parm[2])
    W_slope <- exp(parm[3])
    W_seasonal <- exp(parm[4])
   
    # Local linear trend component
    mod_trend <- dlmModPoly(order = 2, dV = V, dW = c(W_level, W_slope))
   
    # Seasonal component (monthly, period = 12)
    mod_seasonal <- dlmModSeas(frequency = 12, dV = 0, dW = c(W_seasonal, rep(0, 10)))
   
    # Combine: trend + seasonal
    mod <- mod_trend + mod_seasonal
   
    return(mod)
}

