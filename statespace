# ============================================================
# MODEL PERFORMANCE METRICS
# ============================================================

calculate_performance_metrics <- function(actual, fitted) {
    # Remove any NAs
    valid_idx <- !is.na(actual) & !is.na(fitted)
    actual <- actual[valid_idx]
    fitted <- fitted[valid_idx]
   
    n <- length(actual)
    residuals <- actual - fitted
   
    # Mean Absolute Error (MAE)
    mae <- mean(abs(residuals))
   
    # Mean Squared Error (MSE)
    mse <- mean(residuals^2)
   
    # Root Mean Squared Error (RMSE)
    rmse <- sqrt(mse)
   
    # Mean Absolute Percentage Error (MAPE)
    # Avoid division by zero
    mape <- mean(abs(residuals / actual)) * 100
   
    # Symmetric MAPE (handles zeros better)
    smape <- mean(2 * abs(residuals) / (abs(actual) + abs(fitted))) * 100
   
    # R-squared
    ss_res <- sum(residuals^2)
    ss_tot <- sum((actual - mean(actual))^2)
    r_squared <- 1 - (ss_res / ss_tot)
   
    return(data.frame(
        MAE = mae,
        RMSE = rmse,
        MAPE = mape,
        sMAPE = smape,
        R_squared = r_squared,
        n = n
    ))
}

