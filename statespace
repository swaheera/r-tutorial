# Function to estimate intervention effect using DLM
estimate_intervention_effect_dlm <- function(data, value_col, n_sims = N_SIMS) {
   
    # Split into pre-intervention and intervention periods
    pre_data <- data %>% dplyr::filter(date < INTERVENTION_START)
    intervention_data <- data %>% dplyr::filter(date >= INTERVENTION_START & date <= INTERVENTION_END)
   
    # Get the series
    y_pre <- pre_data[[value_col]]
    n_pre <- length(y_pre)
    n_intervention <- nrow(intervention_data)
   
    # Get actual intervention period values
    post_actuals <- intervention_data[[value_col]]
   
    # Initial parameter values (on log scale)
    init_parm <- c(log(var(y_pre) * 0.1),   # V
                   log(var(y_pre) * 0.01),   # W_level
                   log(var(y_pre) * 0.001),  # W_slope
                   log(var(y_pre) * 0.01))   # W_seasonal
   
    # Fit the DLM using MLE
    fit <- tryCatch({
        dlmMLE(y_pre, parm = init_parm, build = build_dlm, hessian = TRUE)
    }, error = function(e) {
        cat(paste0("    Warning: MLE optimization had issues, using default parameters\n"))
        list(par = init_parm, convergence = 1)
    })
   
    # Build the fitted model
    mod_fitted <- build_dlm(fit$par)
   
    # Run Kalman filter and smoother
    filtered <- dlmFilter(y_pre, mod_fitted)
    smoothed <- dlmSmooth(filtered)
   
    # Extract smoothed states
    # State order: [level, slope, seasonal_1, ..., seasonal_11]
    smoothed_states <- smoothed$s
   
    # Get fitted values (level + seasonal)
    # F matrix selects level (position 1) and first seasonal (position 3)
    fitted_pre <- numeric(n_pre)
    for (t in 1:n_pre) {
        # Level is state 1, seasonal effect is state 3
        fitted_pre[t] <- smoothed_states[t + 1, 1] + smoothed_states[t + 1, 3]
    }
   
    # ============================================================
    # POST-MODEL RESIDUAL DIAGNOSTICS
    # ============================================================
    residuals_model <- y_pre - fitted_pre
   
    # ADF test on residuals
    adf_resid <- tryCatch({
        adf.test(residuals_model, alternative = "stationary")
    }, error = function(e) list(p.value = NA, statistic = NA))
   
    # KPSS test on residuals
    kpss_resid <- tryCatch({
        kpss.test(residuals_model, null = "Level")
    }, error = function(e) list(p.value = NA, statistic = NA))
   
    # Ljung-Box test for autocorrelation in residuals
    ljung_box <- tryCatch({
        Box.test(residuals_model, lag = 12, type = "Ljung-Box")
    }, error = function(e) list(p.value = NA, statistic = NA))
   
    residual_diagnostics <- list(
        adf_pvalue = adf_resid$p.value,
        adf_stationary = ifelse(!is.na(adf_resid$p.value) && adf_resid$p.value < 0.05, "Yes", "No"),
        kpss_pvalue = kpss_resid$p.value,
        kpss_stationary = ifelse(!is.na(kpss_resid$p.value) && kpss_resid$p.value > 0.05, "Yes", "No"),
        ljung_box_pvalue = ljung_box$p.value,
        no_autocorrelation = ifelse(!is.na(ljung_box$p.value) && ljung_box$p.value > 0.05, "Yes", "No")
    )
   
    # ============================================================
    # FORECASTING AND SIMULATION
    # ============================================================
   
    # Get the final state estimates and covariance
    final_state <- smoothed_states[n_pre + 1, ]
   
    # Get state covariance from the filter
    # Use the filtered covariance at the last time point
    state_cov <- dlmSvd2var(filtered$U.C, filtered$D.C)[[n_pre]]
   
    # Extract variance components
    V <- mod_fitted$V[1, 1]  # Observation variance
    W <- mod_fitted$W        # State variance matrix
    G <- mod_fitted$GG       # State transition matrix
   
    # Generate counterfactual forecasts via simulation
    mean_diffs <- numeric(n_sims)
    sim_paths_all <- matrix(NA, nrow = n_sims, ncol = n_intervention)
   
    for (sim in 1:n_sims) {
        if (sim %% 2000 == 0) cat(paste0("  Simulation ", sim, "/", n_sims, "\n"))
       
        # Draw initial state from the posterior
        state_draw <- mvrnorm(n = 1, mu = final_state, Sigma = state_cov)
       
        # Forward simulate states and observations
        sim_path <- numeric(n_intervention)
        current_state <- state_draw
       
        for (h in 1:n_intervention) {
            # Evolve state
            state_noise <- mvrnorm(n = 1, mu = rep(0, length(current_state)), Sigma = W)
            current_state <- as.numeric(G %*% current_state) + state_noise
           
            # Generate observation (level + seasonal + noise)
            obs_mean <- current_state[1] + current_state[3]  # level + seasonal
            obs_noise <- rnorm(1, mean = 0, sd = sqrt(V))
            sim_path[h] <- obs_mean + obs_noise
        }
       
        sim_paths_all[sim, ] <- sim_path
       
        # Calculate effect: mean of (actual - counterfactual)
        mean_diffs[sim] <- mean(post_actuals - sim_path)
    }
   
    # Calculate prediction intervals
    pred_lower <- apply(sim_paths_all, 2, quantile, probs = 0.025)
    pred_upper <- apply(sim_paths_all, 2, quantile, probs = 0.975)
    pred_mean <- apply(sim_paths_all, 2, mean)
   
    # Calculate summary statistics for effect
    estimate <- mean(mean_diffs)
    ci_lower <- quantile(mean_diffs, 0.025)
    ci_upper <- quantile(mean_diffs, 0.975)
   
    # Calculate p-value
    if (estimate >= 0) {
        p_value <- mean(mean_diffs < 0) * 2
    } else {
        p_value <- mean(mean_diffs > 0) * 2
    }
    p_value <- min(p_value, 1)
   
    # Extract variance estimates for reporting
    var_obs <- V
    var_level <- W[1, 1]
    var_slope <- W[2, 2]
    var_seasonal <- W[3, 3]
   
    # ============================================================
    # EXTRACT DECOMPOSED COMPONENTS
    # ============================================================
   
    # Trend = level component
    trend_component <- smoothed_states[2:(n_pre + 1), 1]
   
    # Slope (rate of change in trend)
    slope_component <- smoothed_states[2:(n_pre + 1), 2]
   
    # Seasonal component
    seasonal_component <- smoothed_states[2:(n_pre + 1), 3]
   
    return(list(
        results = data.frame(
            estimate = estimate,
            ci_lower = ci_lower,
            ci_upper = ci_upper,
            p_value = p_value,
            model_order = "DLM(trend+seasonal)",
            var_obs = var_obs,
            var_level = var_level,
            var_slope = var_slope,
            var_seasonal = var_seasonal
        ),
        fitted_pre = fitted_pre,
        last_fitted = tail(fitted_pre, 1),
        pred_mean = pred_mean,
        pred_lower = pred_lower,
        pred_upper = pred_upper,
        mean_diffs = mean_diffs,
        pre_dates = pre_data$date,
        intervention_dates = intervention_data$date,
        residual_diagnostics = residual_diagnostics,
        trend_component = trend_component,
        slope_component = slope_component,
        seasonal_component = seasonal_component,
        residuals = residuals_model,
        mod_fitted = mod_fitted,
        smoothed_states = smoothed_states
    ))
}

