# Function to run the experiment
run_forecast_experiment <- function(data, value_col, train_end, h) {
   
    # Split data
    train_data <- data %>% dplyr::filter(date <= train_end)
    test_data <- data %>% dplyr::filter(date > train_end) %>% head(h)
   
    if (nrow(test_data) < h) {
        return(NULL)
    }
   
    y_train <- train_data[[value_col]]
    y_test <- test_data[[value_col]]
    n_train <- length(y_train)
   
    # Initial parameters
    init_parm <- c(log(var(y_train) * 0.1),
                   log(var(y_train) * 0.01),
                   log(var(y_train) * 0.001),
                   log(var(y_train) * 0.01))
   
    # Fit DLM
    fit <- tryCatch({
        dlmMLE(y_train, parm = init_parm, build = build_dlm, hessian = TRUE)
    }, error = function(e) {
        list(par = init_parm, convergence = 1)
    })
   
    mod_fitted <- build_dlm(fit$par)
   
    # Filter and smooth
    filtered <- dlmFilter(y_train, mod_fitted)
    smoothed <- dlmSmooth(filtered)
   
    # Get fitted values for training period
    smoothed_states <- smoothed$s
    fitted_train <- numeric(n_train)
    for (t in 1:n_train) {
        fitted_train[t] <- smoothed_states[t + 1, 1] + smoothed_states[t + 1, 3]
    }
   
    # Get final state and covariance
    final_state <- smoothed$s[n_train + 1, ]
    state_cov <- dlmSvd2var(filtered$U.C, filtered$D.C)[[n_train]]
   
    # Extract matrices
    V <- mod_fitted$V[1, 1]
    W <- mod_fitted$W
    G <- mod_fitted$GG
   
    # Generate point forecasts (mean path)
    forecast_mean <- numeric(h)
    current_state <- final_state
   
    for (step in 1:h) {
        current_state <- as.numeric(G %*% current_state)
        forecast_mean[step] <- current_state[1] + current_state[3]
    }
   
    # Generate prediction intervals via simulation
    n_sims <- 5000
    sim_paths <- matrix(NA, nrow = n_sims, ncol = h)
   
    for (sim in 1:n_sims) {
        state_draw <- mvrnorm(n = 1, mu = final_state, Sigma = state_cov)
        current_state <- state_draw
       
        for (step in 1:h) {
            state_noise <- mvrnorm(n = 1, mu = rep(0, length(current_state)), Sigma = W)
            current_state <- as.numeric(G %*% current_state) + state_noise
            obs_noise <- rnorm(1, mean = 0, sd = sqrt(V))
            sim_paths[sim, step] <- current_state[1] + current_state[3] + obs_noise
        }
    }
   
    forecast_lower <- apply(sim_paths, 2, quantile, probs = 0.025)
    forecast_upper <- apply(sim_paths, 2, quantile, probs = 0.975)
   
    # Calculate metrics
    residuals <- y_test - forecast_mean
    mae <- mean(abs(residuals))
    rmse <- sqrt(mean(residuals^2))
    mape <- mean(abs(residuals / y_test)) * 100
   
    # Coverage: proportion of actuals within 95% PI
    coverage <- mean(y_test >= forecast_lower & y_test <= forecast_upper)
   
    return(list(
        metrics = data.frame(
            MAE = mae,
            RMSE = rmse,
            MAPE = mape,
            Coverage_95 = coverage * 100
        ),
        forecast_mean = forecast_mean,
        forecast_lower = forecast_lower,
        forecast_upper = forecast_upper,
        actual_test = y_test,
        dates_test = test_data$date,
        fitted_train = fitted_train,
        actual_train = y_train,
        dates_train = train_data$date
    ))
}

