# ============================================================
# PLOTTING FUNCTION
# ============================================================

plot_forecast_experiment <- function(prov, measure_type = "mean") {
   
    key <- paste0(prov, "_", measure_type)
    exp_data <- forecast_details[[key]]
   
    if (is.null(exp_data)) return(NULL)
   
    # Get metrics for subtitle
    metrics <- forecast_results %>%
        dplyr::filter(GEO == prov & measure == tools::toTitleCase(measure_type))
   
    measure_label <- ifelse(measure_type == "mean", "Average", "Median")
   
    # Get padding values
    last_fitted_value <- tail(exp_data$fitted_train, 1)
   
    # Build unified data frame
    # Training period: actual + fitted
    train_df <- data.frame(
        date = exp_data$dates_train,
        actual = exp_data$actual_train,
        fitted = exp_data$fitted_train,
        forecast = NA_real_,
        lower = NA_real_,
        upper = NA_real_
    )
   
    # Padding row: connect fitted to forecast
    padding_row <- data.frame(
        date = TRAIN_END,
        actual = tail(exp_data$actual_train, 1),
        fitted = last_fitted_value,
        forecast = last_fitted_value,
        lower = last_fitted_value,
        upper = last_fitted_value
    )
   
    # Forecast period: actual + forecast + PI
    forecast_df <- data.frame(
        date = exp_data$dates_test,
        actual = exp_data$actual_test,
        fitted = NA_real_,
        forecast = exp_data$forecast_mean,
        lower = exp_data$forecast_lower,
        upper = exp_data$forecast_upper
    )
   
    # Combine
    plot_df <- rbind(train_df, padding_row, forecast_df)
   
    # Filter to plot range
    plot_df <- plot_df %>% dplyr::filter(date >= PLOT_START & date <= PLOT_END)
   
    # Date breaks: Jan each year + Jun 2023 (NO Dec 2022)
    year_breaks <- seq(as.Date("2018-01-01"), as.Date("2023-01-01"), by = "year")
    all_breaks <- sort(unique(c(year_breaks, FORECAST_END)))
   
    # Labels
    date_labels <- sapply(all_breaks, function(d) {
        if (d == FORECAST_END) {
            return("Jun\n2023")
        } else {
            return(paste0("Jan\n", year(d)))
        }
    })
   
    # Y-axis range
    y_max <- max(plot_df$actual, plot_df$forecast, plot_df$upper, na.rm = TRUE)
    y_min <- min(plot_df$actual, plot_df$forecast, plot_df$lower, na.rm = TRUE)
   
    # Build plot
    p <- ggplot(plot_df, aes(x = date)) +
        # Prediction interval ribbon
        geom_ribbon(aes(ymin = lower, ymax = upper, fill = "95% Prediction Interval"),
                    alpha = 0.4, na.rm = TRUE) +
        # Actual data (black)
        geom_line(aes(y = actual, color = "Actual Data"), linewidth = 0.7, na.rm = TRUE) +
        # Fitted model (red solid)
        geom_line(aes(y = fitted, color = "Fitted Model"), linewidth = 0.8, na.rm = TRUE) +
        # Forecast (red dotted)
        geom_line(aes(y = forecast, color = "Model Forecast"),
                  linetype = "dotted", linewidth = 1, na.rm = TRUE) +
        # Vertical line at training end
        geom_vline(aes(xintercept = TRAIN_END, linetype = "Training Period"),
                   color = "black", linewidth = 0.6) +
        # Color scale
        scale_color_manual(
            name = "",
            values = c("Actual Data" = "black",
                       "Fitted Model" = "red",
                       "Model Forecast" = "red"),
            guide = guide_legend(
                order = 1,
                override.aes = list(
                    linetype = c("solid", "solid", "dotted"),
                    linewidth = c(0.7, 0.8, 1)
                )
            )
        ) +
        # Fill scale
        scale_fill_manual(
            name = "",
            values = c("95% Prediction Interval" = "lightpink"),
            guide = guide_legend(order = 2)
        ) +
        # Linetype scale for vertical line
        scale_linetype_manual(
            name = "",
            values = c("Training Period" = "dotted"),
            guide = guide_legend(
                order = 3,
                override.aes = list(color = "black", linewidth = 0.6)
            )
        ) +
        # X-axis
        scale_x_date(
            breaks = all_breaks,
            labels = date_labels,
            limits = c(PLOT_START, PLOT_END + 15),
            expand = expansion(mult = c(0.01, 0.01))
        ) +
        # Labels
        labs(
            title = paste0(prov, ": ", measure_label, " Grocery Price Index"),
            subtitle = paste0(
                "Model fit: Jan 2018 - Dec 2022 | Forecast evaluated: Jan 2023 - Jun 2023\n",
                "MAPE: ", round(metrics$MAPE, 2), "% | RMSE: ", round(metrics$RMSE, 3),
                " | 95% Coverage: ", round(metrics$Coverage_95, 1), "%"
            ),
            x = "",
            y = paste0(measure_label, " Grocery Price Index\n(Index Points)"),
            caption = DATA_SOURCE
        ) +
        # Theme
        theme_minimal() +
        theme(
            plot.title = element_text(face = "bold", size = 12),
            plot.subtitle = element_text(size = 9),
            plot.caption = element_text(hjust = 0, size = 8),
            legend.position = "bottom",
            legend.box = "horizontal",
            legend.text = element_text(size = 8),
            axis.text.x = element_text(size = 8),
            axis.title.y = element_text(size = 9)
        )
   
    return(p)
}

