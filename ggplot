library(ggplot2)
library(patchwork)

# ============================================================
# N x N Grid of Lag Selection Diagrams — Pure ggplot2
# ============================================================
# CONFIGURE HERE: set n to control grid size
# n = 4 means 4x4 (16 models), n = 5 means 5x5 (25 models), etc.
# ============================================================

n <- 5

# ============================================================

grn <- '#66BB6A'
red <- '#EF5350'
nvy <- '#1B3A5C'
gry <- '#BBBBBB'

set.seed(42)

var_names <- c('USD/\nCAD', 'US\nCore', 'US Food\nImp.', 'FAO\nFood', 'Energy\nCPI', 'Core\nCPI CA')

lag_labels <- paste0(1:6, 'mo')
n_vars <- length(var_names)
n_lags <- 6

build_unit_plot <- function(unit_label) {
    selected <- matrix(runif(n_lags * n_vars) > 0.5, nrow = n_lags, ncol = n_vars)
    
    df <- expand.grid(var = 1:n_vars, lag = 1:n_lags)
    df$sel <- as.vector(t(selected))
    df$fill <- ifelse(df$sel, grn, red)
    df$txt <- as.character(df$lag)
    df$lag_rev <- (n_lags + 1) - df$lag
    
    p <- ggplot(df, aes(x = var, y = lag_rev)) +
        geom_tile(aes(fill = fill), colour = 'white', linewidth = 1,
                  width = 0.88, height = 0.78, show.legend = FALSE) +
        geom_text(aes(label = txt), colour = 'white', size = 2.0,
                  fontface = 'bold') +
        scale_fill_identity() +
        scale_x_continuous(
            breaks = 1:n_vars,
            labels = var_names,
            position = 'top',
            expand = expansion(mult = 0.08)
        ) +
        scale_y_continuous(
            breaks = n_lags:1,
            labels = lag_labels,
            expand = expansion(mult = 0.08)
        ) +
        labs(title = unit_label) +
        theme_minimal(base_size = 7) +
        theme(
            plot.title       = element_text(hjust = 0.5, size = 8, face = 'bold',
                                            colour = nvy, margin = margin(b = 3)),
            axis.title       = element_blank(),
            axis.text.x.top  = element_text(size = 5, colour = nvy, lineheight = 0.85),
            axis.text.y      = element_blank(),
            axis.ticks       = element_blank(),
            panel.grid       = element_blank(),
            plot.margin      = margin(3, 3, 3, 3),
            plot.background  = element_rect(fill = 'white', colour = '#DDDDDD',
                                            linewidth = 0.4)
        )
    
    # Column arrows
    for (v in 1:n_vars) {
        for (r in 1:(n_lags - 1)) {
            y_start <- (n_lags + 1) - r - 0.42
            y_end   <- (n_lags + 1) - (r + 1) + 0.42
            p <- p + annotate('segment', x = v, xend = v,
                              y = y_start, yend = y_end,
                              colour = gry, linewidth = 0.25,
                              arrow = arrow(length = unit(0.03, 'inches'),
                                            type = 'closed'))
        }
    }
    
    p
}

# -- Build n*n plots --
plots <- lapply(1:(n * n), function(i) build_unit_plot(paste('Model', i)))

# -- Assemble NxN grid --
combined <- wrap_plots(plots, ncol = n, nrow = n)

# View in R plot pane
print(combined)

