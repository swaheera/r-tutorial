#v3 =====================================================================
#  Naive population-lag forecasting of fruit sales
#  Expanding-window cross-validation grid
#
#  Metric per fold : total-year APE
#                    |sum(actual, 12 m) - sum(forecast, 12 m)| / sum(actual, 12 m)
#  Model selection : mean of that APE across CV folds ("average MAPE")
#  Population      : treated as KNOWN (oracle) for every month, incl. test year
#
#  Base method families (21 sales-only configs + 21 configs per lag set)
#    Sales-only : SNAIVE, MOM, DRIFT, SEASF, EWMA
#    Population : RATIO, SMOOTH, DAMP, ADD, PCMY, SPLIT, PCSEAS, PCEWMA, MULTIBASE
#  Lag sets     : single lags 0..18 (19) + all lag pairs (171)
#  Ensembles    : family champions (picked on COMPLETED earlier folds only),
#                 all subsets of 2-4 families x {mean, median, inverse-error},
#                 plus ALL-mean, ALL-median, best-sales + best-pop, rolling selection
#
#  Series        : GROUP_A, GROUP_B, their TOTAL (A + B), any other groups,
#                  and a derived B forecast = total forecast - A forecast
#
#  To use your own data: delete the SIMULATED DATA block and fill in the
#  data frame name and column names in the INPUT block.
#  The driver column must have no gaps; sales can be NA before they start.
# =====================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(ggplot2)
})

# ---------------------------------------------------------------------
# SIMULATED DATA -- delete this block when using your own data
# ---------------------------------------------------------------------
set.seed(42)
sim_dates   <- seq(as.Date("2017-01-01"), as.Date("2026-09-01"), by = "month")
sales_start <- as.Date("2021-04-01")
population  <- 5e6 + cumsum(rnorm(length(sim_dates), mean = 8000, sd = 6000))

# before sales start: one row per month, fruit and sales NA, population filled
early <- data.frame(date  = sim_dates[sim_dates < sales_start],
                    fruit = NA_character_, sales = NA_real_)

# from sales start: one row per month per fruit
later <- expand.grid(date = sim_dates[sim_dates >= sales_start],
                     fruit = c("apple", "banana"), stringsAsFactors = FALSE)
later$sales <- rnorm(nrow(later), mean = ifelse(later$fruit == "apple", 50000, 80000), sd = 3000)

df <- rbind(early, later)
df$population <- population[match(df$date, sim_dates)]
df <- df[order(df$date, df$fruit), c("date", "population", "fruit", "sales")]
rownames(df) <- NULL
