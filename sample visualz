cat(sprintf("   `%s`: %d rows | %s values: %s\n", DF_NAME, nrow(dat), GROUP_COL,
            paste(unique(sales_rows$fruit), collapse = ", ")))
cat(sprintf("   %s: %s..%s | %s: %s..%s\n",
            POP_COL,   ym(min(pop_series$date)), ym(max(pop_series$date)),
