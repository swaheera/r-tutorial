# ---------------------------------------------------------------------
# INPUT: data frame name and column names (edit these)
# ---------------------------------------------------------------------
DF_NAME   <- "df"              # name of your data frame object, e.g. "my_sales"
DATE_COL  <- "date"            # monthly date (Date or "YYYY-MM-DD"; snapped to the 1st)
GROUP_COL <- "fruit"           # series identifier, e.g. "product"
SALES_COL <- "sales"           # target, e.g. "units_sold"
POP_COL   <- "population"      # driver, e.g. "pop_total"

GROUP_A      <- "apple"         # value in GROUP_COL for series A
GROUP_B      <- "banana"        # value in GROUP_COL for series B
TOTAL_NAME   <- "total"         # label for the A + B series
DERIVED_NAME <- paste0(GROUP_B, " (", TOTAL_NAME, " - ", GROUP_A, ")")  # B forecast as total - A

t_start <- Sys.time()
ym <- function(x) format(x, "%Y-%m")

# ---------------------------------------------------------------------
# 0. Settings
# ---------------------------------------------------------------------
LAGS           <- 0:18   # population lags in months
HORIZON        <- 12     # test window length (months)
MIN_HISTORY    <- 12     # months of sales needed before the first forecast origin
MIN_DONE_FOLDS <- 6      # completed earlier folds needed before ensembles start
ROLL_WINDOW    <- 12     # completed folds used by rolling selection
RANK_STAT      <- "mean" # rank models by "mean" or "median" MAPE across folds
if (!RANK_STAT %in% c("mean", "median")) stop('RANK_STAT must be "mean" or "median"')

SALES_FAMILIES <- c("SNAIVE", "MOM", "DRIFT", "SEASF", "EWMA")
POP_FAMILIES   <- c("RATIO", "SMOOTH", "DAMP", "ADD", "PCMY", "SPLIT",
                    "PCSEAS", "PCEWMA", "MULTIBASE")
ALL_FAMILIES   <- c(SALES_FAMILIES, POP_FAMILIES)

# ---------------------------------------------------------------------
# 0b. Readable model names (internal codes stay in `method_code`)
# ---------------------------------------------------------------------
FAMILY_LABEL <- c(
  SNAIVE    = "Same month last year",
  MOM       = "Sales momentum",
  DRIFT     = "Long-run sales growth",
  SEASF     = "Seasonal pattern",
  EWMA      = "Smoothed seasonal pattern",
  RATIO     = "Pop growth",
  SMOOTH    = "Smoothed pop growth",
  DAMP      = "Elastic pop growth",
  ADD       = "Added people x sales per person",
  PCMY      = "Sales per person, multi-year",
  SPLIT     = "Pop growth x per-person growth",
  PCSEAS    = "Per-person seasonal pattern",
  PCEWMA    = "Per-person smoothed seasonal",
  MULTIBASE = "Two base years x pop growth",
  ENS       = "Ensemble",
  ROLLING   = "Rolling pick",
  COMBO     = "Total minus A"
)
FACTOR_LABEL   <- c(blk_mean = "avg of past years", blk_median = "median of past years",
                    blk_latest = "last year only", cma_mean = "centred moving avg")
COMBINER_LABEL <- c(mean = "Avg of best", median = "Median of best",
                    invw = "Error-weighted avg of best")

pretty_one <- function(code) {
  parts <- strsplit(code, "|", fixed = TRUE)[[1]]
  fam   <- parts[1]

  if (fam == "ENS") {
    how <- parts[2]; members <- parts[3]
    if (members == "ALL") {
      return(sprintf("%s: all %d families", COMBINER_LABEL[[how]], length(ALL_FAMILIES)))
    }
    if (members == "BEST_SALES+BEST_POP") return("Avg of best sales-only + best pop model")
    fams <- strsplit(members, "+", fixed = TRUE)[[1]]
    return(paste0(COMBINER_LABEL[[how]], ": ", paste(FAMILY_LABEL[fams], collapse = " + ")))
  }
  if (fam == "ROLLING") return(sprintf("Rolling pick: best single model of last %d folds", ROLL_WINDOW))
  if (fam == "COMBO")   return(sprintf("Best %s model - best %s model", TOTAL_NAME, GROUP_A))

  kv <- parts[-1]
  p  <- setNames(sub(".*=", "", kv), sub("=.*", "", kv))
  details <- switch(fam,
    MOM    = sprintf("last %s mo", p[["m"]]),
    SEASF  = sprintf("%s, level of last %s mo", FACTOR_LABEL[[p[["f"]]]], p[["m"]]),
    EWMA   = sprintf("weight %s on newest month", p[["a"]]),
    SMOOTH = sprintf("%s-mo avg", p[["w"]]),
    DAMP   = sprintf("elasticity %s", p[["k"]]),
    PCMY   = if (p[["y"]] == "all") "all years" else sprintf("last %s yrs", p[["y"]]),
    SPLIT  = sprintf("per-person growth of last %s mo", p[["m"]]),
    PCSEAS = sprintf("%s, level of last %s mo", FACTOR_LABEL[[p[["f"]]]], p[["m"]]),
    PCEWMA = sprintf("weight %s on newest month", p[["a"]]),
    NULL)

  lag_txt <- NULL
  if ("lags" %in% names(p)) {
    l <- strsplit(p[["lags"]], "+", fixed = TRUE)[[1]]
    lag_txt <- if (length(l) == 1) sprintf("lag %s", l) else sprintf("avg of lags %s", paste(l, collapse = " & "))
  }
  paste0(FAMILY_LABEL[[fam]],
         if (!is.null(details)) paste0(" (", details, ")"),
         if (!is.null(lag_txt)) paste0(", ", lag_txt))
}

# vectorised with caching (results has many repeated codes)
pretty_name <- function(codes) {
  u <- unique(codes)
  unname(vapply(u, pretty_one, character(1))[match(codes, u)])
}

# wrap long legend labels
wrap_label <- function(x, width = 75) {
  vapply(x, function(s) paste(strwrap(s, width), collapse = "\n    "), character(1), USE.NAMES = FALSE)
}

