# ---------------------------------------------------------------------
# INPUT: data frame name and column names (edit these)
# ---------------------------------------------------------------------
DF_NAME   <- "df"              # name of your data frame object, e.g. "my_sales"
DATE_COL  <- "date"            # monthly date (Date or "YYYY-MM-DD"; snapped to the 1st)
GROUP_COL <- "fruit"           # series identifier, e.g. "product"
SALES_COL <- "sales"           # target, e.g. "units_sold"
POP_COL   <- "population"      # driver, e.g. "pop_total"

t_start <- Sys.time()
ym <- function(x) format(x, "%Y-%m")

# ---------------------------------------------------------------------
# 0. Settings
# ---------------------------------------------------------------------
LAGS           <- 0:18   # population lags in months
HORIZON        <- 12     # test window length (months)
MIN_HISTORY    <- 12     # months of sales needed before the first forecast origin
MIN_DONE_FOLDS <- 6      # completed earlier folds needed before ensembles start
ROLL_WINDOW    <- 12     # completed folds used by rolling selection

SALES_FAMILIES <- c("SNAIVE", "MOM", "DRIFT", "SEASF", "EWMA")
POP_FAMILIES   <- c("RATIO", "SMOOTH", "DAMP", "ADD", "PCMY", "SPLIT",
                    "PCSEAS", "PCEWMA", "MULTIBASE")
ALL_FAMILIES   <- c(SALES_FAMILIES, POP_FAMILIES)

# ---------------------------------------------------------------------
# 1. Read input using the configured names
#     Internally the code uses: date, fruit, sales, population.
#     Your names are restored on every output at the end.
# ---------------------------------------------------------------------
cat("\n== 1. Reading input ==\n")
if (!exists(DF_NAME)) stop("No object called `", DF_NAME, "` found. Check DF_NAME.")
raw <- get(DF_NAME)

needed       <- c(DATE_COL, GROUP_COL, SALES_COL, POP_COL)
missing_cols <- setdiff(needed, names(raw))
if (length(missing_cols) > 0) {
  stop("Column(s) not found in `", DF_NAME, "`: ", paste(missing_cols, collapse = ", "),
       "\n  Available: ", paste(names(raw), collapse = ", "))
}

dat <- data.frame(
  date       = as.Date(format(as.Date(raw[[DATE_COL]]), "%Y-%m-01")),
  fruit      = trimws(as.character(raw[[GROUP_COL]])),
  sales      = as.numeric(raw[[SALES_COL]]),
  population = as.numeric(raw[[POP_COL]]),
  stringsAsFactors = FALSE
)

# rows without a date cannot be used at all
bad_date <- is.na(dat$date)
if (any(bad_date)) {
  cat(sprintf("   WARNING: dropping %d row(s) with missing/unreadable `%s`\n",
              sum(bad_date), DATE_COL))
  dat <- dat[!bad_date, ]
}
dat$fruit[!is.na(dat$fruit) & dat$fruit == ""] <- NA

# population: ONE series by date, taken from ALL rows (incl. rows with no group,
# e.g. early months where only population exists)
pop_series <- dat %>%
  filter(!is.na(population)) %>%
  distinct(date, population) %>%
