}
sales_rows <- dat %>% filter(!is.na(fruit)) %>% select(date, fruit, sales)
if (nrow(sales_rows) == 0) stop("No rows with a `", GROUP_COL, "` value.")

# the same month twice within a group would break the monthly series
dups <- sales_rows %>% count(fruit, date) %>% filter(n > 1)
if (nrow(dups) > 0) {
  print(head(dups, 10))
  stop("Duplicate ", DATE_COL, " values within ", GROUP_COL, " (shown above). ",
