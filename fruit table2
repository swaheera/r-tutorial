# =============================================================================

config <- list(

  df                 = NULL,

  response_col       = "response",
  scenario_col       = "scenario",
  true_scenario_col  = "true_scenario",
  actual_col         = "total_real",
  forecast_col       = "total_forecast",
  trained_on_col     = "training_period",
  tested_on_col      = "testing_period"
)

# =============================================================================
# SIMULATE DATA — Replace with your real data, then set config$df
# =============================================================================

set.seed(42)
scenarios <- seq(-3, 3, by = 0.5)
bases     <- c(Apple = 1500, Banana = 250000, Cherry = 3500000)
n_periods <- 10

rows <- list()
for (resp in names(bases)) {
  for (p in 1:n_periods) {
    av <- round(rnorm(1, bases[resp], bases[resp] * 0.1))
    ts <- sample(scenarios, 1)
    for (sc in scenarios) {
      rows[[length(rows) + 1]] <- data.frame(
        response        = resp,
        training_period = paste0("Jan ", 2019 + p, " to Jan ", 2020 + p),
        testing_period  = paste0("Feb ", 2020 + p, " to Dec ", 2020 + p),
        total_real      = av,
        true_scenario   = ts,
        scenario        = sc,
        total_forecast  = round(av * runif(1, 0.85, 1.15)),
        stringsAsFactors = FALSE
      )
    }
  }
}
config$df <- do.call(rbind, rows)

