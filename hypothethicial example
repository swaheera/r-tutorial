  document.querySelectorAll(".kind").forEach(c=>c.addEventListener("change",()=>{c.checked?kindOn.add(c.value):kindOn.delete(c.value);draw()}));
  // five random headlines, each from a different year, among the stories that can be shown now
  function pick5(){const v=visibleStories();v.forEach(s=>sel.delete(s.id));const by={};
    v.forEach(s=>{const y=new Date(s.ms).getUTCFullYear();(by[y]=by[y]||[]).push(s)});
    const ys=Object.keys(by);for(let i=ys.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ys[i],ys[j]]=[ys[j],ys[i]]}
    ys.slice(0,5).forEach(y=>{const a=by[y];sel.add(a[Math.floor(Math.random()*a.length)].id)})}
  const pickIfNone=()=>{if(!visibleStories().some(s=>sel.has(s.id)))pick5()};
  document.getElementById("b-reset").onclick=()=>{pick5();draw()};
  document.getElementById("b-all").onclick=()=>{visibleStories().forEach(s=>sel.add(s.id));draw()};
  document.getElementById("b-none").onclick=()=>{visibleStories().forEach(s=>sel.delete(s.id));draw()};
  pick5();
  el.on("plotly_click",d=>{const u=d.points[0].customdata;if(u)window.open(u,"_blank")});
  draw();
}
)---"

