  const SYM_OF=s=>national(s)?"star":"square";
  const STATCAN="https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1710000901";
  // ---- data series
  function popSeries(code){const g=geos[code];return g.ms.map((t,i)=>[t,g.v[i]])}
  const yoyStart=()=>{const t=geos.CA.ms[4];return t?MON[new Date(t).getUTCMonth()]+" "+new Date(t).getUTCFullYear():"—"};
  function series(code,m){const P=popSeries(code);if(m==="pop")return P;
    const out=[];for(let i=4;i<P.length;i++)out.push([P[i][0],P[i][1]/P[i-4][1]-1,P[i-4],P[i]]);return out}
  // ---- stories
