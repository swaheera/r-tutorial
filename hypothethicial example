  const o3=(p,q,r)=>Math.sign((q[0]-p[0])*(r[1]-p[1])-(q[1]-p[1])*(r[0]-p[0]));
  const cross=(a,b,c,d)=>o3(a,b,c)!==o3(a,b,d)&&o3(c,d,a)!==o3(c,d,b);
  function place(items,anchors,lines,samples,cap,B){const placed=[],fails=[];let total=0;
    const lineCross=(a,b)=>{let n=0;lines.forEach(P=>{for(let k=1;k<P.length;k++)if(cross(a,b,P[k-1],P[k]))n++});return n};
