# Helper function for hover text
format_num <- function(x) formatC(round(x, 0), format = "f", big.mark = ",", digits = 0)

create_hover_text <- function(df) {
  
  # Build scenario assumptions text dynamically
  scenario_text <- sapply(1:nrow(df), function(i) {
    txt <- ""
    for (fv in fruit_vars) {
      pct_col <- paste0(fv, "_pct")
      if (!is.na(df[[pct_col]][i])) {
        txt <- paste0(txt, fv, ": ", df[[pct_col]][i], "%<br>")
      }
    }
    txt
  })
  
  paste0(
    "<b>Rank: ", df$rank, "</b><br>",
    "<b>", forecast_horizon, "-Month Forecast</b><br>",
    "<b>Period:</b> ", format(forecast_start_date, "%b %Y"), " to ", format(forecast_end_date, "%b %Y"), "<br>",
    "<br>",
    "<b>--- Variables ---</b><br>",
    df$combo_name, "<br>",
    "<br>",
    "<b>--- Scenario Assumptions ---</b><br>",
    scenario_text,
    "<br>",
    "<b>--- Accuracy (Forecast / Actual) ---</b><br>",
    total_col, ": ", format_num(df$sum_forecast_total), " / ", format_num(df$sum_actual_total), 
    " = ", round(df$accuracy_total, 1), "%<br>",
    response1_col, ": ", format_num(df$sum_forecast_response1), " / ", format_num(df$sum_actual_response1), 
    " = ", round(df$accuracy_response1, 1), "%<br>",
    response2_col, ": ", format_num(df$sum_forecast_response2), " / ", format_num(df$sum_actual_response2), 
    " = ", round(df$accuracy_response2, 1), "%<br>",
    "<br>",
    "<b>Weighted Accuracy: ", round(df$weighted_accuracy, 1), "%</b>"
  )
}

top_n$hover_text <- create_hover_text(top_n)
random_n$hover_text <- create_hover_text(random_n)

