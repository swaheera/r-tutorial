# ============================================
# COMBINED ARIMA (RATIO) + ARIMAX (TOTAL)
# WITH 4 3D VISUALIZATIONS
# ============================================

library(dplyr)
library(forecast)
library(parallel)
library(foreach)
library(doParallel)
library(plotly)

# ============================================
# USER SETTINGS (EDIT THIS SECTION ONLY)
# ============================================

# --- File paths ---
fruits_file <- "fruits.csv"
responses_file <- "responses.csv"

# --- Column names in fruits file ---
date_col <- "month"
fruit_vars <- c("apple", "banana", "grapes", "oranges", "cherries")

# --- Column names in responses file ---
response1_col <- "response1"
response2_col <- "response2"
total_col <- "total_volume"
# Note: percent_response1 and percent_response2 are not used directly
# We calculate ratio from response1 / total_volume

# --- Seasonality settings ---
# Set to TRUE if your data has seasonal patterns (e.g., monthly data with yearly cycles)
use_seasonality <- TRUE
seasonal_frequency <- 12  # 12 for monthly data with yearly seasonality

# --- Data start date (first observation in your data) ---
data_start_year <- 2021
data_start_month <- 4

# --- Forecast period ---
# Training data: everything before forecast_start_date
# Actual data: forecast_start_date to forecast_end_date (used to measure accuracy)
forecast_start_date <- as.Date("2025-04-01")
forecast_end_date <- as.Date("2026-01-01")

# --- Scenario percentage changes to test ---
pct_values <- c(-0.5, -1, -1.5, -2, -2.5, -3, -5, -10, -20, -30, -40, -50)

# --- Plot settings ---
# Colorscale options: "Viridis", "Magma", "Plasma", "Inferno", "Cividis", 
#                     "Blues", "Reds", "YlOrRd", "RdBu"
color_scale <- "Viridis"
n_plot <- 100  # Number of scenarios for Top N and Random N plots

# --- Parallel processing ---
n_cores <- NULL  # Set to NULL to auto-detect, or specify a number (e.g., 4)

# ============================================
# END OF USER SETTINGS
# ============================================

# ============================================
# 1. LOAD AND PREPARE DATA
# ============================================

cat("============================================\n")
cat("LOADING DATA\n")
cat("============================================\n\n")

# Load fruits data
fruits_raw <- read.csv(fruits_file, stringsAsFactors = FALSE)
cat("Loaded fruits data:", nrow(fruits_raw), "rows,", ncol(fruits_raw), "columns\n")

# Load responses data
responses_raw <- read.csv(responses_file, stringsAsFactors = FALSE)
cat("Loaded responses data:", nrow(responses_raw), "rows,", ncol(responses_raw), "columns\n")

# Convert date column to Date type
fruits_raw[[date_col]] <- as.Date(fruits_raw[[date_col]])
responses_raw[[date_col]] <- as.Date(responses_raw[[date_col]])

# Sort by date
fruits_raw <- fruits_raw[order(fruits_raw[[date_col]]), ]
responses_raw <- responses_raw[order(responses_raw[[date_col]]), ]

# Merge datasets
historical_data <- merge(fruits_raw, responses_raw, by = date_col)
cat("Merged data:", nrow(historical_data), "rows\n")
cat("Date range:", format(min(historical_data[[date_col]]), "%Y-%m-%d"), "to", 
    format(max(historical_data[[date_col]]), "%Y-%m-%d"), "\n")

# Verify fruit columns exist
missing_fruits <- setdiff(fruit_vars, names(historical_data))
if (length(missing_fruits) > 0) {
  stop("Missing fruit columns: ", paste(missing_fruits, collapse = ", "))
}
cat("Fruit variables:", paste(fruit_vars, collapse = ", "), "\n")

# Verify response columns exist
required_cols <- c(response1_col, response2_col, total_col)
missing_cols <- setdiff(required_cols, names(historical_data))
if (length(missing_cols) > 0) {
  stop("Missing response columns: ", paste(missing_cols, collapse = ", "))
}
cat("Response variables:", response1_col, ",", response2_col, ",", total_col, "\n")

# ============================================
# 2. SPLIT INTO TRAINING AND ACTUAL
# ============================================

cat("\n============================================\n")
cat("SPLITTING DATA\n")
cat("============================================\n\n")

# Training data: before forecast start date
training_data <- historical_data[historical_data[[date_col]] < forecast_start_date, ]
cat("Training data:", nrow(training_data), "rows\n")
cat("  From:", format(min(training_data[[date_col]]), "%Y-%m-%d"), "\n")
cat("  To:", format(max(training_data[[date_col]]), "%Y-%m-%d"), "\n")

# Actual data: forecast period
actual_data <- historical_data[historical_data[[date_col]] >= forecast_start_date & 
                                historical_data[[date_col]] <= forecast_end_date, ]
cat("Actual data:", nrow(actual_data), "rows\n")
cat("  From:", format(min(actual_data[[date_col]]), "%Y-%m-%d"), "\n")
cat("  To:", format(max(actual_data[[date_col]]), "%Y-%m-%d"), "\n")

# Forecast parameters
n_forecast_months <- nrow(actual_data)
forecast_horizon <- n_forecast_months

cat("Forecast horizon:", forecast_horizon, "months\n")

# ============================================
# 3. CALCULATE RATIO AND CREATE TIME SERIES
# ============================================

cat("\n============================================\n")
cat("PREPARING TIME SERIES\n")
cat("============================================\n\n")

# Calculate ratio (response1 / total)
training_data$ratio <- training_data[[response1_col]] / training_data[[total_col]]

# Logit transform for modeling (handles 0-1 constraint)
# Add small epsilon to avoid log(0) or log(inf)
epsilon <- 1e-6
training_data$ratio_clipped <- pmax(pmin(training_data$ratio, 1 - epsilon), epsilon)
training_data$logit_ratio <- log(training_data$ratio_clipped / (1 - training_data$ratio_clipped))

cat("Ratio range:", round(min(training_data$ratio), 4), "to", round(max(training_data$ratio), 4), "\n")

# Create time series objects if seasonality is enabled
if (use_seasonality) {
  cat("Seasonality: ENABLED (frequency =", seasonal_frequency, ")\n")
  cat("Data starts:", data_start_year, "month", data_start_month, "\n")
  
  ts_logit_ratio <- ts(training_data$logit_ratio, 
                       start = c(data_start_year, data_start_month), 
                       frequency = seasonal_frequency)
  
  ts_total <- ts(training_data[[total_col]], 
                 start = c(data_start_year, data_start_month), 
                 frequency = seasonal_frequency)
} else {
  cat("Seasonality: DISABLED\n")
  
  ts_logit_ratio <- training_data$logit_ratio
  ts_total <- training_data[[total_col]]
}

# ============================================
# 4. FIT ARIMA MODEL FOR RATIO
# ============================================

cat("\n============================================\n")
cat("FITTING ARIMA MODEL FOR RATIO\n")
cat("============================================\n\n")

arima_ratio <- auto.arima(ts_logit_ratio, seasonal = use_seasonality)
cat("ARIMA model for ratio:\n")
print(summary(arima_ratio))

# Forecast ratio
fc_logit_ratio <- forecast(arima_ratio, h = n_forecast_months)
logit_ratio_forecast <- as.numeric(fc_logit_ratio$mean)

# Back-transform from logit to probability (0-1)
ratio_forecast <- exp(logit_ratio_forecast) / (1 + exp(logit_ratio_forecast))

cat("\nRatio forecasts:\n")
print(round(ratio_forecast, 4))

# ============================================
# 5. DEFINE VARIABLE COMBINATIONS
# ============================================

cat("\n============================================\n")
cat("GENERATING VARIABLE COMBINATIONS\n")
cat("============================================\n\n")

all_vars <- fruit_vars

all_combinations <- list()
combo_id <- 1

for (k in 1:length(all_vars)) {
  combos <- combn(all_vars, k, simplify = FALSE)
  for (combo in combos) {
    all_combinations[[combo_id]] <- combo
    combo_id <- combo_id + 1
  }
}

n_combinations <- length(all_combinations)
cat("Total variable combinations:", n_combinations, "\n")

# Print all combinations
for (i in 1:n_combinations) {
  cat("  Combo", i, ":", paste(all_combinations[[i]], collapse = " + "), "\n")
}

# ============================================
# 6. HELPER FUNCTIONS
# ============================================

get_scenarios_for_combo <- function(combo, pct_values) {
  grid_list <- list()
  for (var in combo) {
    grid_list[[paste0(var, "_pct")]] <- pct_values
  }
  expand.grid(grid_list)
}

project_regressors <- function(last_values, pct_changes, n_months_total, n_forecast_months, vars_used) {
  proj <- matrix(NA, nrow = n_forecast_months, ncol = length(vars_used))
  colnames(proj) <- vars_used
  for (var in vars_used) {
    pct_col <- paste0(var, "_pct")
    mult <- (1 + pct_changes[[pct_col]] / 100)^(1 / n_months_total)
    for (m in 1:n_forecast_months) {
      proj[m, var] <- last_values[[var]] * mult^m
    }
  }
  return(proj)
}

# ============================================
# 7. SET UP PARAMETERS
# ============================================

cat("\n============================================\n")
cat("SETTING UP PARAMETERS\n")
cat("============================================\n\n")

# Last known values from training data
last_row <- tail(training_data, 1)
last_values <- list()
for (var in fruit_vars) {
  last_values[[var]] <- last_row[[var]]
}

cat("Last known values:\n")
for (var in fruit_vars) {
  cat("  ", var, ":", last_values[[var]], "\n")
}

n_months_total <- n_forecast_months

# Actual sums for error calculation
sum_actual_response1 <- sum(actual_data[[response1_col]])
sum_actual_response2 <- sum(actual_data[[response2_col]])
sum_actual_total <- sum(actual_data[[total_col]])

cat("\nActual sums (for comparison):\n")
cat("  ", response1_col, ":", round(sum_actual_response1, 2), "\n")
cat("  ", response2_col, ":", round(sum_actual_response2, 2), "\n")
cat("  ", total_col, ":", round(sum_actual_total, 2), "\n")

# Set up parallel processing
if (is.null(n_cores)) {
  n_cores <- detectCores() - 1
}
cat("\nParallel cores:", n_cores, "\n")

# ============================================
# 8. MAIN FUNCTION
# ============================================

run_combined <- function() {
  
  all_results <- vector("list", n_combinations)
  
  cat("\n============================================\n")
  cat("RUNNING SCENARIO ANALYSIS\n")
  cat("============================================\n\n")
  
  cat("Total combinations:", n_combinations, "\n")
  cat("Using", n_cores, "cores\n\n")
  
  cl <- makeCluster(n_cores)
  registerDoParallel(cl)
  cat("Cluster ready!\n\n")
  
  for (combo_idx in 1:n_combinations) {
    
    vars_used <- all_combinations[[combo_idx]]
    combo_name <- paste(vars_used, collapse = " + ")
    expand_combo <- get_scenarios_for_combo(vars_used, pct_values)
    n_scenarios <- nrow(expand_combo)
    
    cat("Combo", combo_idx, "/", n_combinations, ":", combo_name, "\n")
    cat("  Scenarios:", n_scenarios, "\n")
    
    # Prepare xreg for training
    xreg_hist <- as.matrix(training_data[, vars_used, drop = FALSE])
    
    # Create time series for total if seasonality enabled
    if (use_seasonality) {
      ts_total_combo <- ts(training_data[[total_col]], 
                           start = c(data_start_year, data_start_month), 
                           frequency = seasonal_frequency)
      arimax_total <- auto.arima(ts_total_combo, xreg = xreg_hist, seasonal = use_seasonality)
    } else {
      arimax_total <- auto.arima(training_data[[total_col]], xreg = xreg_hist, seasonal = FALSE)
    }
    
    # Extract coefficients
    coefs <- coef(arimax_total)
    reg_coefs <- coefs[vars_used]
    intercept <- ifelse("intercept" %in% names(coefs), coefs["intercept"], 0)
    
    cat("  Coefficients:", paste(names(reg_coefs), "=", round(reg_coefs, 4), collapse = ", "), "\n")
    cat("  Intercept:", round(intercept, 4), "\n")
    
    # Export to cluster
    clusterExport(cl, c(
      "reg_coefs", "intercept", "last_values", "n_months_total", "n_forecast_months",
      "forecast_horizon", "ratio_forecast",
      "sum_actual_response1", "sum_actual_response2", "sum_actual_total",
      "expand_combo", "vars_used", "project_regressors", "fruit_vars"
    ), envir = environment())
    
    combo_start <- Sys.time()
    
    results_combo <- foreach(i = 1:n_scenarios, .combine = rbind) %dopar% {
      
      pct_changes <- as.list(expand_combo[i, , drop = FALSE])
      xreg_forecast <- project_regressors(last_values, pct_changes, n_months_total, n_forecast_months, vars_used)
      
      # Forecast total using coefficients
      total_forecast <- as.numeric(xreg_forecast %*% reg_coefs) + intercept
      
      # Decompose using ratio forecast
      response1_forecast <- total_forecast * ratio_forecast
      response2_forecast <- total_forecast * (1 - ratio_forecast)
      
      # Sum forecasts
      sum_forecast_total <- sum(head(total_forecast, forecast_horizon))
      sum_forecast_response1 <- sum(head(response1_forecast, forecast_horizon))
      sum_forecast_response2 <- sum(head(response2_forecast, forecast_horizon))
      
      # Calculate errors
      abs_error_total <- abs(sum_forecast_total - sum_actual_total) / sum_actual_total
      abs_error_response1 <- abs(sum_forecast_response1 - sum_actual_response1) / sum_actual_response1
      abs_error_response2 <- abs(sum_forecast_response2 - sum_actual_response2) / sum_actual_response2
      
      # Convert to accuracy (0-100%)
      accuracy_total <- pmax(0, (1 - abs_error_total)) * 100
      accuracy_response1 <- pmax(0, (1 - abs_error_response1)) * 100
      accuracy_response2 <- pmax(0, (1 - abs_error_response2)) * 100
      
      # Build result row
      result_row <- data.frame(
        combo_id = combo_idx,
        combo_name = paste(vars_used, collapse = " + "),
        n_vars = length(vars_used),
        scenario_id = i,
        sum_forecast_total = sum_forecast_total,
        sum_forecast_response1 = sum_forecast_response1,
        sum_forecast_response2 = sum_forecast_response2,
        sum_actual_total = sum_actual_total,
        sum_actual_response1 = sum_actual_response1,
        sum_actual_response2 = sum_actual_response2,
        abs_error_total = abs_error_total,
        abs_error_response1 = abs_error_response1,
        abs_error_response2 = abs_error_response2,
        accuracy_total = accuracy_total,
        accuracy_response1 = accuracy_response1,
        accuracy_response2 = accuracy_response2
      )
      
      # Add pct columns for all fruit vars
      for (fv in fruit_vars) {
        pct_col_name <- paste0(fv, "_pct")
        if (fv %in% vars_used) {
          result_row[[pct_col_name]] <- pct_changes[[pct_col_name]]
        } else {
          result_row[[pct_col_name]] <- NA
        }
      }
      
      result_row
    }
    
    combo_end <- Sys.time()
    combo_time <- round(difftime(combo_end, combo_start, units = "secs"), 2)
    cat("  Time:", combo_time, "secs\n\n")
    
    all_results[[combo_idx]] <- results_combo
  }
  
  cat("Stopping cluster...\n")
  stopCluster(cl)
  
  cat("Done! Combining results...\n")
  do.call(rbind, all_results)
}

# ============================================
# 9. RUN IT
# ============================================

cat("============================================\n")
cat("STARTING ANALYSIS\n")
cat("============================================\n\n")

start_time <- Sys.time()
results <- run_combined()
end_time <- Sys.time()

total_time <- difftime(end_time, start_time, units = "secs")

# ============================================
# 10. ADD WEIGHTED ACCURACY & SORT
# ============================================

w <- 1/3

results$weighted_accuracy <- w * results$accuracy_total + 
                             w * results$accuracy_response1 + 
                             w * results$accuracy_response2

results_sorted <- results %>% arrange(desc(weighted_accuracy))
results_sorted$rank <- 1:nrow(results_sorted)

# ============================================
# 11. RESULTS SUMMARY
# ============================================

cat("\n============================================\n")
cat("RESULTS SUMMARY\n")
cat("============================================\n")
cat("Total combinations:", n_combinations, "\n")
cat("Total scenarios:", nrow(results), "\n")
cat("Total time:", round(total_time, 2), "seconds\n")
cat("Forecast period:", format(forecast_start_date, "%Y-%m-%d"), "to", format(forecast_end_date, "%Y-%m-%d"), "\n")
cat("Forecast horizon:", forecast_horizon, "months\n")
cat("Seasonality:", ifelse(use_seasonality, "ENABLED", "DISABLED"), "\n")

cat("\n=== TOP 20 SCENARIOS ===\n")
print(head(results_sorted[, c("rank", "combo_name", "weighted_accuracy",
                               "accuracy_total", "accuracy_response1", "accuracy_response2")], 20))

