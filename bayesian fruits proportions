sim_q_dates <- seq(as.Date("2020-01-01"), as.Date("2025-10-01"), by = "3 months")
sim_n_q     <- length(sim_q_dates)
sim_pop     <- 38e6 * cumprod(c(1, rep(1 + 0.013 / 4, sim_n_q - 1))) +
    cumsum(rnorm(sim_n_q, 0, 15000))
write.csv(data.frame(date = sim_q_dates, population = sim_pop),
          POP_FILE, row.names = FALSE)

sim_m_dates <- seq(as.Date("2020-01-01"), as.Date("2025-10-01"), by = "month")
sim_n_m     <- length(sim_m_dates)
sim_pop_m   <- approx(as.numeric(sim_q_dates), sim_pop,
                      xout = as.numeric(sim_m_dates), rule = 2)$y
sim_pop_sc  <- (sim_pop_m - mean(sim_pop_m)) / sd(sim_pop_m)

sim_apple <- 30000 + 600 * c(rep(0, 3), sim_pop_sc[1:(sim_n_m - 3)]) +
    400 * c(rep(0, 6), sim_pop_sc[1:(sim_n_m - 6)]) +
    as.numeric(arima.sim(list(ar = 0.5, ma = 0.2), n = sim_n_m, sd = 300)) +
    rnorm(sim_n_m, 0, 150)

sim_banana <- 20000 + 500 * c(rep(0, 3), sim_pop_sc[1:(sim_n_m - 3)]) +
    300 * c(rep(0, 6), sim_pop_sc[1:(sim_n_m - 6)]) +
    200 * c(rep(0, 12), sim_pop_sc[1:(sim_n_m - 12)]) +
    as.numeric(arima.sim(list(ar = 0.6, ma = 0.3), n = sim_n_m, sd = 350)) +
    rnorm(sim_n_m, 0, 100)

sim_total <- sim_apple + sim_banana

keep <- sim_m_dates >= as.Date("2020-04-01")
write.csv(data.frame(
    date         = sim_m_dates[keep],
    apple_sales  = round(sim_apple[keep], 2),
    banana_sales = round(sim_banana[keep], 2),
    total_sales  = round(sim_total[keep], 2)
), DATA_FILE, row.names = FALSE)

cat("Simulated data written.\n\n")

