build_xreg_mat <- function(pop_vec, lags) {
    n <- length(pop_vec)
    X <- matrix(NA_real_, nrow = n, ncol = length(lags))
    colnames(X) <- paste0("pop_lag", lags)
    for (k in seq_along(lags)) {
        L <- lags[k]
        X[, k] <- c(rep(NA_real_, L), pop_vec[1:(n - L)])
    }
    return(X)
}

inv_logit <- function(x) 1 / (1 + exp(-x))

# Generate posterior predictive draws given parameter draws and X_new
# draws_params: matrix with columns b0, b1..bK, phi, sigma
# y_train: training y (to compute last residual)
# X_train: training X
# X_new: future X (h x K)
# Returns matrix (n_draws x h)
generate_predictions <- function(draws_params, y_train, X_train, X_new, K, h) {
    n_draws  <- nrow(draws_params)
    N_train  <- length(y_train)
    y_pred   <- matrix(NA_real_, nrow = n_draws, ncol = h)
    
    for (d in 1:n_draws) {
        b0    <- draws_params[d, 1]
        b     <- draws_params[d, 2:(K + 1)]
        phi   <- draws_params[d, K + 2]
        sigma <- draws_params[d, K + 3]
        
        # Last training residual
        mu_last    <- b0 + sum(X_train[N_train, ] * b)
        last_resid <- y_train[N_train] - mu_last
        
        # Future mu
        mu_new <- b0 + as.numeric(X_new %*% b)
        
        # AR(1) forward simulation
        y_pred[d, 1] <- mu_new[1] + phi * last_resid + rnorm(1, 0, sigma)
        for (t in 2:h) {
            y_pred[d, t] <- mu_new[t] + phi * (y_pred[d, t - 1] - mu_new[t - 1]) +
                rnorm(1, 0, sigma)
        }
    }
    return(y_pred)
}

# Same for null model (no regressors)
generate_predictions_null <- function(draws_null, y_train, h) {
    n_draws <- nrow(draws_null)
    N_train <- length(y_train)
    y_pred  <- matrix(NA_real_, nrow = n_draws, ncol = h)
    
    for (d in 1:n_draws) {
        b0    <- draws_null[d, "b0"]
        phi   <- draws_null[d, "phi"]
        sigma <- draws_null[d, "sigma"]
        
        last_resid <- y_train[N_train] - b0
        y_pred[d, 1] <- b0 + phi * last_resid + rnorm(1, 0, sigma)
        for (t in 2:h) {
            y_pred[d, t] <- b0 + phi * (y_pred[d, t - 1] - b0) + rnorm(1, 0, sigma)
        }
    }
    return(y_pred)
}

