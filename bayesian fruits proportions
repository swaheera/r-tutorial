INTCPT_PRIOR_SD <- 100
AR_PRIOR_SD     <- 0.5

# --- Adaptation --------------------------------------------------------------
ADAPT_INTERVAL  <- 100    # tune proposal SDs every N iterations during warmup
TARGET_ACCEPT   <- 0.25   # target acceptance rate

