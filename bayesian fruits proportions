# MCMC ENGINE
# ══════════════════════════════════════════════════════════════════════════════

#' Log-likelihood for linear regression with AR(1) errors
#' y[t] = mu[t] + e[t],  e[t] = phi * e[t-1] + eps[t],  eps ~ N(0, sigma^2)
#' where mu[t] = b0 + X[t,] %*% b
log_likelihood_ar1 <- function(y, X, b0, b, phi, sigma) {
    N   <- length(y)
    mu  <- b0 + as.numeric(X %*% b)
    res <- y - mu
    
    # First obs: marginal variance = sigma^2 / (1 - phi^2) if |phi| < 1
    if (abs(phi) >= 1) return(-Inf)
    marg_var <- sigma^2 / (1 - phi^2)
    
    ll <- dnorm(res[1], mean = 0, sd = sqrt(marg_var), log = TRUE)
    for (t in 2:N) {
        ll <- ll + dnorm(res[t], mean = phi * res[t - 1], sd = sigma, log = TRUE)
    }
    return(ll)
}

#' Log-prior for the full parameter vector
log_prior <- function(b0, b, phi, sigma, K,
                      slope_mu, slope_sd, intcpt_sd, ar_sd) {
    # b0: normal
    
    lp <- dnorm(b0, 0, intcpt_sd, log = TRUE)
    
    # b[k]: truncated normal at 0 — if any b[k] < 0, return -Inf
    if (any(b < 0)) return(-Inf)
    for (k in 1:K) {
        # log density of truncated normal: log(dnorm) - log(1 - Phi(-mu/sd))
        lp <- lp + dnorm(b[k], slope_mu, slope_sd, log = TRUE) -
            pnorm(0, slope_mu, slope_sd, lower.tail = FALSE, log.p = TRUE)
    }
    
    # phi: normal truncated to (-1, 1)
    if (abs(phi) >= 1) return(-Inf)
    lp <- lp + dnorm(phi, 0, ar_sd, log = TRUE) -
        log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd))
    
    # sigma: half-t(3, 0, 10)
    if (sigma <= 0) return(-Inf)
    lp <- lp + dt(sigma / 10, df = 3, log = TRUE) - log(10) +
        log(2)  # half-t normalization
    
    return(lp)
}

#' Log-posterior (unnormalized)
log_posterior <- function(y, X, b0, b, phi, sigma, K,
                          slope_mu, slope_sd, intcpt_sd, ar_sd) {
    lp <- log_prior(b0, b, phi, sigma, K, slope_mu, slope_sd, intcpt_sd, ar_sd)
    if (is.infinite(lp)) return(-Inf)
    lp + log_likelihood_ar1(y, X, b0, b, phi, sigma)
}

#' Run one chain of Metropolis-within-Gibbs
#' Returns list with draws matrix and acceptance rates
run_mcmc_chain <- function(y, X, K, n_iter, n_warmup, thin, seed,
                           slope_mu, slope_sd, intcpt_sd, ar_sd,
                           chain_id = 1, print_every = 500) {
    set.seed(seed + chain_id)
    
    n_params <- 1 + K + 1 + 1   # b0, b[1..K], phi, sigma
    param_names <- c("b0", paste0("b", 1:K), "phi", "sigma")
    n_keep <- floor((n_iter - n_warmup) / thin)
    
    # Storage
    draws <- matrix(NA_real_, nrow = n_keep, ncol = n_params)
    colnames(draws) <- param_names
    accept_count <- rep(0L, n_params)
    total_count  <- rep(0L, n_params)
    
    # Initial values
    b0    <- rnorm(1, 0, 1)
    b     <- abs(rnorm(K, slope_mu, 0.5))  # start positive
    phi   <- runif(1, -0.3, 0.3)
    sigma <- abs(rnorm(1, sd(y) * 0.5, sd(y) * 0.1))
    
    # Proposal SDs (will be adapted during warmup)
    prop_sd <- c(sd(y) * 0.01,            # b0
                 rep(0.01, K),             # b[k]
                 0.02,                     # phi
                 sd(y) * 0.01)             # sigma
    names(prop_sd) <- param_names
    
    # Adaptation tracking
    adapt_accept <- rep(0L, n_params)
    adapt_total  <- rep(0L, n_params)
    
    cur_lp <- log_posterior(y, X, b0, b, phi, sigma, K,
                            slope_mu, slope_sd, intcpt_sd, ar_sd)
    
    draw_idx <- 0
    
    for (iter in 1:n_iter) {
        
        # --- Update b0 ---
        b0_star <- rnorm(1, b0, prop_sd["b0"])
        lp_star <- log_posterior(y, X, b0_star, b, phi, sigma, K,
                                 slope_mu, slope_sd, intcpt_sd, ar_sd)
        if (log(runif(1)) < (lp_star - cur_lp)) {
            b0 <- b0_star; cur_lp <- lp_star
            accept_count[1] <- accept_count[1] + 1
            adapt_accept[1] <- adapt_accept[1] + 1
        }
        total_count[1] <- total_count[1] + 1
        adapt_total[1] <- adapt_total[1] + 1
        
        # --- Update b[k] one at a time ---
        for (k in 1:K) {
            pidx <- 1 + k
            b_star <- b
            b_star[k] <- rnorm(1, b[k], prop_sd[pidx])
            if (b_star[k] >= 0) {  # respect truncation
                lp_star <- log_posterior(y, X, b0, b_star, phi, sigma, K,
                                         slope_mu, slope_sd, intcpt_sd, ar_sd)
                if (log(runif(1)) < (lp_star - cur_lp)) {
                    b <- b_star; cur_lp <- lp_star
                    accept_count[pidx] <- accept_count[pidx] + 1
                    adapt_accept[pidx] <- adapt_accept[pidx] + 1
                }
            }
            total_count[pidx] <- total_count[pidx] + 1
            adapt_total[pidx] <- adapt_total[pidx] + 1
        }
        
        # --- Update phi ---
        pidx <- 1 + K + 1
        phi_star <- rnorm(1, phi, prop_sd["phi"])
        if (abs(phi_star) < 1) {
            lp_star <- log_posterior(y, X, b0, b, phi_star, sigma, K,
                                     slope_mu, slope_sd, intcpt_sd, ar_sd)
            if (log(runif(1)) < (lp_star - cur_lp)) {
                phi <- phi_star; cur_lp <- lp_star
                accept_count[pidx] <- accept_count[pidx] + 1
                adapt_accept[pidx] <- adapt_accept[pidx] + 1
            }
        }
        total_count[pidx] <- total_count[pidx] + 1
        adapt_total[pidx] <- adapt_total[pidx] + 1
        
        # --- Update sigma ---
        pidx <- 1 + K + 2
        sigma_star <- rnorm(1, sigma, prop_sd["sigma"])
        if (sigma_star > 0) {
            lp_star <- log_posterior(y, X, b0, b, phi, sigma_star, K,
                                     slope_mu, slope_sd, intcpt_sd, ar_sd)
            if (log(runif(1)) < (lp_star - cur_lp)) {
                sigma <- sigma_star; cur_lp <- lp_star
                accept_count[pidx] <- accept_count[pidx] + 1
                adapt_accept[pidx] <- adapt_accept[pidx] + 1
            }
        }
        total_count[pidx] <- total_count[pidx] + 1
        adapt_total[pidx] <- adapt_total[pidx] + 1
        
        # --- Adapt proposal SDs during warmup ---
        if (iter <= n_warmup && iter %% ADAPT_INTERVAL == 0) {
            for (p in 1:n_params) {
                rate <- adapt_accept[p] / max(adapt_total[p], 1)
                if (rate < TARGET_ACCEPT * 0.8) {
                    prop_sd[p] <- prop_sd[p] * 0.7   # shrink
                } else if (rate > TARGET_ACCEPT * 1.5) {
                    prop_sd[p] <- prop_sd[p] * 1.4   # expand
                }
            }
            adapt_accept[] <- 0L
            adapt_total[]  <- 0L
        }
        
        # --- Store post-warmup ---
        if (iter > n_warmup && (iter - n_warmup) %% thin == 0) {
            draw_idx <- draw_idx + 1
            draws[draw_idx, ] <- c(b0, b, phi, sigma)
        }
        
        # --- Progress ---
        if (iter %% print_every == 0) {
            rates <- round(accept_count / pmax(total_count, 1) * 100, 1)
            phase <- if (iter <= n_warmup) "warmup" else "sampling"
            cat(sprintf("    chain %d | iter %5d / %d (%s) | accept%%: %s\n",
                        chain_id, iter, n_iter, phase,
                        paste(param_names, "=", rates, collapse = "  ")))
        }
    }
    
    list(
        draws       = draws[1:draw_idx, , drop = FALSE],
        accept_rate = accept_count / pmax(total_count, 1),
        prop_sd     = prop_sd
    )
}

#' Run multiple chains and combine
#' Returns a list: draws (matrix), accept_rates (matrix)
run_mcmc <- function(y, X, K, n_iter, n_warmup, chains, thin, seed,
                     slope_mu, slope_sd, intcpt_sd, ar_sd,
                     label = "", print_every = 500) {
    cat(sprintf("  MCMC [%s]: %d iter × %d chains (warmup = %d, thin = %d)\n",
                label, n_iter, chains, n_warmup, thin))
    
    all_draws  <- list()
    all_accept <- list()
    
    for (ch in 1:chains) {
        cat(sprintf("  -- Chain %d --\n", ch))
        result <- run_mcmc_chain(y, X, K, n_iter, n_warmup, thin,
                                 seed = seed, chain_id = ch,
                                 slope_mu = slope_mu, slope_sd = slope_sd,
                                 intcpt_sd = intcpt_sd, ar_sd = ar_sd,
                                 print_every = print_every)
        all_draws[[ch]]  <- result$draws
        all_accept[[ch]] <- result$accept_rate
        cat(sprintf("    chain %d done: %d post-warmup draws, final accept = %s\n",
                    ch, nrow(result$draws),
                    paste(names(result$accept_rate), "=",
                          round(result$accept_rate * 100, 1), collapse = "  ")))
    }
    
    combined <- do.call(rbind, all_draws)
    accept_mat <- do.call(rbind, all_accept)
    
    cat(sprintf("  Combined: %d draws total\n", nrow(combined)))
    cat(sprintf("  Mean accept rates: %s\n",
                paste(colnames(combined), "=",
                      round(colMeans(accept_mat) * 100, 1), collapse = "  ")))
    
    list(draws = combined, accept_rates = accept_mat)
}

#' Null model sampler (intercept + AR(1) only, no regressors)
run_mcmc_null <- function(y, n_iter, n_warmup, chains, thin, seed,
                          intcpt_sd, ar_sd, label = "", print_every = 500) {
    # Treat as K = 0 case: parameters are b0, phi, sigma
    N <- length(y)
    
    log_posterior_null <- function(b0, phi, sigma) {
        if (sigma <= 0 || abs(phi) >= 1) return(-Inf)
        # Prior
        lp <- dnorm(b0, 0, intcpt_sd, log = TRUE)
        lp <- lp + dnorm(phi, 0, ar_sd, log = TRUE) -
            log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd))
        lp <- lp + dt(sigma / 10, df = 3, log = TRUE) - log(10) + log(2)
        # Likelihood
        marg_var <- sigma^2 / (1 - phi^2)
        res <- y - b0
        lp <- lp + dnorm(res[1], 0, sqrt(marg_var), log = TRUE)
        for (t in 2:N) {
            lp <- lp + dnorm(res[t], phi * res[t - 1], sigma, log = TRUE)
        }
        return(lp)
    }
    
    cat(sprintf("  MCMC [%s]: %d iter × %d chains (warmup = %d)\n",
                label, n_iter, chains, n_warmup))
    
    all_draws <- list()
    
    for (ch in 1:chains) {
        set.seed(seed + ch)
        cat(sprintf("  -- Chain %d --\n", ch))
        
        n_keep <- floor((n_iter - n_warmup) / thin)
        draws <- matrix(NA_real_, nrow = n_keep, ncol = 3)
        colnames(draws) <- c("b0", "phi", "sigma")
        
        b0    <- rnorm(1, mean(y), sd(y) * 0.1)
        phi   <- runif(1, -0.3, 0.3)
        sigma <- sd(y) * 0.5
        
        prop_sd <- c(b0 = sd(y) * 0.01, phi = 0.02, sigma = sd(y) * 0.01)
        accept_count <- c(b0 = 0L, phi = 0L, sigma = 0L)
        total_count  <- c(b0 = 0L, phi = 0L, sigma = 0L)
        adapt_acc    <- c(b0 = 0L, phi = 0L, sigma = 0L)
        adapt_tot    <- c(b0 = 0L, phi = 0L, sigma = 0L)
        
        cur_lp <- log_posterior_null(b0, phi, sigma)
        draw_idx <- 0
        
        for (iter in 1:n_iter) {
            # b0
            b0s <- rnorm(1, b0, prop_sd["b0"])
            lps <- log_posterior_null(b0s, phi, sigma)
            if (log(runif(1)) < (lps - cur_lp)) {
                b0 <- b0s; cur_lp <- lps
                accept_count["b0"] <- accept_count["b0"] + 1
                adapt_acc["b0"] <- adapt_acc["b0"] + 1
            }
            total_count["b0"] <- total_count["b0"] + 1
            adapt_tot["b0"] <- adapt_tot["b0"] + 1
            
            # phi
            phis <- rnorm(1, phi, prop_sd["phi"])
            if (abs(phis) < 1) {
                lps <- log_posterior_null(b0, phis, sigma)
                if (log(runif(1)) < (lps - cur_lp)) {
                    phi <- phis; cur_lp <- lps
                    accept_count["phi"] <- accept_count["phi"] + 1
                    adapt_acc["phi"] <- adapt_acc["phi"] + 1
                }
            }
            total_count["phi"] <- total_count["phi"] + 1
            adapt_tot["phi"] <- adapt_tot["phi"] + 1
            
            # sigma
            sigs <- rnorm(1, sigma, prop_sd["sigma"])
            if (sigs > 0) {
                lps <- log_posterior_null(b0, phi, sigs)
                if (log(runif(1)) < (lps - cur_lp)) {
                    sigma <- sigs; cur_lp <- lps
                    accept_count["sigma"] <- accept_count["sigma"] + 1
                    adapt_acc["sigma"] <- adapt_acc["sigma"] + 1
                }
            }
            total_count["sigma"] <- total_count["sigma"] + 1
            adapt_tot["sigma"] <- adapt_tot["sigma"] + 1
            
            # Adapt
            if (iter <= n_warmup && iter %% ADAPT_INTERVAL == 0) {
                for (p in names(prop_sd)) {
                    rate <- adapt_acc[p] / max(adapt_tot[p], 1)
                    if (rate < TARGET_ACCEPT * 0.8) prop_sd[p] <- prop_sd[p] * 0.7
                    else if (rate > TARGET_ACCEPT * 1.5) prop_sd[p] <- prop_sd[p] * 1.4
                }
                adapt_acc[] <- 0L; adapt_tot[] <- 0L
            }
            
            if (iter > n_warmup && (iter - n_warmup) %% thin == 0) {
                draw_idx <- draw_idx + 1
                draws[draw_idx, ] <- c(b0, phi, sigma)
            }
            
            if (iter %% print_every == 0) {
                rates <- round(accept_count / pmax(total_count, 1) * 100, 1)
                phase <- if (iter <= n_warmup) "warmup" else "sampling"
                cat(sprintf("    chain %d | iter %5d / %d (%s) | accept%%: b0=%s  phi=%s  sigma=%s\n",
                            ch, iter, n_iter, phase, rates["b0"], rates["phi"], rates["sigma"]))
            }
        }
        all_draws[[ch]] <- draws[1:draw_idx, , drop = FALSE]
        cat(sprintf("    chain %d done: %d draws\n", ch, draw_idx))
    }
    
    combined <- do.call(rbind, all_draws)
    cat(sprintf("  Combined: %d draws total\n", nrow(combined)))
    list(draws = combined)
}

