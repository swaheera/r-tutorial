################################################################################
# Bayesian Monotonic Forecasting — Fruit Sales
# *** Pure R MCMC sampler (no Stan, no brms, no QuickJSR) ***
#
# Model (for both total and logit(apple_share)):
#   y[t] = b0 + b[1]*pop_lag3[t] + b[2]*pop_lag6[t] + b[3]*pop_lag12[t] + e[t]
#   e[t] = phi * e[t-1] + eps[t],   eps[t] ~ N(0, sigma^2)
#
# Priors:
#   b[k] ~ N(slope_mu, slope_sd) truncated below at 0   (monotonicity)
#   b0   ~ N(0, intcpt_sd)
#   phi  ~ N(0, ar_sd) truncated to (-1, 1)              (stationarity)
#   sigma ~ Half-t(3, 0, 10)                              (positive)
#
# Sampler: Metropolis-within-Gibbs with adaptive proposal SDs
#   - Each parameter updated one-at-a-time via random-walk MH
#   - Proposal SDs tuned during warmup to target ~25% acceptance
#
# Structure:
#   Model 1: total_sales ~ lagged population + AR(1)
#   Model 2: logit(apple_share) ~ lagged population + AR(1)
#   apple_forecast  = total_forecast × inv_logit(share_forecast)
#   banana_forecast = total_forecast × (1 − inv_logit(share_forecast))
#
# Dependencies: tidyverse, zoo   (base R packages only for MCMC)
################################################################################

library(tidyverse)
library(zoo)

set.seed(42)

