library(dplyr)
library(forecast)

# =============================================================================
# CONFIG
# =============================================================================

CONFIG <- list(
  df_name            = "mydf",
  date_col           = "date",
  target_col         = "apple_sales",
  pop_col            = "population",
  n_lags             = 4,
  scenario_min       = -3,
  scenario_max       = 3,
  scenario_step      = 0.5,
  log_response       = FALSE,
  log_all_predictors = FALSE
)

# =============================================================================
# DATA SETUP (simulated — replace with your own)
# =============================================================================

set.seed(42)
dates <- seq.Date(from = as.Date("2020-04-01"), by = "month", length.out = 67)
population <- cumsum(rnorm(67, mean = 0.5, sd = 1)) + 100
apple_sales <- 500 + 2 * population + rnorm(67, sd = 10)

mydf <- data.frame(
  date = dates,
  apple_sales = apple_sales,
  population = population
)

# =============================================================================
# HELPER: back-transform if log was applied
# =============================================================================

back_transform <- function(x, is_logged) {
  if (is_logged) exp(x) else x
}

