# ---- Optional: split combined.txt into smaller parts ----
# Saves part1.txt, part2.txt, ... in the working directory. Each part is at most
# `mb` megabytes; the last part holds the remainder. Parts end at a line break.
split_file <- function(file = file.path(getwd(), "combined.txt"), mb = 1) {
  b <- readBin(file, "raw", file.size(file))
  if (length(b) >= 3 && all(b[1:3] == as.raw(c(0xEF, 0xBB, 0xBF)))) b <- b[-(1:3)]  # drop UTF-8 marker
  limit <- mb * 1024^2
  nl    <- which(b == as.raw(0x0A))           # positions of line breaks
  start <- 1
  part  <- 0
  while (start <= length(b)) {
    end <- min(start + limit - 1, length(b))
    if (end < length(b)) {
      k <- findInterval(end, nl)              # last line break that fits
      if (k > 0 && nl[k] >= start) {
        end <- nl[k]
      } else {                                # one very long line: don't cut a letter in half
        while (end > start && as.integer(b[end + 1]) %/% 64 == 2) end <- end - 1
      }
    }
    part <- part + 1
    out  <- file.path(getwd(), paste0("part", part, ".txt"))
    writeBin(c(as.raw(c(0xEF, 0xBB, 0xBF)), b[start:end]), out)
    cat(sprintf("part%d.txt  %.2f MB\n", part, (end - start + 1) / 1024^2)); flush.console()
    start <- end + 1
  }
  cat(part, "parts saved in", getwd(), "\n")
}

