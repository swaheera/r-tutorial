)


# ---- 2. BUILD GT TABLE ------------------------------------------------------

gt_ca <- tbl %>%
    gt() %>%
    
    tab_header(
        title    = md("**Literature Review: Factors Affecting Food CPI in Canada**"),
        subtitle = md("*Selected applied studies*")
    ) %>%
    
    cols_label(
        study       = md("**Study**"),
        method_data = md("**Methodology & Data**"),
        variables   = md("**Variables**"),
        findings    = md("**Key Findings**")
    ) %>%
    
    cols_width(
        study       ~ px(200),
        method_data ~ px(260),
        variables   ~ px(200),
        findings    ~ px(260)
    ) %>%
    
    fmt_markdown(columns = c(study, method_data, variables)) %>%
    
    # ── Header style ──
    tab_style(
        style = list(
            cell_fill(color = "#1B3A5C"),
            cell_text(color = "white", weight = "bold", size = px(11))
        ),
        locations = cells_column_labels()
    ) %>%
    
    # ── Title ──
    tab_style(
        style = cell_text(size = px(15)),
        locations = cells_title(groups = "title")
    ) %>%
    tab_style(
        style = cell_text(size = px(11), color = "grey40"),
        locations = cells_title(groups = "subtitle")
    ) %>%
    
    # ── Body ──
    tab_style(
        style = cell_text(size = px(9)),
        locations = cells_body()
    ) %>%
    
    # ── Bold the "Lags:" keyword in method_data column ──
    # (already handled via markdown **Lags: Yes/No**)
    
    opt_row_striping() %>%
    
    tab_style(
        style = cell_borders(sides = "bottom", color = "#E0E0E0", weight = px(1)),
        locations = cells_body()
    ) %>%
    
    tab_options(
        table.font.names          = "Arial",
        table.font.size           = px(9),
        heading.align             = "left",
        column_labels.padding     = px(6),
        data_row.padding          = px(5),
        table.border.top.color    = "#1B3A5C",
        table.border.top.width    = px(3),
        table.border.bottom.color = "#1B3A5C",
        table.border.bottom.width = px(2)
    ) %>%
    
    tab_source_note(
        source_note = md(
            "**Response** = outcome variable; **Predictors** = explanatory variables."
        )
    )

# ---- 3. SAVE ----------------------------------------------------------------

gtsave(gt_ca, filename = "lit_review_canada_ppt.html")

