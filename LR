library(gt)
library(dplyr)

# ---- 1. HAND-CRAFTED DATA (simplified from xlsx) ----------------------------
# Keeping text concise and plain-language for slide readability

tbl <- tibble::tribble(
    ~study, ~method_data, ~variables, ~findings,
    
    # 1
    paste0(
