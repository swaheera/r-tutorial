# ============================================================
# ALL PROVINCES REVIEW
# Same flat code, just wrapped in run_province()
# Each CV fold written out explicitly. No inner loops.
# Returns: table1, table2, and plot_data
# ============================================================

options(scipen = 999)
suppressPackageStartupMessages({
    library(tidyverse)
    library(forecast)
    library(lubridate)
    library(lmtest)
    library(tseries)
    library(MASS)
})

set.seed(123)

INTERVENTION_START <- as.Date("2023-07-01")
N_FORECAST_MONTHS  <- 6
INTERVENTION_END   <- INTERVENTION_START %m+% months(N_FORECAST_MONTHS - 1)
N_SIMS             <- 10000

provinces <- unique(master$province)
provinces <- provinces[!grepl("Whitehorse|Yellowknife|Iqaluit|Canada", provinces)]

# ============================================================
# ONE FUNCTION — EVERYTHING INSIDE IS THE SAME FLAT CODE
# ============================================================

run_province <- function(province_name) {

    # --- data prep ---

    df <- master %>%
        dplyr::filter(province == province_name) %>%
        dplyr::arrange(date)

    df$log_usa_imports_L2 <- dplyr::lag(df$log_usa_imports, 2)
    df$us_core_cpi_L2     <- dplyr::lag(df$us_core_cpi, 2)
    df$us_core_cpi_L4     <- dplyr::lag(df$us_core_cpi, 4)
    df$usd_cad_L2         <- dplyr::lag(df$usd_cad, 2)
    m       <- month(df$date)
    df$s3_1 <- as.numeric(m >= 5 & m <= 8)
    df$s3_2 <- as.numeric(m >= 9)
    df <- df %>% drop_na(us_core_cpi_L4)

    xreg_cols <- c("log_usa_imports_L2", "us_core_cpi_L2", "us_core_cpi_L4",
                   "usd_cad_L2", "s3_1", "s3_2")

    train <- df %>% dplyr::filter(date < INTERVENTION_START)
    intv  <- df %>% dplyr::filter(date >= INTERVENTION_START & date <= INTERVENTION_END)

    y_vec      <- train$food_cpi
    y_ts       <- ts(y_vec, frequency = 12)
    xreg_train <- as.matrix(train[, xreg_cols])

    # --- base model ---

    base_fit <- auto.arima(y_ts, seasonal = FALSE)
    base_aic <- AIC(base_fit)

    # --- arimax model ---

    fit       <- auto.arima(y_ts, xreg = xreg_train, seasonal = FALSE,
                            stepwise = FALSE, approximation = FALSE)
    model_aic <- AIC(fit)
    res       <- as.numeric(residuals(fit))

    # --- diagnostics ---

    model_adf  <- adf.test(res)$p.value
    model_lb   <- Box.test(res, lag = 10, type = "Ljung-Box")$p.value
    model_bp   <- bptest(lm(res ~ seq_along(res)))$p.value
    model_sw   <- shapiro.test(res)$p.value
    model_diag <- sum(c(model_adf < 0.05, model_lb >= 0.05, model_bp >= 0.05, model_sw >= 0.05))

    # --- wald test ---

    coefs_all <- coef(fit)
    vcov_all  <- fit$var.coef
    n_total   <- length(coefs_all)
    n_arima_p <- n_total - 6
    xreg_idx  <- (n_arima_p + 1):n_total

    beta_xreg <- coefs_all[xreg_idx]
    vcov_xreg <- vcov_all[xreg_idx, xreg_idx]
    k         <- length(beta_xreg)

    wald_stat <- as.numeric(t(beta_xreg) %*% solve(vcov_xreg) %*% beta_xreg)
    wald_p    <- pchisq(wald_stat, df = k, lower.tail = FALSE)
    joint_sig <- ifelse(wald_p < 0.05, "Yes", "No")

    # ============================================================
    # CROSS-VALIDATION — EACH FOLD WRITTEN OUT
    # ============================================================

    h <- 4

    # ---- FOLD 1: train to Sep 2020, test Oct 2020 – Jan 2021 ----

    cv_train_1 <- train %>% dplyr::filter(date < as.Date("2020-10-01"))
    cv_test_1  <- train %>% dplyr::filter(date >= as.Date("2020-10-01") & date < as.Date("2021-02-01"))

    y_cv_1    <- ts(cv_train_1$food_cpi, frequency = 12)
    y_test_1  <- cv_test_1$food_cpi
    xreg_cv_1 <- as.matrix(cv_train_1[, xreg_cols])
    xreg_te_1 <- as.matrix(cv_test_1[, xreg_cols])

    base_fc_1       <- as.numeric(forecast(auto.arima(y_cv_1, seasonal = FALSE), h = nrow(cv_test_1))$mean)
    base_mape_1     <- mean(abs((y_test_1 - base_fc_1) / y_test_1)) * 100

    model_cv_fit_1  <- auto.arima(y_cv_1, xreg = xreg_cv_1, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_1      <- as.numeric(forecast(model_cv_fit_1, xreg = xreg_te_1, h = nrow(cv_test_1))$mean)
    model_mape_1    <- mean(abs((y_test_1 - model_fc_1) / y_test_1)) * 100

    # ---- FOLD 2: train to Jan 2021, test Feb 2021 – May 2021 ----

    cv_train_2 <- train %>% dplyr::filter(date < as.Date("2021-02-01"))
    cv_test_2  <- train %>% dplyr::filter(date >= as.Date("2021-02-01") & date < as.Date("2021-06-01"))

    y_cv_2    <- ts(cv_train_2$food_cpi, frequency = 12)
    y_test_2  <- cv_test_2$food_cpi
    xreg_cv_2 <- as.matrix(cv_train_2[, xreg_cols])
    xreg_te_2 <- as.matrix(cv_test_2[, xreg_cols])

    base_fc_2       <- as.numeric(forecast(auto.arima(y_cv_2, seasonal = FALSE), h = nrow(cv_test_2))$mean)
    base_mape_2     <- mean(abs((y_test_2 - base_fc_2) / y_test_2)) * 100

    model_cv_fit_2  <- auto.arima(y_cv_2, xreg = xreg_cv_2, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_2      <- as.numeric(forecast(model_cv_fit_2, xreg = xreg_te_2, h = nrow(cv_test_2))$mean)
    model_mape_2    <- mean(abs((y_test_2 - model_fc_2) / y_test_2)) * 100

    # ---- FOLD 3: train to May 2021, test Jun 2021 – Sep 2021 ----

    cv_train_3 <- train %>% dplyr::filter(date < as.Date("2021-06-01"))
    cv_test_3  <- train %>% dplyr::filter(date >= as.Date("2021-06-01") & date < as.Date("2021-10-01"))

    y_cv_3    <- ts(cv_train_3$food_cpi, frequency = 12)
    y_test_3  <- cv_test_3$food_cpi
    xreg_cv_3 <- as.matrix(cv_train_3[, xreg_cols])
    xreg_te_3 <- as.matrix(cv_test_3[, xreg_cols])

    base_fc_3       <- as.numeric(forecast(auto.arima(y_cv_3, seasonal = FALSE), h = nrow(cv_test_3))$mean)
    base_mape_3     <- mean(abs((y_test_3 - base_fc_3) / y_test_3)) * 100

    model_cv_fit_3  <- auto.arima(y_cv_3, xreg = xreg_cv_3, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_3      <- as.numeric(forecast(model_cv_fit_3, xreg = xreg_te_3, h = nrow(cv_test_3))$mean)
    model_mape_3    <- mean(abs((y_test_3 - model_fc_3) / y_test_3)) * 100

    # ---- FOLD 4: train to Sep 2021, test Oct 2021 – Jan 2022 ----

    cv_train_4 <- train %>% dplyr::filter(date < as.Date("2021-10-01"))
    cv_test_4  <- train %>% dplyr::filter(date >= as.Date("2021-10-01") & date < as.Date("2022-02-01"))

    y_cv_4    <- ts(cv_train_4$food_cpi, frequency = 12)
    y_test_4  <- cv_test_4$food_cpi
    xreg_cv_4 <- as.matrix(cv_train_4[, xreg_cols])
    xreg_te_4 <- as.matrix(cv_test_4[, xreg_cols])

    base_fc_4       <- as.numeric(forecast(auto.arima(y_cv_4, seasonal = FALSE), h = nrow(cv_test_4))$mean)
    base_mape_4     <- mean(abs((y_test_4 - base_fc_4) / y_test_4)) * 100

    model_cv_fit_4  <- auto.arima(y_cv_4, xreg = xreg_cv_4, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_4      <- as.numeric(forecast(model_cv_fit_4, xreg = xreg_te_4, h = nrow(cv_test_4))$mean)
    model_mape_4    <- mean(abs((y_test_4 - model_fc_4) / y_test_4)) * 100

    # ---- FOLD 5: train to Jan 2022, test Feb 2022 – May 2022 ----

    cv_train_5 <- train %>% dplyr::filter(date < as.Date("2022-02-01"))
    cv_test_5  <- train %>% dplyr::filter(date >= as.Date("2022-02-01") & date < as.Date("2022-06-01"))

    y_cv_5    <- ts(cv_train_5$food_cpi, frequency = 12)
    y_test_5  <- cv_test_5$food_cpi
    xreg_cv_5 <- as.matrix(cv_train_5[, xreg_cols])
    xreg_te_5 <- as.matrix(cv_test_5[, xreg_cols])

    base_fc_5       <- as.numeric(forecast(auto.arima(y_cv_5, seasonal = FALSE), h = nrow(cv_test_5))$mean)
    base_mape_5     <- mean(abs((y_test_5 - base_fc_5) / y_test_5)) * 100

    model_cv_fit_5  <- auto.arima(y_cv_5, xreg = xreg_cv_5, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_5      <- as.numeric(forecast(model_cv_fit_5, xreg = xreg_te_5, h = nrow(cv_test_5))$mean)
    model_mape_5    <- mean(abs((y_test_5 - model_fc_5) / y_test_5)) * 100

    # ---- FOLD 6: train to May 2022, test Jun 2022 – Sep 2022 ----

    cv_train_6 <- train %>% dplyr::filter(date < as.Date("2022-06-01"))
    cv_test_6  <- train %>% dplyr::filter(date >= as.Date("2022-06-01") & date < as.Date("2022-10-01"))

    y_cv_6    <- ts(cv_train_6$food_cpi, frequency = 12)
    y_test_6  <- cv_test_6$food_cpi
    xreg_cv_6 <- as.matrix(cv_train_6[, xreg_cols])
    xreg_te_6 <- as.matrix(cv_test_6[, xreg_cols])

    base_fc_6       <- as.numeric(forecast(auto.arima(y_cv_6, seasonal = FALSE), h = nrow(cv_test_6))$mean)
    base_mape_6     <- mean(abs((y_test_6 - base_fc_6) / y_test_6)) * 100

    model_cv_fit_6  <- auto.arima(y_cv_6, xreg = xreg_cv_6, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_6      <- as.numeric(forecast(model_cv_fit_6, xreg = xreg_te_6, h = nrow(cv_test_6))$mean)
    model_mape_6    <- mean(abs((y_test_6 - model_fc_6) / y_test_6)) * 100

    # ---- FOLD 7: train to Sep 2022, test Oct 2022 – Jan 2023 ----

    cv_train_7 <- train %>% dplyr::filter(date < as.Date("2022-10-01"))
    cv_test_7  <- train %>% dplyr::filter(date >= as.Date("2022-10-01") & date < as.Date("2023-02-01"))

    y_cv_7    <- ts(cv_train_7$food_cpi, frequency = 12)
    y_test_7  <- cv_test_7$food_cpi
    xreg_cv_7 <- as.matrix(cv_train_7[, xreg_cols])
    xreg_te_7 <- as.matrix(cv_test_7[, xreg_cols])

    base_fc_7       <- as.numeric(forecast(auto.arima(y_cv_7, seasonal = FALSE), h = nrow(cv_test_7))$mean)
    base_mape_7     <- mean(abs((y_test_7 - base_fc_7) / y_test_7)) * 100

    model_cv_fit_7  <- auto.arima(y_cv_7, xreg = xreg_cv_7, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_7      <- as.numeric(forecast(model_cv_fit_7, xreg = xreg_te_7, h = nrow(cv_test_7))$mean)
    model_mape_7    <- mean(abs((y_test_7 - model_fc_7) / y_test_7)) * 100

    # ---- FOLD 8: train to Jan 2023, test Feb 2023 – May 2023 ----

    cv_train_8 <- train %>% dplyr::filter(date < as.Date("2023-02-01"))
    cv_test_8  <- train %>% dplyr::filter(date >= as.Date("2023-02-01") & date < as.Date("2023-06-01"))

    y_cv_8    <- ts(cv_train_8$food_cpi, frequency = 12)
    y_test_8  <- cv_test_8$food_cpi
    xreg_cv_8 <- as.matrix(cv_train_8[, xreg_cols])
    xreg_te_8 <- as.matrix(cv_test_8[, xreg_cols])

    base_fc_8       <- as.numeric(forecast(auto.arima(y_cv_8, seasonal = FALSE), h = nrow(cv_test_8))$mean)
    base_mape_8     <- mean(abs((y_test_8 - base_fc_8) / y_test_8)) * 100

    model_cv_fit_8  <- auto.arima(y_cv_8, xreg = xreg_cv_8, seasonal = FALSE, stepwise = FALSE, approximation = FALSE)
    model_fc_8      <- as.numeric(forecast(model_cv_fit_8, xreg = xreg_te_8, h = nrow(cv_test_8))$mean)
    model_mape_8    <- mean(abs((y_test_8 - model_fc_8) / y_test_8)) * 100

    # ---- CV SUMMARY ----

    base_mapes  <- c(base_mape_1, base_mape_2, base_mape_3, base_mape_4,
                      base_mape_5, base_mape_6, base_mape_7, base_mape_8)
    model_mapes <- c(model_mape_1, model_mape_2, model_mape_3, model_mape_4,
                      model_mape_5, model_mape_6, model_mape_7, model_mape_8)

    base_cv_mean   <- mean(base_mapes)
    model_cv_mean  <- mean(model_mapes)
    cv_improvement <- round((base_cv_mean - model_cv_mean) / base_cv_mean * 100, 1)

    # --- aic improvement ---

    aic_improvement_pct <- round((base_aic - model_aic) / abs(base_aic) * 100, 1)

    # ============================================================
    # COUNTERFACTUAL
    # ============================================================

    actuals  <- intv$food_cpi
    x_post   <- as.matrix(intv[, xreg_cols])
    n_int    <- nrow(intv)
    sigma2   <- fit$sigma2
    coef_hat <- coef(fit)
    vcov_mat <- fit$var.coef

    sim_paths <- matrix(NA, nrow = N_SIMS, ncol = n_int)
    for (sim in 1:N_SIMS) {
        coef_draw     <- MASS::mvrnorm(n = 1, mu = coef_hat, Sigma = vcov_mat)
        fit_star      <- fit
        fit_star$coef <- coef_draw
        sim_paths[sim, ] <- tryCatch(
            as.numeric(simulate(fit_star, nsim = n_int, xreg = x_post, future = TRUE)),
            error = function(e) {
                as.numeric(forecast(fit_star, xreg = x_post, h = n_int)$mean) +
                    rnorm(n_int, 0, sqrt(sigma2))
            })
    }

    mean_diffs <- apply(sim_paths, 1, function(row) mean(actuals - row))
    est <- mean(mean_diffs)
    ci  <- quantile(mean_diffs, c(0.025, 0.975))

    # ============================================================
    # RETURN
    # ============================================================

    sig_label <- ifelse(ci[1] > 0 | ci[2] < 0, "Yes", "No")

    table1 <- data.frame(
        province                = province_name,
        estimated_effect        = round(est, 2),
        ci_lower                = round(ci[1], 2),
        ci_upper                = round(ci[2], 2),
        statistically_significant = sig_label
    )

    table2 <- data.frame(
        province                     = province_name,
        forecast_improvement_pct     = cv_improvement,
        model_fit_improvement_pct    = aic_improvement_pct,
        diagnostics_passed           = paste0(model_diag, "/4"),
        controls_jointly_significant = joint_sig
    )

    plot_data <- list(
        prov_df    = df,
        train      = train,
        intv       = intv,
        fitted_pre = as.numeric(fitted(fit)),
        cf_mean    = colMeans(sim_paths),
        cf_lower   = apply(sim_paths, 2, quantile, 0.025),
        cf_upper   = apply(sim_paths, 2, quantile, 0.975),
        effect     = data.frame(estimate = est, ci_lower = ci[1],
                                ci_upper = ci[2])
    )

    return(list(table1 = table1, table2 = table2, plot_data = plot_data))
}

