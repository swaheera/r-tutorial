    plot_df$fitted_solid  <- NA_real_
    plot_df$fitted_dotted <- NA_real_
    plot_df$cf_lower      <- NA_real_
    plot_df$cf_upper      <- NA_real_

    for (i in seq_along(pre$date)) {
        idx <- which(plot_df$date == pre$date[i])
        if (length(idx) > 0 && i <= length(pd$fitted_pre) && !is.na(pd$fitted_pre[i]))
            plot_df$fitted_solid[idx] <- pd$fitted_pre[i]
    }
    for (i in seq_along(intv$date)) {
        idx <- which(plot_df$date == intv$date[i])
        if (length(idx) > 0) {
            if (i == 1) {
                lf <- max(which(!is.na(plot_df$fitted_solid)))
                if (length(lf) > 0) plot_df$fitted_solid[idx] <- pd$cf_mean[1]
            }
            plot_df$fitted_dotted[idx] <- pd$cf_mean[i]
            plot_df$cf_lower[idx]      <- pd$cf_lower[i]
            plot_df$cf_upper[idx]      <- pd$cf_upper[i]
        }
    }

    title_txt <- paste0(
        "Counterfactual Analysis for ", prov,
        ": Estimating the Grocery Rebate's\nAssociation with Food Prices ",
        "Using a Statistical Model with Lagged Indicators")

    sub_txt <- paste0(
        "A statistical model was fit on pre-rebate Food CPI using lagged US imports (2-mo), ",
        "lagged US core CPI (2- and 4-mo), lagged USD/CAD (2-mo),\n",
        "and seasonal controls (",
        format(min(pre$date), "%b %Y"), " \u2013 ",
        format(max(pre$date), "%b %Y"),
        "), assuming that pre-rebate dynamics would have continued after.\n",
        "The ", N_FORECAST_MONTHS, "-month period average effect is ",
        sprintf("%+.2f", eff$estimate), " index points ",
        "[95% PI: ", sprintf("%.2f", eff$ci_lower), ", ",
        sprintf("%.2f", eff$ci_upper), "]")

    # x-axis: Jan 2023, Jul 2023 (intervention), Dec 2023 (end)
    x_breaks <- c(as.Date("2023-01-01"), INTERVENTION_START, INTERVENTION_END)
    x_labels <- c("Jan\n2023", "Jul\n2023", "Dec\n2023")

    ym <- mean(range(plot_df$food_cpi, na.rm = TRUE))

    p <- ggplot(plot_df, aes(x = date)) +
        geom_ribbon(aes(ymin = cf_lower, ymax = cf_upper,
                        fill = "95% Prediction Interval"),
                    alpha = 0.4, na.rm = TRUE) +
        geom_line(aes(y = food_cpi, color = "Actual Food CPI"),
                  linewidth = 0.7) +
        geom_line(aes(y = fitted_solid, color = "Fitted Model"),
                  linewidth = 0.8, na.rm = TRUE) +
        geom_line(aes(y = fitted_dotted, color = "Counterfactual (No Rebate)"),
                  linetype = "dotted", linewidth = 1, na.rm = TRUE) +
        geom_vline(xintercept = INTERVENTION_START, linetype = "dotted",
                   color = "darkgreen", linewidth = 0.8) +
        geom_vline(xintercept = INTERVENTION_END, linetype = "dotted",
                   color = "darkgreen", linewidth = 0.8) +
        geom_segment(aes(x = PLOT_START_DATE, xend = PLOT_START_DATE + 1,
                         y = ym, yend = ym,
                         linetype = "2023 Grocery Rebate"),
                     color = "darkgreen", linewidth = 0.8, alpha = 0) +
        scale_color_manual(
            name   = "",
            values = c("Actual Food CPI"            = "black",
                       "Fitted Model"               = "red",
                       "Counterfactual (No Rebate)" = "red"),
            guide  = guide_legend(order = 1,
                                  override.aes = list(
                                      linetype  = c("solid", "solid", "dotted"),
                                      linewidth = c(0.7, 0.8, 1)))) +
        scale_fill_manual(
            name   = "",
            values = c("95% Prediction Interval" = "lightpink"),
            guide  = guide_legend(order = 2)) +
        scale_linetype_manual(
            name   = "",
            values = c("2023 Grocery Rebate" = "dotted"),
            guide  = guide_legend(order = 3,
                                  override.aes = list(
                                      color = "darkgreen", linewidth = 0.8, alpha = 1))) +
        scale_x_date(breaks = x_breaks, labels = x_labels,
                     limits = c(PLOT_START_DATE, PLOT_END_DATE)) +
        labs(title    = title_txt,
             subtitle = sub_txt,
             x = "", y = "Food CPI",
             caption  = DATA_SOURCE) +
        theme_minimal() +
        theme(plot.title    = element_text(face = "bold", size = 12),
              plot.subtitle = element_text(size = 8, color = "gray30"),
              plot.caption  = element_text(hjust = 0, size = 8),
              legend.position = "bottom",
              legend.box      = "horizontal",
              legend.text     = element_text(size = 8))

    print(p)
}

