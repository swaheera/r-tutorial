library(ggplot2)
library(gridExtra)
library(grid)
library(lubridate)

INTERVENTION_START <- as.Date("2023-07-01")
N_FORECAST_MONTHS  <- 6
INTERVENTION_END   <- INTERVENTION_START %m+% months(N_FORECAST_MONTHS - 1)
PLOT_START_DATE    <- as.Date("2023-01-01")
PLOT_END_DATE      <- INTERVENTION_END
INTERVENTION_LABEL <- paste0(format(INTERVENTION_START, "%B %Y"), " \u2013 ",
                             format(INTERVENTION_END, "%B %Y"))
DATA_SOURCE <- "Statistics Canada (2026)\nhttps://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1810000401"

# ============================================================
# BUILD PANELS
# ============================================================

province_plots <- list()

for (prov in names(all_plot_data)) {

    pd   <- all_plot_data[[prov]]
    pre  <- pd$train
    intv <- pd$intv
    eff  <- pd$effect

    plot_df <- pd$prov_df %>%
        dplyr::filter(date >= PLOT_START_DATE & date <= PLOT_END_DATE)
    plot_df$fitted_solid  <- NA_real_
    plot_df$fitted_dotted <- NA_real_
    plot_df$cf_lower      <- NA_real_
    plot_df$cf_upper      <- NA_real_

    for (i in seq_along(pre$date)) {
        idx <- which(plot_df$date == pre$date[i])
        if (length(idx) > 0 && i <= length(pd$fitted_pre) && !is.na(pd$fitted_pre[i]))
            plot_df$fitted_solid[idx] <- pd$fitted_pre[i]
    }
    for (i in seq_along(intv$date)) {
        idx <- which(plot_df$date == intv$date[i])
        if (length(idx) > 0) {
            if (i == 1) {
                lf <- max(which(!is.na(plot_df$fitted_solid)))
                if (length(lf) > 0) plot_df$fitted_solid[idx] <- pd$cf_mean[1]
            }
            plot_df$fitted_dotted[idx] <- pd$cf_mean[i]
            plot_df$cf_lower[idx]      <- pd$cf_lower[i]
            plot_df$cf_upper[idx]      <- pd$cf_upper[i]
        }
    }

    panel_title <- gsub(",.*", "", prov)

    panel_subtitle <- paste0(
        "Avg. Effect: ", sprintf("%+.1f", eff$estimate), " pts | ",
        "95% PI [", sprintf("%.1f", eff$ci_lower), ", ",
        sprintf("%.1f", eff$ci_upper), "]"
    )

    x_breaks <- c(as.Date("2023-01-01"), INTERVENTION_START, INTERVENTION_END)
    x_labels <- c("Jan\n2023", "Jul\n2023", "Dec\n2023")

    p <- ggplot(plot_df, aes(x = date)) +
        geom_ribbon(aes(ymin = cf_lower, ymax = cf_upper),
                    fill = "lightpink", alpha = 0.4, na.rm = TRUE) +
        geom_line(aes(y = food_cpi), color = "black", linewidth = 0.3) +
        geom_line(aes(y = fitted_solid), color = "red", linewidth = 0.3, na.rm = TRUE) +
        geom_line(aes(y = fitted_dotted), color = "red",
                  linetype = "dotted", linewidth = 0.5, na.rm = TRUE) +
        geom_vline(xintercept = INTERVENTION_START, linetype = "dotted",
                   color = "darkgreen", linewidth = 0.4) +
        geom_vline(xintercept = INTERVENTION_END, linetype = "dotted",
                   color = "darkgreen", linewidth = 0.4) +
        scale_x_date(breaks = x_breaks, labels = x_labels,
                     limits = c(PLOT_START_DATE, PLOT_END_DATE)) +
        labs(title = panel_title, subtitle = panel_subtitle, x = NULL, y = NULL) +
        theme_minimal(base_size = 8) +
        theme(
            plot.title       = element_text(face = "bold", size = 9, hjust = 0.5),
            plot.subtitle    = element_text(size = 7, hjust = 0.5, color = "gray40"),
            axis.text.x      = element_text(size = 7),
            axis.text.y      = element_text(size = 7),
            axis.ticks       = element_line(linewidth = 0.3),
            panel.grid.minor = element_blank(),
            panel.grid.major = element_line(linewidth = 0.2),
            plot.margin      = margin(3, 5, 3, 5)
        )

    province_plots[[prov]] <- p
}

