# ============================================================
# Build gt Table
# ============================================================

gt_sources <- sources %>%
    mutate(
        Source = paste0(
            "<a href='", Link, "' target='_blank' style='color:#2A6496; text-decoration:none;'>",
            Source, "</a>"
        )
    ) %>%
    select(-Link) %>%
    gt() %>%
    
    # ── Header ──
    tab_header(
        title    = md("**Data Sources: Determinants of Canadian Food CPI**"),
        subtitle = md("*Panel dataset \u2014 10 provinces + Canada aggregate (11 geographies), January 2017 onward*")
    ) %>%
    
    # ── Column Labels ──
    cols_label(
        Variable    = md("**Variable**"),
        Source      = md("**Source**"),
        Description = md("**Description**"),
        Geography   = md("**Geography**"),
        Role        = md("**Role**"),
        Units       = md("**Units**"),
        Frequency   = md("**Frequency**"),
        Rationale   = md("**Rationale**")
    ) %>%
    
    # ── Column Widths ──
    cols_width(
        Variable    ~ px(140),
        Source      ~ px(145),
        Description ~ px(250),
        Geography   ~ px(95),
        Role        ~ px(68),
        Units       ~ px(85),
        Frequency   ~ px(95),
        Rationale   ~ px(230)
    ) %>%
    
    # ── Render HTML in Source & Description ──
    fmt_markdown(columns = c(Source, Description)) %>%
    
    # ── Column Header Styling (dark navy, white text) ──
    tab_style(
        style = list(
            cell_fill(color = "#1B3A5C"),
            cell_text(color = "white", weight = "bold", size = px(11))
        ),
        locations = cells_column_labels()
    ) %>%
    
    # ── Title Styling ──
    tab_style(
        style = cell_text(size = px(16), weight = "bold"),
        locations = cells_title(groups = "title")
    ) %>%
    tab_style(
        style = cell_text(size = px(11), color = "grey40"),
        locations = cells_title(groups = "subtitle")
    ) %>%
    
    # ── Body Text ──
    tab_style(
        style = cell_text(size = px(10.5)),
        locations = cells_body()
    ) %>%
    
    # ── Variable name column: bold ──
    tab_style(
        style = cell_text(weight = "bold", size = px(10.5)),
        locations = cells_body(columns = Variable)
