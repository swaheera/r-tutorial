cat("##############################################\n")
cat("# PART 2: INDIVIDUAL CHECKS                  #\n")
cat("##############################################\n\n")

# ----- CHECK 1: pop_lag1, scenario +1% -----

cat("--- CHECK 1: pop_lag1, scenario +1% ---\n\n")

df1 <- mydf %>%
  arrange(date) %>%
  mutate(pop_lag1 = dplyr::lag(population, 1))

train1 <- df1 %>%
  filter(date >= "2020-04-01" & date <= "2022-03-31") %>%
  filter(!is.na(pop_lag1))

test1 <- df1 %>%
  filter(date >= "2022-04-01" & date <= "2023-03-31") %>%
  filter(!is.na(pop_lag1))

cat("Train rows:", nrow(train1), "| Test rows:", nrow(test1), "\n")

scenario_pct_1 <- 1
n_test_1 <- nrow(test1)
growth_factors_1 <- 1 + (scenario_pct_1 / 100) * (0:(n_test_1 - 1)) / (n_test_1 - 1)

xreg_train_1 <- as.matrix(train1[, "pop_lag1", drop = FALSE])
xreg_test_1  <- as.matrix(test1$pop_lag1[1] * growth_factors_1)
colnames(xreg_test_1) <- "pop_lag1"

model1 <- auto.arima(train1$apple_sales, xreg = xreg_train_1)
fc1    <- forecast(model1, xreg = xreg_test_1)

check1_total_forecast <- sum(as.numeric(fc1$mean))
check1_total_real     <- sum(test1$apple_sales)
check1_year_mape      <- (check1_total_forecast - check1_total_real) / check1_total_real

cat("Total real:    ", check1_total_real, "\n")
cat("Total forecast:", check1_total_forecast, "\n")
cat("Year MAPE:     ", check1_year_mape, "\n\n")


# ----- CHECK 2: pop_lag1+pop_lag2+pop_lag3, scenario +1% -----

cat("--- CHECK 2: pop_lag1+pop_lag2+pop_lag3, scenario +1% ---\n\n")

df2 <- mydf %>%
  arrange(date) %>%
  mutate(
    pop_lag1 = dplyr::lag(population, 1),
    pop_lag2 = dplyr::lag(population, 2),
    pop_lag3 = dplyr::lag(population, 3)
  )

train2 <- df2 %>%
  filter(date >= "2020-04-01" & date <= "2022-03-31") %>%
  filter(!is.na(pop_lag1) & !is.na(pop_lag2) & !is.na(pop_lag3))

test2 <- df2 %>%
  filter(date >= "2022-04-01" & date <= "2023-03-31") %>%
  filter(!is.na(pop_lag1) & !is.na(pop_lag2) & !is.na(pop_lag3))

cat("Train rows:", nrow(train2), "| Test rows:", nrow(test2), "\n")

scenario_pct_2 <- 1
n_test_2 <- nrow(test2)
growth_factors_2 <- 1 + (scenario_pct_2 / 100) * (0:(n_test_2 - 1)) / (n_test_2 - 1)

lag_cols_2 <- c("pop_lag1", "pop_lag2", "pop_lag3")

xreg_train_2 <- as.matrix(train2[, lag_cols_2, drop = FALSE])

xreg_test_base_2 <- as.numeric(test2[1, lag_cols_2])
xreg_test_2 <- matrix(NA, nrow = n_test_2, ncol = 3)
colnames(xreg_test_2) <- lag_cols_2
for (j in 1:3) {
  xreg_test_2[, j] <- xreg_test_base_2[j] * growth_factors_2
}

model2 <- auto.arima(train2$apple_sales, xreg = xreg_train_2)
fc2    <- forecast(model2, xreg = xreg_test_2)

check2_total_forecast <- sum(as.numeric(fc2$mean))
check2_total_real     <- sum(test2$apple_sales)
check2_year_mape      <- (check2_total_forecast - check2_total_real) / check2_total_real

cat("Total real:    ", check2_total_real, "\n")
cat("Total forecast:", check2_total_forecast, "\n")
cat("Year MAPE:     ", check2_year_mape, "\n\n")


# =============================================================================
# PART 3: COMPARISON
# =============================================================================

cat("##############################################\n")
cat("# PART 3: COMPARISON                         #\n")
cat("##############################################\n\n")

bulk1 <- results_df %>%
  filter(model == "pop_lag1",
         training_period == "2020-04-01 to 2022-03-31",
         testing_period  == "2022-04-01 to 2023-03-31",
         scenario == 1)

cat("--- CHECK 1: pop_lag1 ---\n")
cat("Bulk:       total_forecast =", bulk1$total_forecast, " year_mape =", bulk1$year_mape, "\n")
cat("Individual: total_forecast =", check1_total_forecast, " year_mape =", check1_year_mape, "\n")
cat("Match:", all.equal(bulk1$total_forecast, check1_total_forecast, tolerance = 1e-6), "\n\n")

bulk2 <- results_df %>%
  filter(model == "pop_lag1+pop_lag2+pop_lag3",
         training_period == "2020-04-01 to 2022-03-31",
         testing_period  == "2022-04-01 to 2023-03-31",
         scenario == 1)

cat("--- CHECK 2: pop_lag1+pop_lag2+pop_lag3 ---\n")
cat("Bulk:       total_forecast =", bulk2$total_forecast, " year_mape =", bulk2$year_mape, "\n")
cat("Individual: total_forecast =", check2_total_forecast, " year_mape =", check2_year_mape, "\n")
cat("Match:", all.equal(bulk2$total_forecast, check2_total_forecast, tolerance = 1e-6), "\n\n")

cat("Done!\n")
