library(dplyr)
library(forecast)

# =============================================================================
# DATA SETUP
# =============================================================================

set.seed(42)
dates <- seq.Date(from = as.Date("2020-04-01"), by = "month", length.out = 67)
population <- cumsum(rnorm(67, mean = 0.5, sd = 1)) + 100
apple_sales <- 500 + 2 * population + rnorm(67, sd = 10)

mydf <- data.frame(
  date = dates,
  apple_sales = apple_sales,
  population = population
)

# =============================================================================
# PART 1: BULK VERSION (all models x all windows x all scenarios)
# =============================================================================

cat("##############################################\n")
cat("# PART 1: BULK VERSION                       #\n")
cat("##############################################\n\n")

fit_single_window <- function(df,
                              train_start,
                              train_end,
                              test_start,
                              test_end,
                              target_col = "apple_sales",
                              pop_col = "population",
                              n_lags = 4,
                              scenario_min = -3,
                              scenario_max = 3,
                              scenario_step = 0.5) {

  training_period <- paste(train_start, "to", train_end)
  testing_period  <- paste(test_start, "to", test_end)

  df <- df %>% arrange(date)
  for (i in 1:n_lags) {
    col_name <- paste0("pop_lag", i)
    df <- df %>% mutate(!!col_name := dplyr::lag(.data[[pop_col]], i))
  }

  lag_cols  <- paste0("pop_lag", 1:n_lags)
  scenarios <- seq(scenario_min, scenario_max, by = scenario_step)

  # Pre-filter by date only — complete.cases happens per model inside
  train_df_all <- df %>%
    filter(date >= as.Date(train_start) & date <= as.Date(train_end))

  test_df_all <- df %>%
    filter(date >= as.Date(test_start) & date <= as.Date(test_end))

  cat("Window:", training_period, "->", testing_period, "\n")

  all_combos <- lapply(1:n_lags, function(k) combn(lag_cols, k, simplify = FALSE))
  all_combos <- unlist(all_combos, recursive = FALSE)
  n_models   <- length(all_combos)

  fit_single_model <- function(model_idx, xreg_cols) {

    model_name <- paste(xreg_cols, collapse = "+")

    # Filter complete.cases only on THIS model's columns
    train_df <- train_df_all %>%
      filter(complete.cases(pick(all_of(xreg_cols))))

    test_df <- test_df_all %>%
      filter(complete.cases(pick(all_of(xreg_cols))))

    n_train <- nrow(train_df)
    n_test  <- nrow(test_df)

    if (n_train < 10 || n_test < 1) return(NULL)

    test_pop <- test_df[[pop_col]]
    true_scenario <- ((test_pop[n_test] - test_pop[1]) / test_pop[1]) * 100
    total_real <- sum(test_df[[target_col]])

    xreg_train <- as.matrix(train_df[, xreg_cols, drop = FALSE])

    arima_model <- tryCatch({
      auto.arima(train_df[[target_col]], xreg = xreg_train)
    }, error = function(e) NULL)

    if (is.null(arima_model)) return(NULL)

    coefs <- coef(arima_model)
    xreg_coefs <- coefs[names(coefs) %in% xreg_cols]
    if (length(xreg_coefs) == 0) return(NULL)

    all_positive <- all(xreg_coefs > 0)
    total_forecasts <- rep(NA_real_, length(scenarios))
    scenario_dfs <- list()

    for (s_idx in seq_along(scenarios)) {

      scenario_pct <- scenarios[s_idx]
      xreg_test_base <- as.numeric(test_df[1, xreg_cols])

      if (n_test == 1) {
        growth_factors <- 1 + scenario_pct / 100
      } else {
        growth_factors <- 1 + (scenario_pct / 100) * (0:(n_test - 1)) / (n_test - 1)
      }

      xreg_test_scenario <- matrix(NA, nrow = n_test, ncol = length(xreg_cols))
      colnames(xreg_test_scenario) <- xreg_cols
      for (j in seq_along(xreg_cols)) {
        xreg_test_scenario[, j] <- xreg_test_base[j] * growth_factors
      }

      fc <- tryCatch({
        forecast(arima_model, xreg = xreg_test_scenario)
      }, error = function(e) NULL)

      if (is.null(fc)) next

      test_forecast <- as.numeric(fc$mean)
      test_actual   <- test_df[[target_col]]
      test_dates    <- test_df$date

      total_forecasts[s_idx] <- sum(test_forecast)

      monthly_ape      <- abs((test_actual - test_forecast) / test_actual) * 100
      avg_monthly_mape <- mean(monthly_ape, na.rm = TRUE)
      total_year_mape  <- abs((sum(test_forecast) - total_real) / total_real) * 100

      scenario_dfs[[s_idx]] <- data.frame(
        model             = model_name,
        n_lags_used       = length(xreg_cols),
        scenario          = scenario_pct,
        true_scenario     = true_scenario,
        scenario_diff     = abs(true_scenario - scenario_pct),
        month             = test_dates,
        real              = test_actual,
        forecast          = test_forecast,
        total_real        = total_real,
        total_forecast    = sum(test_forecast),
        avg_monthly_mape  = avg_monthly_mape,
        total_year_mape   = total_year_mape,
        all_coef_positive = all_positive,
        training_period   = training_period,
        testing_period    = testing_period,
        stringsAsFactors  = FALSE
      )
    }

    scenario_dfs <- Filter(Negate(is.null), scenario_dfs)
    if (length(scenario_dfs) == 0) return(NULL)

    model_df <- do.call(rbind, scenario_dfs)

    valid_forecasts <- total_forecasts[!is.na(total_forecasts)]
    is_monotonic <- length(valid_forecasts) > 1 && all(diff(valid_forecasts) > 0)
    model_df$monotonic <- ifelse(is_monotonic, "yes", "no")

    return(model_df)
  }

  all_results <- list()
  for (i in seq_along(all_combos)) {
    res <- fit_single_model(i, all_combos[[i]])
    if (!is.null(res)) {
      all_results[[length(all_results) + 1]] <- res
    }
  }

  if (length(all_results) == 0) return(NULL)
  do.call(rbind, all_results)
}

windows <- list(
  list(train_start = "2020-04-01", train_end = "2021-03-31",
       test_start  = "2021-04-01", test_end  = "2022-03-31"),
  list(train_start = "2020-04-01", train_end = "2022-03-31",
       test_start  = "2022-04-01", test_end  = "2023-03-31"),
  list(train_start = "2020-04-01", train_end = "2023-03-31",
       test_start  = "2023-04-01", test_end  = "2024-03-31"),
  list(train_start = "2020-04-01", train_end = "2024-03-31",
       test_start  = "2024-04-01", test_end  = "2025-03-31"),
  list(train_start = "2020-04-01", train_end = "2025-03-31",
       test_start  = "2025-04-01", test_end  = "2025-10-01")
)

results_list <- list()
for (w in windows) {
  res <- fit_single_window(
    df          = mydf,
    train_start = w$train_start,
    train_end   = w$train_end,
    test_start  = w$test_start,
    test_end    = w$test_end,
    n_lags      = 4,
    scenario_min  = -3,
    scenario_max  = 3,
    scenario_step = 0.5
  )
  if (!is.null(res)) {
    results_list[[length(results_list) + 1]] <- res
  }
}

if (length(results_list) == 0) stop("No results from bulk run\n")

results_df <- do.call(rbind, results_list)

cat("\nBulk run complete. Total rows:", nrow(results_df), "\n")
cat("Unique models:", length(unique(results_df$model)), "\n\n")


# =============================================================================
# PART 2: INDIVIDUAL CHECKS (plain, no helper functions)
# =============================================================================

cat("##############################################\n")
cat("# PART 2: INDIVIDUAL CHECKS                  #\n")
cat("##############################################\n\n")

# ----- CHECK 1: pop_lag1, train 2020-04 to 2022-03, test 2022-04 to 2023-03, scenario +1% -----

cat("--- CHECK 1: pop_lag1, scenario +1% ---\n\n")

# Create lag
df1 <- mydf %>%
  arrange(date) %>%
  mutate(pop_lag1 = dplyr::lag(population, 1))

# Split and drop NAs on pop_lag1
train1 <- df1 %>%
  filter(date >= "2020-04-01" & date <= "2022-03-31") %>%
  filter(!is.na(pop_lag1))

test1 <- df1 %>%
  filter(date >= "2022-04-01" & date <= "2023-03-31") %>%
  filter(!is.na(pop_lag1))

cat("Train rows:", nrow(train1), "| Test rows:", nrow(test1), "\n")

# Build scenario xreg: +1% growth
scenario_pct_1 <- 1
n_test_1 <- nrow(test1)
growth_factors_1 <- 1 + (scenario_pct_1 / 100) * (0:(n_test_1 - 1)) / (n_test_1 - 1)

xreg_train_1 <- as.matrix(train1[, "pop_lag1", drop = FALSE])
xreg_test_1  <- as.matrix(test1$pop_lag1[1] * growth_factors_1)
colnames(xreg_test_1) <- "pop_lag1"

# Fit and forecast
model1 <- auto.arima(train1$apple_sales, xreg = xreg_train_1)
fc1    <- forecast(model1, xreg = xreg_test_1)

check1_result <- data.frame(
  month    = test1$date,
  real     = test1$apple_sales,
  forecast = as.numeric(fc1$mean)
)

print(check1_result)
cat("Total real:    ", sum(check1_result$real), "\n")
cat("Total forecast:", sum(check1_result$forecast), "\n\n")


# ----- CHECK 2: pop_lag1+pop_lag2+pop_lag3, same window, scenario +1% -----

cat("--- CHECK 2: pop_lag1+pop_lag2+pop_lag3, scenario +1% ---\n\n")

# Create lags
df2 <- mydf %>%
  arrange(date) %>%
  mutate(
    pop_lag1 = dplyr::lag(population, 1),
    pop_lag2 = dplyr::lag(population, 2),
    pop_lag3 = dplyr::lag(population, 3)
  )

# Split and drop NAs on the 3 lag columns
train2 <- df2 %>%
  filter(date >= "2020-04-01" & date <= "2022-03-31") %>%
  filter(!is.na(pop_lag1) & !is.na(pop_lag2) & !is.na(pop_lag3))

test2 <- df2 %>%
  filter(date >= "2022-04-01" & date <= "2023-03-31") %>%
  filter(!is.na(pop_lag1) & !is.na(pop_lag2) & !is.na(pop_lag3))

cat("Train rows:", nrow(train2), "| Test rows:", nrow(test2), "\n")

# Build scenario xreg: +1% growth applied to all 3 lag columns
scenario_pct_2 <- 1
n_test_2 <- nrow(test2)
growth_factors_2 <- 1 + (scenario_pct_2 / 100) * (0:(n_test_2 - 1)) / (n_test_2 - 1)

lag_cols_2 <- c("pop_lag1", "pop_lag2", "pop_lag3")

xreg_train_2 <- as.matrix(train2[, lag_cols_2, drop = FALSE])

xreg_test_base_2 <- as.numeric(test2[1, lag_cols_2])
xreg_test_2 <- matrix(NA, nrow = n_test_2, ncol = 3)
colnames(xreg_test_2) <- lag_cols_2
for (j in 1:3) {
  xreg_test_2[, j] <- xreg_test_base_2[j] * growth_factors_2
}

# Fit and forecast
model2 <- auto.arima(train2$apple_sales, xreg = xreg_train_2)
fc2    <- forecast(model2, xreg = xreg_test_2)

check2_result <- data.frame(
  month    = test2$date,
  real     = test2$apple_sales,
  forecast = as.numeric(fc2$mean)
)

print(check2_result)
cat("Total real:    ", sum(check2_result$real), "\n")
cat("Total forecast:", sum(check2_result$forecast), "\n\n")


