match1 <- all.equal(bulk_slice_1$forecast, check1_result$forecast, tolerance = 1e-6)
cat("\nMatch:", match1, "\n\n")


# --- Check 2 vs bulk ---
cat("--- CHECK 2: pop_lag1+pop_lag2+pop_lag3 ---\n")

bulk_slice_2 <- results_df %>%
  filter(
    model           == "pop_lag1+pop_lag2+pop_lag3",
    training_period == "2020-04-01 to 2022-03-31",
    testing_period  == "2022-04-01 to 2023-03-31",
    scenario        == 1
  ) %>%
  select(month, real, forecast)

cat("Bulk:\n")
print(bulk_slice_2)
cat("\nIndividual:\n")
print(check2_result)

match2 <- all.equal(bulk_slice_2$forecast, check2_result$forecast, tolerance = 1e-6)
cat("\nMatch:", match2, "\n\n")

