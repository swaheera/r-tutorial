library(dplyr)
library(forecast)

# CONFIG
train_start  <- "2020-04-01"
train_end    <- "2023-03-31"
test_start   <- "2023-04-01"
test_end     <- "2024-03-31"
scenario_pct <- 1

# PREP — one df with all log columns and lag
df <- mydf %>%
  arrange(date) %>%
  mutate(log_total  = log(total),
         log_apples = log(apples),
         log_banana = log(banana),
         log_pop    = log(population),
         pop_lag1   = dplyr::lag(log_pop, 1))

train <- df %>% filter(date >= train_start & date <= train_end & !is.na(pop_lag1))
test  <- df %>% filter(date >= test_start  & date <= test_end  & !is.na(pop_lag1))

# SCENARIO XREG (same for all models)
n_test    <- nrow(test)
factors   <- log(1 + scenario_pct / 100) * (0:(n_test - 1)) / (n_test - 1)
xreg_train <- as.matrix(train$pop_lag1)
xreg_test  <- as.matrix(test$pop_lag1[1] + factors)

# --- TOTAL ---
model_total <- auto.arima(train$log_total, xreg = xreg_train)
fc_total    <- forecast(model_total, xreg = xreg_test)
real_total     <- sum(exp(test$log_total))
forecast_total <- sum(exp(as.numeric(fc_total$mean)))

# --- APPLES ---
model_apples <- auto.arima(train$log_apples, xreg = xreg_train)
fc_apples    <- forecast(model_apples, xreg = xreg_test)
real_apples     <- sum(exp(test$log_apples))
forecast_apples <- sum(exp(as.numeric(fc_apples$mean)))

# --- BANANA (direct) ---
model_banana <- auto.arima(train$log_banana, xreg = xreg_train)
fc_banana    <- forecast(model_banana, xreg = xreg_test)
real_banana     <- sum(exp(test$log_banana))
forecast_banana <- sum(exp(as.numeric(fc_banana$mean)))

# --- BANANA (residual: total - apples) ---
forecast_banana_residual <- forecast_total - forecast_apples

# MONTHLY vectors (back-transformed to original scale)
monthly_real_total    <- exp(test$log_total)
monthly_real_apples   <- exp(test$log_apples)
monthly_real_banana   <- exp(test$log_banana)

monthly_fc_total      <- exp(as.numeric(fc_total$mean))
monthly_fc_apples     <- exp(as.numeric(fc_apples$mean))
monthly_fc_banana     <- exp(as.numeric(fc_banana$mean))
monthly_fc_banana_res <- monthly_fc_total - monthly_fc_apples

avg_month_mape_signed <- c(
  mean((monthly_fc_total  - monthly_real_total)  / monthly_real_total),
  mean((monthly_fc_apples - monthly_real_apples) / monthly_real_apples),
  mean((monthly_fc_banana - monthly_real_banana) / monthly_real_banana),
  mean((monthly_fc_banana_res - monthly_real_banana) / monthly_real_banana)
)

avg_month_mape_abs <- c(
  mean(abs((monthly_fc_total  - monthly_real_total)  / monthly_real_total)),
  mean(abs((monthly_fc_apples - monthly_real_apples) / monthly_real_apples)),
  mean(abs((monthly_fc_banana - monthly_real_banana) / monthly_real_banana)),
  mean(abs((monthly_fc_banana_res - monthly_real_banana) / monthly_real_banana))
)

# TRUE POP GROWTH in test period (on original scale)
true_pop_growth <- ((test$population[n_test] - test$population[1]) / test$population[1]) * 100

# RESULTS
total_real_vec     <- c(real_total, real_apples, real_banana, real_banana)
total_forecast_vec <- c(forecast_total, forecast_apples, forecast_banana, forecast_banana_residual)

results <- data.frame(
  response            = c("total", "apples", "banana_method1", "banana_method2"),
  total_real          = total_real_vec,
  total_forecast      = total_forecast_vec,
  true_pop_growth     = true_pop_growth,
  scenario            = scenario_pct,
  year_mape_signed    = (total_forecast_vec - total_real_vec) / total_real_vec,
  year_mape_abs       = abs((total_forecast_vec - total_real_vec) / total_real_vec),
  avg_month_mape_signed = avg_month_mape_signed,
  avg_month_mape_abs    = avg_month_mape_abs,
  stringsAsFactors    = FALSE
)

print(results)
