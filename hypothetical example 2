      h+="<label class=\"it"+(fails.has(s.id)&&!placed.has(s.id)?" nofit":"")+"\"><input type=\"checkbox\" data-id=\""+s.id+"\""+(sel.has(s.id)?" checked":"")+">"+
        "<span><span class=\"m\">"+s.src+" · "+s.d+" · "+s.type.toLowerCase()+" · <a href=\""+s.url+"\" target=\"_blank\">open ↗</a></span>"+esc(s.h)+
        "<span class=\"nr\">No free space on the chart</span>"+(!onChart.has(s.id)?"<span class=\"pre\">Not on this view: year-over-year values start in "+yoyStart()+"</span>":"")+"</span></label>"});
