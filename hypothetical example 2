  function yRange(vals,pct){const lo=Math.min(...vals),hi=Math.max(...vals),sp=(hi-lo)||Math.abs(hi)||1;
    return pct?[lo-sp*0.18,hi+sp*0.8,hi]:[lo-sp*0.06,hi+sp*0.66,hi]}
  // ---- draw everything
  let lastFile="";
  function draw(){
    const pct=mode!=="pop",codes=[geo];
