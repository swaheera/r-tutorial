stories <- stories %>% mutate(date = as.Date(date), exact = as.logical(exact), id = row_number())

ordinal <- function(n) {
  suf <- ifelse(n %% 100 %in% 11:13, "th",
         c("th","st","nd","rd","th","th","th","th","th","th")[n %% 10 + 1])
  paste0(n, suf)
}
stories$date_txt <- ifelse(stories$exact,
  paste(format(stories$date, "%b"), ordinal(as.integer(format(stories$date, "%d"))), format(stories$date, "%Y")),
  format(stories$date, "%b %Y"))

fmt_day <- function(d) paste0(month.abb[as.integer(format(d, "%m"))], " ", as.integer(format(d, "%d")), ", ", format(d, "%Y"))
ms <- function(d) as.numeric(as.POSIXct(as.Date(d), tz = "UTC")) * 1000

# ---- Source filters shown in the page; `sources_on` are ticked when it opens
source_labels <- c("CBC News" = "CBC News", "Statistics Canada" = "Statistics Canada", "IRCC" = "IRCC")
sources_on <- c("CBC News")

# ---- Data handed to the page -------------------------------------------------------------
geo_order <- unname(codes)
G <- list(
  W = 1180, H = 900, x0 = ms("2019-01-01"), x1 = ms("2026-09-15"),
  release = fmt_day(release_date), made = fmt_day(Sys.Date()),
  pop_range = fmt_day(range(pop$date)), news_range = fmt_day(range(stories$date)),
  geos = lapply(geo_order, function(g) {
    p <- pop[pop$geo == g, ]
    list(code = g, name = names(codes)[codes == g], ms = ms(p$date), v = p$population)
  }),
  sources_on = as.list(sources_on),
  stories = lapply(seq_len(nrow(stories)), function(i) { s <- stories[i, ]
    list(id = s$id, geo = s$geo, src = s$source, type = s$type, ms = ms(s$date), d = s$date_txt,
         exact = s$exact, h = s$headline, url = s$url) })
)

# ---- Base chart (the page redraws it for each view) ---------------------------------------
fig <- plot_ly(width = G$W, height = G$H, type = "scatter", mode = "lines", x = numeric(0), y = numeric(0)) %>%
  layout(autosize = FALSE) %>% config(displaylogo = FALSE)

