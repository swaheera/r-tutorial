      layout["yaxis"+sfx]={domain:[0,1],anchor:"x"+sfx,range:[yr[0],yr[1]],tickformat:pct?".1%":(yr[2]>=1e6&&(yr[1]-yr[0])/yr[2]>0.06?".3s":",.0f"),
        gridcolor:"#e3e6e9",zeroline:pct,zerolinecolor:"#9aa1a8",fixedrange:true,
        title:{text:pct?"% change, year over year":"Population",font:{size:13,color:"#4a5058"}}};
      tickW[i]=Math.max(...[yr[0],yr[1]].map(v=>tw(pct?(v*100).toFixed(1)+"%":(yr[2]>=1e6&&(yr[1]-yr[0])/yr[2]>0.06?(v/1e6).toFixed(1)+"M":Math.round(v).toLocaleString("en-CA")),false)));
    });
