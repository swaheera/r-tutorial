    if(pct)head("How it's calculated: if the population is 1,000,000 on Jan 1, 2020 and 1,100,000 on Jan 1, 2021, the year-over-year change is (1,100,000 − 1,000,000) ÷ 1,000,000 = <b>+10%</b>.",14,R.ex,13,"#4a5058");
    let data=[];const res=[];const tickW=[0,0];
    // x ticks on the quarterly dates, always including the first and last date of the window
    const qs=Q.filter(t=>t>=w.r0&&t<=w.r1),maxT=Math.max(5,Math.floor(pw/62));
    let k=1;while(Math.ceil((qs.length-1)/k)+1>maxT)k=[1,2,4,8,12,16][[1,2,4,8,12,16].indexOf(k)+1]||k+4;
    const tv=[];for(let j=qs.length-1;j>=0;j-=k)tv.unshift(qs[j]);if(tv[0]!==qs[0]){if((tv[0]-qs[0])<k*0.5*91*864e5)tv.shift();tv.unshift(qs[0])}
