  }
  function renderList(res){
    const placed=new Set(),fails=new Set(),onChart=new Set();
    res.forEach(P=>{P.placedIds.forEach(i=>placed.add(i));P.fails.forEach(i=>{if(!placed.has(i))fails.add(i)});P.vis.forEach(o=>onChart.add(o.s.id))});
    const L=document.getElementById("list");let h="",yr="";
