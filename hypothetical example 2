  // ---- controls
  document.getElementById("d0").addEventListener("change",e=>{d0=e.target.value;draw()});
  document.getElementById("d1").addEventListener("change",e=>{d1=e.target.value;draw()});
  document.getElementById("b-dall").onclick=()=>{d0="";d1="";draw()};
