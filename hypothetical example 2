  document.querySelectorAll(".kind").forEach(c=>c.addEventListener("change",()=>{c.checked?kindOn.add(c.value):kindOn.delete(c.value);draw()}));
  // five random headlines, each from a different year, among the stories that can be shown now
  function pick5(){const v=visibleStories();v.forEach(s=>sel.delete(s.id));const by={};
