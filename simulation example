library(dplyr)
library(forecast)
library(MASS)

# CONFIG
train_start  <- "2020-04-01"
train_end    <- "2023-03-31"
test_start   <- "2023-04-01"
test_end     <- "2024-03-31"
scenario_pct <- 1
n_sim        <- 5000
alpha        <- 0.05

# PREP
df <- mydf %>%
    arrange(date) %>%
    mutate(log_total  = log(total),
           log_apples = log(apples),
           log_banana = log(banana),
           log_pop    = log(population),
           pop_lag1   = dplyr::lag(log_pop, 1))

train <- df %>% filter(date >= train_start & date <= train_end & !is.na(pop_lag1))
test  <- df %>% filter(date >= test_start  & date <= test_end  & !is.na(pop_lag1))

# SCENARIO XREG
n_test     <- nrow(test)
factors    <- log(1 + scenario_pct / 100) * (0:(n_test - 1)) / (n_test - 1)
xreg_train <- as.matrix(train$pop_lag1)
xreg_test  <- as.matrix(test$pop_lag1[1] + factors)

# FIT & FORECAST
model_total  <- auto.arima(train$log_total,  xreg = xreg_train)
model_apples <- auto.arima(train$log_apples, xreg = xreg_train)
model_banana <- auto.arima(train$log_banana, xreg = xreg_train)

fc_total  <- forecast(model_total,  xreg = xreg_test)
fc_apples <- forecast(model_apples, xreg = xreg_test)
fc_banana <- forecast(model_banana, xreg = xreg_test)

# ---------------------------------------------------------------------------
# SIMULATION FUNCTIONS
# ---------------------------------------------------------------------------

# Method 1: Simulation only (innovation uncertainty)
simulate_cumul_pi <- function(model, xreg_test, n_sim, alpha) {
    h <- nrow(xreg_test)
    sim_matrix <- matrix(NA, nrow = n_sim, ncol = h)
    for (i in seq_len(n_sim)) {
        sim_log <- simulate(model, nsim = h, xreg = xreg_test, future = TRUE)
        sim_matrix[i, ] <- exp(as.numeric(sim_log))
    }
    cumul_matrix <- t(apply(sim_matrix, 1, cumsum))
    lower <- apply(cumul_matrix, 2, quantile, probs = alpha / 2)
    upper <- apply(cumul_matrix, 2, quantile, probs = 1 - alpha / 2)
    list(lower = lower, upper = upper)
}

# Method 2: Simulation + parametric bootstrap (innovation + parameter uncertainty)
simulate_bootstrap_cumul_pi <- function(model, y_train, xreg_train, xreg_test, n_sim, alpha) {
    h <- nrow(xreg_test)
    coefs  <- coef(model)
    vcov_m <- vcov(model)
    sim_matrix <- matrix(NA, nrow = n_sim, ncol = h)

    for (i in seq_len(n_sim)) {
        new_coefs <- mvrnorm(1, mu = coefs, Sigma = vcov_m)
        boot_model <- tryCatch({
            Arima(y_train, order = arimaorder(model),
                  seasonal = model$arma[c(3, 7, 4)],
                  xreg = xreg_train, fixed = new_coefs,
                  method = "CSS")
        }, error = function(e) model)

        sim_log <- simulate(boot_model, nsim = h, xreg = xreg_test, future = TRUE)
        sim_matrix[i, ] <- exp(as.numeric(sim_log))
    }
    cumul_matrix <- t(apply(sim_matrix, 1, cumsum))
    lower <- apply(cumul_matrix, 2, quantile, probs = alpha / 2)
    upper <- apply(cumul_matrix, 2, quantile, probs = 1 - alpha / 2)
    list(lower = lower, upper = upper)
}

# Joint simulation for banana_method2 = total - apples (simulation only)
simulate_cumul_pi_residual <- function(model_total, model_apples, xreg_test, n_sim, alpha) {
    h <- nrow(xreg_test)
    sim_matrix <- matrix(NA, nrow = n_sim, ncol = h)
    for (i in seq_len(n_sim)) {
        sim_total  <- exp(as.numeric(simulate(model_total,  nsim = h, xreg = xreg_test, future = TRUE)))
        sim_apples <- exp(as.numeric(simulate(model_apples, nsim = h, xreg = xreg_test, future = TRUE)))
        sim_matrix[i, ] <- sim_total - sim_apples
    }
    cumul_matrix <- t(apply(sim_matrix, 1, cumsum))
    lower <- apply(cumul_matrix, 2, quantile, probs = alpha / 2)
    upper <- apply(cumul_matrix, 2, quantile, probs = 1 - alpha / 2)
    list(lower = lower, upper = upper)
}

# Joint simulation for banana_method2 = total - apples (simulation + bootstrap)
simulate_bootstrap_cumul_pi_residual <- function(model_total, model_apples,
                                                  y_train_total, y_train_apples,
                                                  xreg_train, xreg_test, n_sim, alpha) {
    h <- nrow(xreg_test)
    coefs_total  <- coef(model_total)
    vcov_total   <- vcov(model_total)
    coefs_apples <- coef(model_apples)
    vcov_apples  <- vcov(model_apples)
    sim_matrix   <- matrix(NA, nrow = n_sim, ncol = h)

    for (i in seq_len(n_sim)) {
        new_coefs_total <- mvrnorm(1, mu = coefs_total, Sigma = vcov_total)
        boot_total <- tryCatch({
            Arima(y_train_total, order = arimaorder(model_total),
                  seasonal = model_total$arma[c(3, 7, 4)],
                  xreg = xreg_train, fixed = new_coefs_total,
                  method = "CSS")
        }, error = function(e) model_total)

        new_coefs_apples <- mvrnorm(1, mu = coefs_apples, Sigma = vcov_apples)
        boot_apples <- tryCatch({
            Arima(y_train_apples, order = arimaorder(model_apples),
                  seasonal = model_apples$arma[c(3, 7, 4)],
                  xreg = xreg_train, fixed = new_coefs_apples,
                  method = "CSS")
        }, error = function(e) model_apples)

        sim_total  <- exp(as.numeric(simulate(boot_total,  nsim = h, xreg = xreg_test, future = TRUE)))
        sim_apples <- exp(as.numeric(simulate(boot_apples, nsim = h, xreg = xreg_test, future = TRUE)))
        sim_matrix[i, ] <- sim_total - sim_apples
    }
    cumul_matrix <- t(apply(sim_matrix, 1, cumsum))
    lower <- apply(cumul_matrix, 2, quantile, probs = alpha / 2)
    upper <- apply(cumul_matrix, 2, quantile, probs = 1 - alpha / 2)
    list(lower = lower, upper = upper)
}

# ---------------------------------------------------------------------------
# COMPUTE PIs
# ---------------------------------------------------------------------------

# Simulation only
pi_sim_total  <- simulate_cumul_pi(model_total,  xreg_test, n_sim, alpha)
pi_sim_apples <- simulate_cumul_pi(model_apples, xreg_test, n_sim, alpha)
pi_sim_banana <- simulate_cumul_pi(model_banana, xreg_test, n_sim, alpha)
pi_sim_banana_res <- simulate_cumul_pi_residual(model_total, model_apples, xreg_test, n_sim, alpha)

# Simulation + bootstrap
pi_boot_total  <- simulate_bootstrap_cumul_pi(model_total,  train$log_total,  xreg_train, xreg_test, n_sim, alpha)
pi_boot_apples <- simulate_bootstrap_cumul_pi(model_apples, train$log_apples, xreg_train, xreg_test, n_sim, alpha)
pi_boot_banana <- simulate_bootstrap_cumul_pi(model_banana, train$log_banana, xreg_train, xreg_test, n_sim, alpha)
pi_boot_banana_res <- simulate_bootstrap_cumul_pi_residual(
    model_total, model_apples,
    train$log_total, train$log_apples,
    xreg_train, xreg_test, n_sim, alpha
)

# MONTHLY BACK-TRANSFORMED VALUES
monthly_real_total    <- exp(test$log_total)
monthly_real_apples   <- exp(test$log_apples)
monthly_real_banana   <- exp(test$log_banana)

monthly_fc_total      <- exp(as.numeric(fc_total$mean))
monthly_fc_apples     <- exp(as.numeric(fc_apples$mean))
monthly_fc_banana     <- exp(as.numeric(fc_banana$mean))
monthly_fc_banana_res <- monthly_fc_total - monthly_fc_apples

# TRUE POP GROWTH
true_pop_growth <- ((test$population[n_test] - test$population[1]) / test$population[1]) * 100

# BUILD ONE MONTHLY ROW PER (date x response)
make_monthly <- function(response_name, real_vec, fc_vec, pi_sim, pi_boot) {
    data.frame(
        date                       = test$date,
        train_window_start         = train_start,
        train_window_end           = train_end,
        test_window_start          = test_start,
        test_window_end            = test_end,
        months_in_test             = seq_len(n_test),
        predictor                  = "pop_lag1",
        response                   = response_name,
        real                       = real_vec,
        forecast                   = fc_vec,
        cumul_real                 = cumsum(real_vec),
        cumul_forecast             = cumsum(fc_vec),
        cumul_lower_sim            = pi_sim$lower,
        cumul_upper_sim            = pi_sim$upper,
        cumul_lower_boot           = pi_boot$lower,
        cumul_upper_boot           = pi_boot$upper,
        true_pop_growth            = true_pop_growth,
        scenario                   = scenario_pct,
        mape_signed                = (fc_vec - real_vec) / real_vec,
        mape_abs                   = abs((fc_vec - real_vec) / real_vec),
        cumul_mape_signed          = (cumsum(fc_vec) - cumsum(real_vec)) / cumsum(real_vec),
        cumul_mape_abs             = abs((cumsum(fc_vec) - cumsum(real_vec)) / cumsum(real_vec)),
        stringsAsFactors           = FALSE
    )
}

results_part2 <- bind_rows(
    make_monthly("total",          monthly_real_total,  monthly_fc_total,      pi_sim_total,      pi_boot_total),
    make_monthly("apples",         monthly_real_apples, monthly_fc_apples,     pi_sim_apples,     pi_boot_apples),
    make_monthly("banana_method1", monthly_real_banana, monthly_fc_banana,     pi_sim_banana,     pi_boot_banana),
    make_monthly("banana_method2", monthly_real_banana, monthly_fc_banana_res, pi_sim_banana_res, pi_boot_banana_res)
)

print(results_part2)


