cat("Match forecasts:", all.equal(bulk1$forecast, check1_fc, tolerance = 1e-6), "\n")
cat("Match actuals:  ", all.equal(bulk1$actual, check1_act, tolerance = 1e-6), "\n\n")

bulk2 <- results_final %>%
  filter(response == "apple_sales", model == "pop_lag1",
         num_months_used_in_training == 48, scenario == 1,
         log_response == TRUE, log_predictors == FALSE)

cat("--- apple_sales, log_response=T, log_pred=F ---\n")
cat("Bulk forecasts: ", paste(round(bulk2$forecast, 2), collapse = ", "), "\n")
cat("Indiv forecasts:", paste(round(check2_fc, 2), collapse = ", "), "\n")
cat("Match forecasts:", all.equal(bulk2$forecast, check2_fc, tolerance = 1e-6), "\n")
cat("Match actuals:  ", all.equal(bulk2$actual, check2_act, tolerance = 1e-6), "\n\n")

bulk_bm2 <- results_final %>%
  filter(response == "banana_method2", model == "pop_lag1",
         num_months_used_in_training == 48, scenario == 1,
         log_response == FALSE, log_predictors == FALSE)

cat("--- banana_method2, no log ---\n")
cat("Match forecasts:", all.equal(bulk_bm2$forecast, bm2_fc, tolerance = 1e-6), "\n")
cat("Match actuals:  ", all.equal(bulk_bm2$actual, bm2_act, tolerance = 1e-6), "\n\n")

cat("Total runtime:", round(as.numeric(difftime(Sys.time(), global_start_time, units = "mins")), 1), "min\n")
cat("Done!\n")
