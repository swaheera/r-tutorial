const norm=s=>s.replace(/\s*\[[0-9, ]*\]\s*$/,"").trim().toLowerCase();

/* ---------- build display rows ---------- */
let DATA=[], HAS_GUIDE=false, DATA_INFO="";
function prepare(recs){
  return recs.map((o,i)=>{
    const dash=o.runs.match(/^(.*?)\s+[\u2013-]\s+([\s\S]*)$/);
    const runs=dash?dash[1].trim():o.runs, runsD=dash?dash[2]:"";
    const other=new Set([...splitStm(o.where_d,true),...splitStm(o.good,true)].map(norm));
    const who=splitStm(o.who,true).filter(s=>!other.has(norm(s)));
    const textFields=[o.runs,o.what,o.who,o.amounts,o.taxable_d,o.freq_d,o.apply_d,o.type_d,o.where_d,o.good];
    const nums=[...new Set(citeNums(textFields.join(" ")))].filter(n=>REFS.has(n)).sort((a,b)=>a-b);
    const r={i,rec:o,level:o.level,province:o.province,status:o.status,type:o.type||"Not set",runs,where:o.where||"Not set",
      taxable:o.taxable,freq:o.freq,apply:o.apply,benefit:o.benefit,nums,
      h:{
        benefit:'<span class="nmt">'+esc(o.benefit)+"</span>"+(o.aka?'<span class="ab">'+esc(o.aka)+"</span>":""),
        what:render(o.what,"p"), who:renderVec(who,"ul"), amounts:render(o.amounts,"ul"), good:render(o.good,"ul"),
        type_d:render(o.type_d,"p",""), runs_d:render(runsD,"p",""), where_d:render(o.where_d,"ul",""),
        taxable_d:render(o.taxable_d,"p",""), freq_d:render(o.freq_d,"p",""), apply_d:render(o.apply_d,"p","")
      }
    };
    r.t={ benefit:(o.benefit+" "+o.aka).toLowerCase(), what:plainText(o.what).toLowerCase(), who:plainText(who.join(" ")).toLowerCase(),
          amounts:plainText(o.amounts).toLowerCase(), good:plainText(o.good).toLowerCase() };
    r.hay=[o.level,o.province,o.benefit,o.aka,o.status,o.type,o.type_d,o.runs,o.what,o.who,o.where,o.where_d,o.amounts,o.taxable,o.taxable_d,o.freq,o.freq_d,o.apply,o.apply_d,o.good]
          .map(plainText).join(" ").toLowerCase()+" "+nums.map(n=>REFS.get(n).label).join(" ").toLowerCase();
    return r;
  });
}

/* ---------- columns ---------- */
const pill=(v,cls,d)=>'<span class="'+cls+'">'+esc(v)+"</span>"+(d?'<div class="muted">'+d+"</div>":"");
const COLDEFS=[
 {k:"benefit",l:"Benefit",w:230,f:"txt",sort:true,cell:r=>r.h.benefit},
 {k:"level",l:"Level",w:104,f:"sel",sort:true,cell:r=>{const f=r.level==="Federal";return '<span class="badge '+(f?"b-fed":"b-prov")+'">'+(f?"Federal":"Provincial")+"</span>";}},
 {k:"province",l:"Province",w:124,f:"sel",sort:true,cell:r=>esc(r.province)},
 {k:"status",l:"Status",w:100,f:"sel",sort:true,cell:r=>'<span class="badge b-'+esc(r.status.replace(/\W+/g,""))+'">'+esc(r.status)+"</span>"},
 {k:"type",l:"Type",w:210,f:"sel",sort:true,cell:r=>pill(r.type,"pill ty",r.h.type_d)},
 {k:"runs",l:"Who runs it",w:210,f:"sel",sort:true,cell:r=>pill(r.runs,"pill",r.h.runs_d)},
 {k:"what",l:"What it is",w:270,f:"txt",cell:r=>'<div class="muted">'+r.h.what+"</div>"},
 {k:"who",l:"Who it's for",w:290,f:"txt",cell:r=>r.h.who},
 {k:"where",l:"Where you must live",w:260,f:"sel",sort:true,cell:r=>pill(r.where,"pill rs",r.h.where_d)},
 {k:"amounts",l:"Approximate amounts",w:260,f:"txt",cell:r=>r.h.amounts},
 {k:"taxable",l:"Taxable?",w:190,f:"sel",sort:true,cell:r=>pill(r.taxable,"pill t-"+r.taxable.split(/[ ,(]/)[0],r.h.taxable_d)},
 {k:"freq",l:"How often it's paid",w:210,f:"sel",sort:true,cell:r=>pill(r.freq,"pill",r.h.freq_d)},
 {k:"apply",l:"How to apply or register",w:270,f:"sel",sort:true,cell:r=>pill(r.apply,"pill",r.h.apply_d)},
 {k:"good",l:"Good to know",w:290,f:"txt",cell:r=>r.h.good},
 {k:"srcs",l:"Sources",w:250,cell:r=>'<ol class="refs">'+r.nums.map(n=>'<li value="'+n+'"><a href="'+esc(REFS.get(n).url)+'" target="_blank" rel="noopener">'+esc(REFS.get(n).label)+"</a></li>").join("")+"</ol>"}
];
const F={}; let sort={k:null,dir:1}; let Q=[]; let visible=[];

function buildHead(){
  $("cols").innerHTML=COLDEFS.map(c=>'<col style="width:'+c.w+'px">').join("");
  document.querySelector("table").style.minWidth=COLDEFS.reduce((a,c)=>a+c.w,0)+"px";
  $("hrow").innerHTML=COLDEFS.map(c=>{
    const lab=c.sort?'<button type="button" class="sortb" data-s="'+c.k+'">'+esc(c.l)+' <span class="ar">&#8597;</span></button>':esc(c.l);
    let ctl="";
    if(c.f==="sel"){ const opts=[...new Set(DATA.map(r=>r[c.k]))];
      ctl='<select data-f="'+c.k+'" aria-label="Filter '+esc(c.l)+'"><option value="">All</option>'+opts.map(o=>'<option>'+esc(o)+"</option>").join("")+"</select>"; }
    if(c.f==="txt") ctl='<input type="search" data-f="'+c.k+'" placeholder="Type to filter" aria-label="Filter '+esc(c.l)+'">';
    return '<th scope="col" class="c-'+c.k+'"><div class="th-l">'+lab+"</div>"+ctl+"</th>";
  }).join("");
  $("hrow").querySelectorAll("[data-f]").forEach(el=>el.addEventListener(el.tagName==="SELECT"?"change":"input",()=>{F[el.dataset.f]=el.value;el.classList.toggle("on",!!el.value);draw();}));
  $("hrow").querySelectorAll("[data-s]").forEach(b=>b.addEventListener("click",()=>{const k=b.dataset.s;
    if(sort.k===k){ if(sort.dir===1) sort.dir=-1; else sort={k:null,dir:1}; } else sort={k,dir:1}; draw();}));
}
function pass(r){
  if(Q.length && !Q.every(w=>r.hay.includes(w))) return false;
  for(const c of COLDEFS){ const v=F[c.k]; if(!v) continue;
    if(c.f==="sel"){ if(r[c.k]!==v) return false; }
    else { const words=v.toLowerCase().split(/\s+/).filter(Boolean); if(!words.every(w=>r.t[c.k].includes(w))) return false; } }
  return true;
}
function draw(){
  let rows=DATA.filter(pass);
  if(sort.k) rows=rows.slice().sort((a,b)=>String(a[sort.k]).localeCompare(String(b[sort.k]))*sort.dir||a.i-b.i);
  visible=rows;
  $("tb").innerHTML=rows.length?rows.map(r=>"<tr>"+COLDEFS.map(c=>'<td class="c-'+c.k+'">'+c.cell(r)+"</td>").join("")+"</tr>").join("")
    :'<tr class="empty"><td colspan="'+COLDEFS.length+'">No programs match. Remove a word from quick search or loosen a filter.</td></tr>';
  $("count").innerHTML="Showing <b>"+rows.length+"</b> of "+DATA.length+" programs";
  document.querySelectorAll("[data-s]").forEach(b=>{const on=b.dataset.s===sort.k;
    if(on){b.setAttribute("aria-sort",sort.dir>0?"ascending":"descending");b.querySelector(".ar").innerHTML=sort.dir>0?"&#8593;":"&#8595;";}
    else{b.removeAttribute("aria-sort");b.querySelector(".ar").innerHTML="&#8597;";}});
  highlight();
}
function highlight(){
  const words=Q.filter(w=>w.length>1).map(w=>w.replace(/[-\/\\^$*+?.()|[\]{}]/g,"\\$&"));
  if(!words.length) return;
  const re=new RegExp("("+words.join("|")+")","gi");
  const walker=document.createTreeWalker($("tb"),NodeFilter.SHOW_TEXT,{acceptNode:n=>n.parentNode.closest("sup,a.ext")?NodeFilter.FILTER_REJECT:(re.lastIndex=0,re.test(n.nodeValue)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT)});
  const nodes=[]; while(walker.nextNode()) nodes.push(walker.currentNode);
  nodes.forEach(n=>{ re.lastIndex=0; const span=document.createElement("span"); span.innerHTML=esc(n.nodeValue).replace(re,"<mark>$1</mark>"); n.replaceWith(...span.childNodes); });
}

/* ---------- page furniture ---------- */
function renderStatic(){
  $("notes").innerHTML=NOTES.map(n=>"<p>"+esc(n)+"</p>").join("");
  $("useful").innerHTML=USEFUL_LINKS.map(u=>'<a href="'+esc(u[1])+'" target="_blank" rel="noopener">'+esc(u[0])+"<span>"+esc(u[1].replace(/^https?:\/\/(www\.)?/,""))+"</span></a>").join("");
  const used=[...new Set(DATA.flatMap(r=>r.nums))].sort((a,b)=>a-b);
  $("srclist").innerHTML=used.map(n=>'<li value="'+n+'"><a href="'+esc(REFS.get(n).url)+'" target="_blank" rel="noopener">'+esc(REFS.get(n).label)+"</a></li>").join("");
  $("created").textContent="Figures checked against official sources on "+CHECKED_ON+". This is general information, not tax advice.";
  $("datainfo").innerHTML=DATA_INFO;
}

/* ---------- CSV download (includes the guide columns and updated sources) ---------- */
function toCSV(rows){
  const all=Object.assign({},COLS,GCOLS); const keys=Object.keys(all).filter(k=>k!=="sources").concat("sources");
  const q=v=>'"'+String(v).replace(/"/g,'""')+'"';
  const lines=[keys.map(k=>q(all[k])).join(",")];
  rows.forEach(r=>{ const o=Object.assign({},r.rec,{sources:r.nums.map(n=>"["+n+"] "+REFS.get(n).label+": "+REFS.get(n).url).join(" | ")});
    lines.push(keys.map(k=>q(o[k]??"")).join(",")); });
  return "\ufeff"+lines.join("\r\n")+"\r\n";
}
function download(text,name){
  const a=document.createElement("a"); a.href=URL.createObjectURL(new Blob([text],{type:"text/csv;charset=utf-8"}));
  a.download=name; document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);
}

/* ---------- loading ---------- */
function start(text,info){
  const {recs,hasGuide}=toRecords(text);
  REFS=buildRefs(recs); HAS_GUIDE=hasGuide;
  if(!hasGuide) addGuide(recs,REFS);
  DATA=prepare(recs); DATA_INFO=info;
  Object.keys(F).forEach(k=>delete F[k]); sort={k:null,dir:1}; Q=[]; $("qsearch").value="";
  buildHead(); renderStatic(); draw();
  $("loader").hidden=true; $("app").hidden=false;
}
function showLoader(msg){
  $("app").hidden=true; $("loader").hidden=false;
  $("loaderr").hidden=!msg; $("loaderr").textContent=msg||"";
}
function useText(text,name){
  const when=new Date().toLocaleString("en-CA",{year:"numeric",month:"long",day:"numeric",hour:"numeric",minute:"2-digit"});
  try{ start(text,"Showing data from <b>"+esc(name)+"</b>, loaded "+esc(when.replace(/\.$/,""))+"."); window.scrollTo(0,0); }
  catch(e){ showLoader("Could not read "+name+". "+e.message); }
}
function readFile(file){
  if(!file) return;
  const fr=new FileReader(); fr.onload=()=>useText(String(fr.result),file.name);
  fr.onerror=()=>showLoader("Could not open "+file.name+"."); fr.readAsText(file,"utf-8");
}
$("csvname").textContent=CSV_FILE;
$("pick").addEventListener("click",()=>$("file").click());
$("file").addEventListener("change",e=>{readFile(e.target.files[0]); e.target.value="";});
const L=$("loader");
["dragenter","dragover"].forEach(t=>L.addEventListener(t,e=>{e.preventDefault();L.classList.add("drag");}));
["dragleave","drop"].forEach(t=>L.addEventListener(t,e=>{e.preventDefault();L.classList.remove("drag");}));
L.addEventListener("drop",e=>readFile(e.dataTransfer.files[0]));
$("reload").addEventListener("click",()=>$("file").click());
$("qsearch").addEventListener("input",e=>{Q=e.target.value.toLowerCase().split(/\s+/).filter(Boolean);draw();});
$("clear").addEventListener("click",()=>{Object.keys(F).forEach(k=>delete F[k]);sort={k:null,dir:1};Q=[];$("qsearch").value="";
  document.querySelectorAll("#hrow [data-f]").forEach(el=>{el.value="";el.classList.remove("on");});draw();});
$("dlv").addEventListener("click",()=>download(toCSV(visible),"canadian-benefits-filtered.csv"));
$("dla").addEventListener("click",()=>download(toCSV(DATA),"canadian-benefits-all.csv"));

(function init(){
  showLoader("");
})();
})();
</script>
</body>
</html>
