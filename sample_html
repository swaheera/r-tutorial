  const head=rows[0].map(h=>h.trim().replace(/\u2019/g,"'"));
  const pos={}; head.forEach((h,i)=>pos[h]=i);
  const missing=Object.values(COLS).filter(c=>!(c in pos));
  if(missing.length) throw new Error("This CSV is missing these columns: "+missing.join(", ")+".");
