  }
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5;-webkit-text-size-adjust:100%}
a{color:var(--link);text-underline-offset:2px}
:focus-visible{outline:2px solid var(--link);outline-offset:2px}
.wrap{max-width:1600px;margin:0 auto;padding-left:24px;padding-right:24px}
header{padding-top:40px;padding-bottom:6px}
h1{font-family:var(--sans);font-weight:700;font-size:clamp(1.7rem,3.6vw,2.6rem);line-height:1.12;letter-spacing:-0.02em;margin:0 0 12px;max-width:28ch}
.lede{color:var(--ink2);max-width:78ch;margin:0}
h2{font-family:var(--sans);font-weight:700;font-size:1.25rem;letter-spacing:-0.01em;margin:0 0 10px}

/* loader */
.loader{margin-top:24px;background:var(--card);border:1.5px dashed var(--line);border-radius:14px;padding:26px;text-align:center}
.loader.drag{border-color:var(--ink);background:var(--hover)}
.loader p{margin:0 auto 14px;color:var(--ink2);max-width:62ch}
.loader .err{color:var(--end);font-weight:600}
.btn{font:inherit;font-weight:600;font-size:.9rem;border:1px solid var(--ink);background:var(--ink);color:var(--card);border-radius:10px;padding:10px 16px;cursor:pointer}
.btn.ghost{background:var(--card);color:var(--ink)}
.txtbtn{font:inherit;font-size:.88rem;border:0;background:none;color:var(--link);cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:2px}
.databar{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;margin-top:14px;font-size:.86rem;color:var(--ink2)}
.databar b{color:var(--ink)}

/* quick search */
.qs{margin-top:22px;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center}
.qs label{position:relative;flex:1 1 420px;max-width:760px;display:block}
.qs input{width:100%;font:inherit;font-size:1rem;padding:13px 14px 13px 42px;border:1.5px solid var(--ink);border-radius:12px;background:var(--card);color:var(--ink)}
.qs svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--ink2);pointer-events:none}
.qs .hint{font-size:.84rem;color:var(--ink3)}

/* table */
.tbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin:14px 0 10px}
.tbar .count{font-size:.9rem;color:var(--ink2)}
.tbar .count b{color:var(--ink)}
.tscroll{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:auto;max-height:calc(100vh - 70px);-webkit-overflow-scrolling:touch}
table{border-collapse:separate;border-spacing:0;width:100%;table-layout:fixed}
thead th{position:sticky;top:0;z-index:3;background:var(--head);text-align:left;vertical-align:top;padding:12px 12px 10px;border-bottom:1px solid var(--line);border-right:1px solid var(--line2)}
thead th:last-child{border-right:0}
.th-l{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:.76rem;font-weight:600;color:var(--ink2);margin-bottom:7px;white-space:nowrap}
.sortb{font:inherit;border:0;background:none;color:inherit;cursor:pointer;padding:0;display:inline-flex;align-items:center;gap:4px}
.sortb .ar{opacity:.35}
.sortb[aria-sort] .ar{opacity:1;color:var(--ink)}
thead select,thead input{font:inherit;font-size:.82rem;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px 8px;width:100%}
thead .on{border-color:var(--ink);font-weight:600}
tbody td{padding:13px 12px;vertical-align:top;border-bottom:1px solid var(--line2);border-right:1px solid var(--line2);font-size:.86rem;background:var(--card);overflow-wrap:anywhere}
tbody td:last-child{border-right:0}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:var(--hover)}
/* frozen first column */
th.c-benefit,td.c-benefit{position:sticky;left:0;border-right:1px solid var(--line)}
th.c-benefit{z-index:4}
td.c-benefit{z-index:1;overflow-wrap:normal}
.empty td{text-align:center;padding:40px;color:var(--ink2)}

/* cell content */
.nmt{font-weight:600;font-size:.94rem;line-height:1.3;display:block}
.ab{display:block;color:var(--ink3);font-size:.78rem;margin-top:3px;line-height:1.3}
.muted{color:var(--ink2)}
.dash{color:var(--ink3)}
td p{margin:0 0 6px} td p:last-child{margin-bottom:0}
td ul{margin:0;padding-left:15px}
td li{margin:0 0 4px}
td li::marker{color:var(--ink3)}
.badge{display:inline-block;font-size:.72rem;font-weight:600;padding:3px 8px 2px;border-radius:6px;white-space:nowrap;background:var(--fedbg);color:var(--fed)}
.b-fed{background:var(--fedbg);color:var(--fed)} .b-prov{background:var(--provbg);color:var(--prov)}
.b-Active{background:var(--actbg);color:var(--act)} .b-Ended,.b-Renamed{background:var(--endbg);color:var(--end)} .b-Changing{background:var(--chgbg);color:var(--chg)}
.pill{display:inline-block;white-space:normal;line-height:1.3;font-size:.72rem;font-weight:600;border:1px solid var(--line);border-radius:999px;padding:2px 9px 1px;margin-bottom:6px;color:var(--ink);background:var(--bg)}
.pill.ty{background:var(--tybg);color:var(--ty);border-color:transparent}
.pill.rs{background:var(--provbg);color:var(--prov);border-color:transparent}
.pill.t-No{background:var(--actbg);color:var(--act);border-color:transparent}
.pill.t-Yes{background:var(--chgbg);color:var(--chg);border-color:transparent}
sup{font-size:.68em;line-height:0;margin-left:2px;white-space:nowrap}
sup a{color:var(--link);text-decoration:none;font-weight:600;padding:0 1px}
sup a:hover{text-decoration:underline}
a.ext{display:inline-block;margin-left:4px;padding:0 5px;border:1px solid var(--line);border-radius:5px;background:var(--bg);font-size:.74rem;font-weight:700;line-height:1.4;text-decoration:none;vertical-align:1px}
a.ext:hover{border-color:var(--link)}
ol.refs{margin:0;padding-left:24px}
ol.refs li{margin-bottom:5px;font-size:.8rem;line-height:1.3}
ol.refs li::marker{color:var(--ink3);font-weight:600}
mark{background:var(--mark);color:inherit;border-radius:2px;padding:0 1px}

/* bottom */
.dl{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:18px 0 0}
.notes{color:var(--ink2);font-size:.87rem;max-width:96ch;margin:26px 0 26px}
.notes p{margin:0 0 8px}
.useful{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px;margin-bottom:30px}
.useful a{display:block;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;text-decoration:none;color:var(--ink);font-weight:600;font-size:.9rem;line-height:1.3}
.useful a span{display:block;color:var(--ink3);font-weight:400;font-size:.76rem;margin-top:4px;overflow-wrap:anywhere}
.useful a:hover{border-color:var(--ink)}
.srcnote{margin:0 0 12px;color:var(--ink2);font-size:.9rem}
.srclist{columns:2 360px;column-gap:32px;font-size:.84rem;padding-left:28px;margin:0}
.srclist li{break-inside:avoid;margin-bottom:5px}
.srclist li::marker{color:var(--ink3);font-weight:600}
.created{border-top:1px solid var(--line);margin-top:24px;padding-top:14px;padding-bottom:40px;font-size:.85rem;color:var(--ink2)}

[hidden]{display:none !important}
@media (max-width:640px){
  .wrap{padding-left:14px;padding-right:14px}
  header{padding-top:28px}
  .tscroll{max-height:calc(100vh - 40px)}
  th.c-benefit,td.c-benefit{position:static}
}
</style>
</head>
