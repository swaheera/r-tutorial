/* ---------- CSV reading ---------- */
function sniffDelim(t){
  let c=0,s=0,q=false;
  for(const ch of t){ if(ch==='"') q=!q; else if(!q){ if(ch===",")c++; else if(ch===";")s++; else if(ch==="\n")break; } }
