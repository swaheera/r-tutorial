  --fed:#18212F; --fedbg:#E7EAF0; --prov:#0B6E68; --provbg:#DBF0EC; --end:#9A3B2E; --endbg:#F7E4DF; --chg:#8A5A00; --chgbg:#FAEED3; --act:#1F6B3A; --actbg:#E1F2E6;
  --ty:#3B3F9A; --tybg:#E8E9F8; --link:#1F4FB5; --mark:#FFE58A;
