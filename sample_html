  const all=Object.assign({},COLS,hasGuide?GCOLS:{});
  const recs=rows.slice(1).map(r=>{ const o={}; for(const [k,c] of Object.entries(all)) o[k]=String(r[pos[c]]??"").replace(/[\r\n]+/g," ").trim(); return o; })
