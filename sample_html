    --fed:#E8ECF2; --fedbg:#2A3240; --prov:#5FD0C6; --provbg:#153734; --end:#F09A8A; --endbg:#3A211D; --chg:#F0C466; --chgbg:#3A2E14; --act:#7FD39B; --actbg:#16311F;
