# ============================================================
# PART 2: COUNTERFACTUAL SIMULATIONS
# ============================================================

cat("\n=== COUNTERFACTUAL SIMULATIONS ===\n")

all_cf     <- list()
cf_results <- data.frame()

for (prov in provinces) {
   
    cat(paste0("  ", prov, "\n"))
   
    df <- master %>%
        dplyr::filter(province == prov) %>%
        dplyr::arrange(date) %>%
        build_xreg()
   
    pre_data <- df %>% dplyr::filter(date < INTERVENTION_START)
    int_data <- df %>% dplyr::filter(date >= INTERVENTION_START &
                                         date <= INTERVENTION_END)
    n_int    <- nrow(int_data)
    if (n_int == 0) { cat("    !! no intervention data – skipping\n"); next }
    actuals  <- int_data$food_cpi
   
    y_pre   <- pre_data$food_cpi
    y_ts    <- ts(y_pre,
                  start = c(year(min(pre_data$date)),
                            month(min(pre_data$date))),
                  frequency = 12)
    x_train <- as.matrix(pre_data[, xreg_cols])
    x_post  <- as.matrix(int_data[, xreg_cols])
   
    fit <- tryCatch(
        auto.arima(y_ts, xreg = x_train, seasonal = FALSE,
                   stepwise = FALSE, approximation = FALSE),
        error = function(e) NULL)
    if (is.null(fit)) { cat("    !! fit failed – skipping\n"); next }
   
    sim_paths  <- run_simulations(fit, nsim = n_int,
                                  xreg_future = x_post, n_sims = N_SIMS)
    mean_diffs <- apply(sim_paths, 1, function(row) mean(actuals - row))
    est <- mean(mean_diffs)
    ci  <- quantile(mean_diffs, c(0.025, 0.975))
    pv  <- min(ifelse(est >= 0,
                      mean(mean_diffs < 0) * 2,
                      mean(mean_diffs > 0) * 2), 1)
   
    ao <- arimaorder(fit)
   
    cf_results <- rbind(cf_results, data.frame(
        GEO      = prov,
        estimate = est,
        ci_lower = ci[1],
        ci_upper = ci[2],
        p_value  = pv,
        stringsAsFactors = FALSE
    ))
   
    all_cf[[prov]] <- list(
        fit         = fit,
        sim_paths   = sim_paths,
        mean_diffs  = mean_diffs,
        results     = data.frame(estimate = est, ci_lower = ci[1],
                                 ci_upper = ci[2], p_value = pv),
        cf_mean     = colMeans(sim_paths),
        cf_lower    = apply(sim_paths, 2, quantile, 0.025),
        cf_upper    = apply(sim_paths, 2, quantile, 0.975),
        fitted_pre  = as.numeric(fitted(fit)),
        pre_data    = pre_data,
        int_data    = int_data,
        prov_df     = df
    )
   
    cat(sprintf("    ARIMA%s  est=%+.2f [%.2f, %.2f]  p=%.3f\n",
                sprintf("(%d,%d,%d)", ao[1], ao[2], ao[3]),
                est, ci[1], ci[2], pv))
}

