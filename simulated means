# Function to estimate intervention effect using simulation
estimate_intervention_effect <- function(data, value_col, n_sims = N_SIMS) {
    
    # Split into pre-intervention and intervention periods
    pre_data <- data %>% dplyr::filter(date < INTERVENTION_START)
    intervention_data <- data %>% dplyr::filter(date >= INTERVENTION_START & date <= INTERVENTION_END)
    
    # Create time series for pre-intervention period
    ts_pre <- ts(pre_data[[value_col]], 
                 start = c(year(min(pre_data$date)), month(min(pre_data$date))), 
                 frequency = 12)
    
    # Fit model on pre-intervention data
    model <- auto.arima(ts_pre, seasonal = TRUE)
    
    # Get actual intervention period values
    post_actuals <- intervention_data[[value_col]]
    
    # Extract model parameters
    coef_est <- coef(model)
    vcov_mat <- vcov(model)
    sigma_est <- sqrt(model$sigma2)
    
    # Get model order
    order <- arimaorder(model)
    p <- order[1]
    d <- order[2]
    q <- order[3]
    P <- order[4]
    D <- order[5]
    Q <- order[6]
    
    # Simulation: captures BOTH parameter uncertainty AND forecast uncertainty
    mean_diffs <- numeric(n_sims)
    sim_paths_all <- matrix(NA, nrow = n_sims, ncol = length(post_actuals))
    n_intervention <- length(post_actuals)
    
    for (sim in 1:n_sims) {
        if (sim %% 2000 == 0) cat(paste0("  Simulation ", sim, "/", n_sims, "\n"))
        
        # PARAMETER UNCERTAINTY: Draw parameters from multivariate normal
        coef_draw <- mvrnorm(n = 1, mu = coef_est, Sigma = vcov_mat)
        
        # Extract AR and MA coefficients
        ar_coefs <- if (p > 0) coef_draw[paste0("ar", 1:p)] else numeric(0)
        ma_coefs <- if (q > 0) coef_draw[paste0("ma", 1:q)] else numeric(0)
        
        # Handle intercept/mean
        intercept <- 0
        if ("intercept" %in% names(coef_draw)) {
            intercept <- coef_draw["intercept"]
        } else if ("mean" %in% names(coef_draw)) {
            intercept <- coef_draw["mean"]
        }
        
        # FORECAST UNCERTAINTY: Simulate counterfactual path with noise
        if (p == 0 && q == 0) {
            sim_path <- rnorm(n_intervention, mean = intercept, sd = sigma_est)
        } else {
            model_spec <- list()
            if (p > 0) model_spec$ar <- ar_coefs
            if (q > 0) model_spec$ma <- ma_coefs
            
            sim_path <- tryCatch(
                arima.sim(n = n_intervention, model = model_spec, sd = sigma_est) + intercept,
                error = function(e) rnorm(n_intervention, mean = intercept, sd = sigma_est)
            )
        }
        
        sim_paths_all[sim, ] <- sim_path
        
        # EFFECT CALCULATION: mean of (actual - counterfactual) for each month
        mean_diffs[sim] <- mean(post_actuals - sim_path)
    }
    
    # Calculate prediction intervals for each intervention time point
    pred_lower <- apply(sim_paths_all, 2, quantile, probs = 0.025)
    pred_upper <- apply(sim_paths_all, 2, quantile, probs = 0.975)
    pred_mean <- apply(sim_paths_all, 2, mean)
    
    # Calculate summary statistics for effect
    estimate <- mean(mean_diffs)
    ci_lower <- quantile(mean_diffs, 0.025)
    ci_upper <- quantile(mean_diffs, 0.975)
    
    # Get fitted values for the pre-intervention period (for plotting)
    fitted_pre <- as.numeric(fitted(model))
    
    # Get the last fitted value (for padding/connecting to counterfactual)
    last_fitted <- tail(fitted_pre, 1)
    
    return(list(
        results = data.frame(
            estimate = estimate,
            ci_lower = ci_lower,
            ci_upper = ci_upper,
            model_order = paste0("ARIMA(", p, ",", d, ",", q, ")(", P, ",", D, ",", Q, ")[12]")
        ),
        fitted_pre = fitted_pre,
        last_fitted = last_fitted,
        pred_mean = pred_mean,
        pred_lower = pred_lower,
        pred_upper = pred_upper,
        mean_diffs = mean_diffs,
        pre_dates = pre_data$date,
        intervention_dates = intervention_data$date
    ))
}

