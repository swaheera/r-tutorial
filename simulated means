            adf.test(series, alternative = "stationary")
        }, error = function(e) list(p.value = NA))
        
        # KPSS test
        kpss_result <- tryCatch({
            kpss.test(series, null = "Level")
        }, error = function(e) list(p.value = NA))
        
        stationarity_results <- rbind(stationarity_results, data.frame(
            GEO = prov,
            measure = measure,
            adf_pvalue = adf_result$p.value,
            kpss_pvalue = kpss_result$p.value,
            adf_stationary = ifelse(adf_result$p.value < 0.05, "Yes", "No"),
            kpss_stationary = ifelse(kpss_result$p.value > 0.05, "Yes", "No")
        ))
    }
