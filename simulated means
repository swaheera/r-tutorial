# ============================================================
# HELPER FUNCTION: Create subtitle text
# ============================================================
create_subtitle <- function(measure_label, effect_est, ci_lower, ci_upper) {
    
    # Determine direction
    direction <- ifelse(effect_est < 0, "lower", "higher")
    
    # Format the effect estimate
    effect_abs <- abs(round(effect_est, 2))
    
    # Format CI
    ci_lower_fmt <- round(ci_lower, 2)
    ci_upper_fmt <- round(ci_upper, 2)
    
    # Build subtitle
    subtitle_text <- paste0(
        "A model controlling for seasonality and existing trends was fit on pre-rebate data (",
        format(PLOT_START_DATE, "%b %Y"), " - ", format(INTERVENTION_START - months(1), "%b %Y"), ").\n",
        "During the ", N_INTERVENTION_MONTHS, "-month rebate window (",
        format(INTERVENTION_START, "%b %Y"), " - ", format(INTERVENTION_END, "%b %Y"),
        "), actual ", tolower(measure_label), " price changes were ", effect_abs, 
        " percentage points ", direction, " than predicted,\n",
        "with a 95% interval of [", ci_lower_fmt, ", ", ci_upper_fmt, 
        "]. This suggests the rebate was associated with a change of ~", effect_abs,
        " pp, assuming pre-rebate dynamics would have continued."
    )
    
    return(subtitle_text)
}

# ============================================================
# HELPER FUNCTION: Create individual province time series plot
# ============================================================
create_province_plot <- function(prov, measure_type = "mean") {
    
    prov_model <- all_models[[prov]]
    prov_data <- prov_model$data
    
    if (measure_type == "mean") {
        fit_data <- prov_model$mean_fit
        value_col <- "mean_change"
        measure_label <- "Average"
        effect_est <- mean_results$estimate[mean_results$GEO == prov]
        ci_lower <- mean_results$ci_lower[mean_results$GEO == prov]
        ci_upper <- mean_results$ci_upper[mean_results$GEO == prov]
    } else {
        fit_data <- prov_model$median_fit
        value_col <- "median_change"
        measure_label <- "Median"
        effect_est <- median_results$estimate[median_results$GEO == prov]
        ci_lower <- median_results$ci_lower[median_results$GEO == prov]
        ci_upper <- median_results$ci_upper[median_results$GEO == prov]
    }
    
    # Filter to plot date range
    prov_data <- prov_data %>% 
        dplyr::filter(date >= PLOT_START_DATE & date <= PLOT_END_DATE)
    
    # Pre-intervention fitted values
    pre_dates <- fit_data$pre_dates
    fitted_pre <- fit_data$fitted_pre
    last_fitted <- fit_data$last_fitted
    last_pre_date <- max(pre_dates)
    
    # Intervention predictions
    intervention_dates <- fit_data$intervention_dates
    pred_mean <- fit_data$pred_mean
    pred_lower <- fit_data$pred_lower
    pred_upper <- fit_data$pred_upper
    
    # Create plot data frame
    plot_df <- prov_data
    plot_df$actual <- plot_df[[value_col]]
    plot_df$fitted <- NA_real_
    plot_df$counterfactual <- NA_real_
    plot_df$cf_lower <- NA_real_
    plot_df$cf_upper <- NA_real_
    
    # Add fitted values for pre-intervention period (within plot range)
    pre_idx <- which(plot_df$date %in% pre_dates)
    fitted_df <- data.frame(date = pre_dates, fitted_val = fitted_pre)
    for (i in pre_idx) {
        d <- plot_df$date[i]
        match_idx <- which(fitted_df$date == d)
        if (length(match_idx) > 0) {
            plot_df$fitted[i] <- fitted_df$fitted_val[match_idx]
        }
    }
    
    # Find the index of the last pre-intervention date
    last_pre_idx <- which(plot_df$date == last_pre_date)
    
    # Add counterfactual for intervention period
    int_idx <- which(plot_df$date %in% intervention_dates)
    for (i in seq_along(int_idx)) {
        idx <- int_idx[i]
        plot_df$counterfactual[idx] <- pred_mean[i]
        plot_df$cf_lower[idx] <- pred_lower[i]
        plot_df$cf_upper[idx] <- pred_upper[i]
    }
    
    # PADDING: Add the last fitted value as the first point of counterfactual
    if (length(last_pre_idx) > 0) {
        plot_df$counterfactual[last_pre_idx] <- last_fitted
    }
    
    # Create date breaks: January of each year within plot range + intervention dates
    year_start <- year(PLOT_START_DATE)
    year_end <- year(PLOT_END_DATE)
    year_breaks <- seq(as.Date(paste0(year_start, "-01-01")), 
                       as.Date(paste0(year_end, "-01-01")), 
                       by = "year")
    
    # Add intervention date breaks
    intervention_breaks <- c()
    if (SHOW_INTERVENTION_START_LINE) {
        intervention_breaks <- c(intervention_breaks, INTERVENTION_START)
    }
    if (SHOW_INTERVENTION_END_LINE) {
        intervention_breaks <- c(intervention_breaks, INTERVENTION_END)
    }
    
    all_breaks <- sort(unique(c(year_breaks, intervention_breaks)))
    
    # Custom labels
    date_labels <- sapply(all_breaks, function(d) {
        if ((d == INTERVENTION_START && SHOW_INTERVENTION_START_LINE) ||
            (d == INTERVENTION_END && SHOW_INTERVENTION_END_LINE)) {
            return(paste0(format(d, "%b"), "\n", year(d)))
        } else {
            return(paste0("Jan\n", year(d)))
        }
    })
    
    # Create subtitle
    subtitle_text <- create_subtitle(measure_label, effect_est, ci_lower, ci_upper)
    
    # Build the plot
    p <- ggplot(plot_df, aes(x = date)) +
        # Prediction interval ribbon (light pink)
        geom_ribbon(aes(ymin = cf_lower, ymax = cf_upper, fill = "95% Prediction Interval"), 
                    alpha = 0.4, na.rm = TRUE) +
        # Actual data (black solid)
        geom_line(aes(y = actual, color = "Actual Data"), linewidth = 0.7) +
        # Fitted model (red solid)
        geom_line(aes(y = fitted, color = "Fitted Model"), linewidth = 0.8, na.rm = TRUE) +
        # Counterfactual (red dotted)
        geom_line(aes(y = counterfactual, color = "Model Forecast (No Rebate)"), 
                  linetype = "dotted", linewidth = 1, na.rm = TRUE)
    
    # Add intervention line(s) - using geom_vline directly without aes for linetype
    # We'll add a dummy segment for the legend
    if (SHOW_INTERVENTION_START_LINE) {
        p <- p + geom_vline(xintercept = INTERVENTION_START,
                            linetype = "dotted", color = "black", linewidth = 0.8)
    }
    if (SHOW_INTERVENTION_END_LINE) {
        p <- p + geom_vline(xintercept = INTERVENTION_END,
                            linetype = "dotted", color = "black", linewidth = 0.8)
    }
    
    # Add a dummy horizontal segment for the legend (invisible but creates legend entry)
    # This creates a horizontal line in the legend instead of vertical
    dummy_y <- mean(plot_df$actual, na.rm = TRUE)
    p <- p + geom_segment(aes(x = PLOT_START_DATE, xend = PLOT_START_DATE,
                               y = dummy_y, yend = dummy_y,
                               linetype = "2023 Grocery Rebate"),
                          color = "black", linewidth = 0.8)
    
    # Add scales
    p <- p +
        # Color scale
        scale_color_manual(
            name = "",
            values = c("Actual Data" = "black", 
                       "Fitted Model" = "red", 
                       "Model Forecast (No Rebate)" = "red"),
            guide = guide_legend(
                order = 1,
                override.aes = list(
                    linetype = c("solid", "solid", "dotted"),
                    linewidth = c(0.7, 0.8, 1)
                )
            )
        ) +
        # Fill scale for ribbon
        scale_fill_manual(
            name = "",
            values = c("95% Prediction Interval" = "lightpink"),
            guide = guide_legend(order = 2)
        ) +
        # Linetype scale for rebate line (horizontal in legend)
        scale_linetype_manual(
            name = "",
            values = c("2023 Grocery Rebate" = "dotted"),
            guide = guide_legend(
                order = 3,
                override.aes = list(color = "black", linewidth = 0.8)
            )
        ) +
        # X-axis
        scale_x_date(
            breaks = all_breaks,
            labels = date_labels,
            limits = c(PLOT_START_DATE, PLOT_END_DATE)
        ) +
        # Labels
        labs(
            title = paste0(prov, ": ", measure_label, " Month-to-Month % Change in Grocery Prices"),
            subtitle = subtitle_text,
            x = "",
            y = paste0(measure_label, " Month-to-Month\n% Change in Grocery Prices"),
            caption = DATA_SOURCE
        ) +
        # Theme
        theme_minimal() +
        theme(
            plot.title = element_text(face = "bold", size = 12),
            plot.subtitle = element_text(size = 9),
            plot.caption = element_text(hjust = 0, size = 8),
            legend.position = "bottom",
            legend.box = "horizontal",
            legend.text = element_text(size = 8),
            axis.text.x = element_text(size = 8),
            axis.title.y = element_text(size = 9)
        )
    
    return(p)
}

