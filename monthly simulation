# ----- CHECK 4: PI sanity (Method B wider than or equal to Method A) -----

cat("--- CHECK 4: PI sanity check ---\n\n")

resids_chk <- as.numeric(residuals(model1_apple))
resids_chk <- resids_chk[!is.na(resids_chk)]
vcov_chk   <- vcov(model1_apple)
coefs_chk  <- coef(model1_apple)

set.seed(123)
paths_A_chk <- simulate_arima_paths(model1_apple, xreg_test_1, resids_chk, 1000, coef_draw = NULL)
cum_A_chk   <- apply(paths_A_chk, 2, cumsum)
width_A     <- apply(cum_A_chk, 1, quantile, probs = q_hi) -
               apply(cum_A_chk, 1, quantile, probs = q_lo)

paths_B_chk <- matrix(NA_real_, nrow = n_test_1, ncol = 1000)
for (si in 1:1000) {
    cd <- mvrnorm(1, mu = coefs_chk, Sigma = vcov_chk)
    names(cd) <- names(coefs_chk)
    paths_B_chk[, si] <- as.numeric(simulate_arima_paths(
        model1_apple, xreg_test_1, resids_chk, 1, coef_draw = cd
    ))
}
cum_B_chk <- apply(paths_B_chk, 2, cumsum)
width_B   <- apply(cum_B_chk, 1, quantile, probs = q_hi) -
             apply(cum_B_chk, 1, quantile, probs = q_lo)

cat("Cumulative PI width by month:\n")
cat("  Method A:", paste(round(width_A, 1), collapse = ", "), "\n")
cat("  Method B:", paste(round(width_B, 1), collapse = ", "), "\n")
cat("  B >= A? :", all(width_B >= width_A * 0.95), "(approx, stochastic)\n\n")


