cat("##############################################\n\n")

join_keys <- c("model", "scenario", "training_window", "testing_window", "date",
               "true_scenario", "scenario_diff", "log_response", "log_predictors",
               "num_months_used_in_training", "num_months_used_in_testing",
               "forecast_month", "monotonic")

total_rows <- results_df %>% filter(response == "total_sales")
apple_rows <- results_df %>% filter(response == "apple_sales")

banana_actual_lookup <- results_df %>%
    filter(response == "banana_sales") %>%
