# Fruit sales in the headlines --------------------------------------------------
# Builds one interactive HTML page: monthly sales for apples, bananas and oranges
# in Canada, with news and government releases pinned to their dates.
#
# In the page:
#   * toggle between apple, banana and orange sales
#   * switch the y-axis between units sold and % change year over year
#     (hover the line to see sales a year earlier and now)
#   * filter stories by source (CBC, Statistics Canada, IRCC) and by kind
#     (factual vs projection/plan); only national (Canada-wide) stories are used
#   * pick a date window (from / to month) to zoom in on a period
#   * five random headlines (each from a different year) are shown on opening;
#     tick stories in the left panel to add more;
#     headlines are placed so they never overlap each other, the line, or
#     another headline's pointer
#
# Input:  none needed - the sales data and the news articles are typed in below with dput().
#   To read them from CSV files instead, delete the dput() block and remove the # in
#   front of the read.csv() line just above it (each is marked "OPTION 1" / "OPTION 2");
#   the file names are set in SETTINGS (data_csv, news_csv).
#   sales data:    a date column (YYYY-MM-DD, first of the month), a class column and a value
#                  column; set their names (date_col, class_col, var_col) in SETTINGS below
#   news articles: columns geo, source, type, date, exact, show, headline, url
#   Year-over-year values need a year of earlier data, so with data from April 2020
#   they start in April 2021.
# Output: fruit_sales_headlines.html (one self-contained file), with buttons to
#   download the chart as JPEG, all references as CSV and all data as CSV.
# Packages: plotly, htmlwidgets, htmltools, dplyr. Self-contained
# output needs pandoc, which ships with RStudio.

library(dplyr)
library(plotly)
library(htmlwidgets)
library(htmltools)

# =====================================================================================
# SETTINGS - change these
# =====================================================================================
# File names (in R's working directory, getwd(), or give a full path such as
# "C:/Users/me/Documents/fruit_sales_data.csv"). The two CSVs are only read if you
# switch to OPTION 1 further down; out_file is the page this script writes.
data_csv <- "fruit_sales_data.csv"       # the data (date, class and value columns)
news_csv <- "fruit_sales_stories.csv"    # the news articles
out_file <- "fruit_sales_headlines.html"

# Column names in the data
date_col  <- "date"    # the month, as YYYY-MM-DD (first of the month)
class_col <- "class"   # the group (apple, banana, orange)
var_col   <- "sales"   # the number to plot

# The classes: their values in class_col (capitals and spaces don't matter), and the
# button label for each, in the same order. Buttons appear left to right in this order,
# and the first one is shown when the page opens. Rows with any other value are left out.
class_names  <- c("apple", "banana", "orange")
class_labels <- c("Apple", "Banana", "Orange")

# Text on the page. These are filled in automatically wherever they appear:
#   {class}     the button picked, e.g. Apple
#   {first}     first month of data, e.g. Apr 2020      {last} last month of data
#   {made}      the day the page was built              {yoy_start} first month with a year-over-year value
panel_title    <- "Fruit sales in the headlines"        # top of the left panel (and the browser tab)
class_heading  <- "Fruit"                               # label beside the buttons
title_level    <- "Monthly Fruit Sales in Canada: {class} (Units Sold)"
title_yoy      <- "Monthly Fruit Sales in Canada: {class} (% Change Year over Year)"
subtitle       <- "Source: simulated monthly sales data, {first} to {last} (fruit_sales_data.csv)"
yoy_explainer  <- "How it's calculated: if sales are 1,000 units in January 2021 and 1,100 units in January 2022, the year-over-year change is (1,100 − 1,000) ÷ 1,000 = <b>+10%</b>."
footer         <- "Made {made}. One value per fruit per month, dated the first of the month. Year-over-year values start in {yoy_start}."
