  const MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const LAG=12;   // monthly data: the same month a year earlier is 12 rows back
  const geos={};G.geos.forEach(g=>{geos[g.code]=g});
  const store={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
  const jget=(k,d)=>{try{const v=JSON.parse(store.get(k)||"null");return Array.isArray(v)?v:d}catch(e){return d}};
  let geo=store.get("fruit1-class")||G.geos[0].code, mode=store.get("fruit1-mode")||"pop";
  if(!geos[geo])geo=G.geos[0].code; if(!["pop","yoy"].includes(mode))mode="pop";
  // date window: picked from the months in the data ("" = first / last)
  const Q=G.geos[0].ms,fmtQ=t=>MON[new Date(t).getUTCMonth()]+"-"+new Date(t).getUTCFullYear();
  const qOf=v=>{const t=Date.parse(v||"");return Q.includes(t)?t:null};
  let d0="",d1="";   // the full date range each time the page opens
  // months offered: every month in the data; in the year-over-year view, from the first month with a value a year earlier
  const QQ=()=>mode==="yoy"?Q.slice(LAG):Q;
  function win(){const Qd=QQ();let a=qOf(d0),b=qOf(d1);if(a!=null&&b!=null&&a>b){const t=a;a=b;b=t}
    if(a!=null&&a<=Qd[0])a=null;if(b!=null&&b<=Qd[0])b=Qd[1]||null;if(b===Qd[Qd.length-1])b=null;
    const lo=a==null?Qd[0]:a,hi=b==null?Infinity:b,full=a==null&&b==null;
