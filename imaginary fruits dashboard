    for(const [q,e] of [[x1-a,-dx],[c-x1,dx],[y1-b,-dy],[d-y1,dy]]){if(e===0){if(q<0)return false}else{const t=q/e;if(e<0){if(t>t1)return false;if(t>t0)t0=t}else{if(t<t0)return false;if(t<t1)t1=t}}}return t0<=t1}
