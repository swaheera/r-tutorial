  const esc=s=>String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;");
  const fmtV=v=>Math.round(v).toLocaleString("en-CA");
  const fmtPct=v=>(v>=0?"+":"")+(v*100).toFixed(2)+"%";
  const fmtC=v=>v>=1e6?(v/1e6).toFixed(2)+"M":(v>=1e3?(v/1e3).toFixed(1)+"K":Math.round(v)+"");
  const interp=(S,t)=>{if(t<=S[0][0])return S[0][1];if(t>=S[S.length-1][0])return S[S.length-1][1];
    for(let k=1;k<S.length;k++)if(t<=S[k][0])return S[k-1][1]+(t-S[k-1][0])/(S[k][0]-S[k-1][0])*(S[k][1]-S[k-1][1])};
  // national = Canada-wide stories and releases; provincial = about one province or territory
  const national=s=>s.geo==="CA"||s.geo==="ALL",scopeOf=s=>national(s)?"National":"Provincial";
  const SYM_OF=s=>national(s)?"star":"square";
  // ---- data series
  function popSeries(code){const g=geos[code];return g.ms.map((t,i)=>[t,g.v[i]])}
  const yoyStart=()=>{const t=Q[LAG];return t?DM(t):"\u2014"};
  function series(code,m){const P=popSeries(code);if(m==="pop")return P;
    const out=[];for(let i=LAG;i<P.length;i++)out.push([P[i][0],P[i][1]/P[i-LAG][1]-1,P[i-LAG],P[i]]);return out}
  // ---- stories: every story applies to every fruit
  const inGeo=(s,code)=>true;
  const inWin=s=>{const w=win();return s.ms>=w.lo&&s.ms<=w.hi};
  const visibleFor=code=>G.stories.filter(s=>inGeo(s,code)&&srcOn.has(s.src)&&kindOn.has(kindOf(s))&&inWin(s));
  const visibleStories=()=>visibleFor(geo);
  // ---- label measuring and non-overlapping placement
  const cv=document.createElement("canvas").getContext("2d");
  const tw=(s,b)=>{cv.font=(b?"bold ":"")+"12px Arial";return cv.measureText(s).width};
  const wrap=(h,n)=>{const out=[];let cur="";h.split(" ").forEach(w=>{if((cur+" "+w).trim().length>n&&cur){out.push(cur);cur=w}else cur=(cur+" "+w).trim()});if(cur)out.push(cur);return out};
  function sizes(s,tail,widths){return widths.map((n,k)=>{const L=wrap(s.h,n),T="("+s.d+") "+tail;
    const tl=tw(T,false)>tw("x".repeat(n),true)*1.05?wrap(T,n+6):[T];
