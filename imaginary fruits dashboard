# keep accented letters and symbols in the settings intact even when R is not running in UTF-8
u8 <- function(x) {
  if (is.character(x)) { i <- Encoding(x) == "unknown" & validUTF8(x); Encoding(x)[i] <- "UTF-8" }
  x
}
