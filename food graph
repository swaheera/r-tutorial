library(tidyverse)
library(ggrepel)

last_date <- max(master$date)
rebate_date <- as.Date("2023-07-01")

# Separate Canada from provinces
canada_data <- master %>% filter(province == "Canada")
province_data <- master %>% filter(province != "Canada")

province_last <- province_data %>%
    filter(date == last_date) %>%
    select(province, food_cpi) %>%
    mutate(label = case_when(
        province == "Newfoundland and Labrador" ~ "NL",
        province == "Prince Edward Island" ~ "PEI",
        province == "Nova Scotia" ~ "NS",
        province == "New Brunswick" ~ "NB",
        province == "British Columbia" ~ "BC",
        TRUE ~ province
    ))

# Custom x-axis breaks: yearly Jan + rebate date
year_breaks <- seq.Date(as.Date("2017-01-01"), as.Date("2026-01-01"), by = "1 year")
all_breaks <- sort(unique(c(year_breaks, rebate_date)))

# Custom labels: "Jan\n2017" for yearly, "Jul\n2023" for rebate
custom_labels <- ifelse(
    all_breaks == rebate_date,
    format(rebate_date, "%b\n%Y"),
    format(all_breaks, "%b\n%Y")
)

ggplot() +
    # Rebate vertical line
    geom_vline(xintercept = rebate_date, linetype = "dashed",
               colour = "#2E8B57", linewidth = 0.5, alpha = 0.7) +
    annotate("text", x = rebate_date - 25, y = Inf,
             label = "2023 Grocery\nRebate",
             hjust = 1, vjust = 1.3, size = 2.6, colour = "#2E8B57",
             fontface = "bold", lineheight = 0.9) +
    # Province lines
    geom_line(data = province_data, aes(x = date, y = food_cpi, group = province),
              colour = "grey40", linewidth = 0.35, alpha = 0.55) +
    # Canada line in red
    geom_line(data = canada_data, aes(x = date, y = food_cpi),
              colour = "#D62828", linewidth = 1.1) +
    # Anchor dots
    geom_point(data = province_last, aes(x = last_date, y = food_cpi),
               size = 1, colour = "grey40") +
    # Province labels
    geom_text_repel(data = province_last,
                    aes(x = last_date, y = food_cpi, label = label),
                    direction = "y", hjust = 0, nudge_x = 80,
                    segment.size = 0.3, segment.colour = "grey55",
                    segment.linetype = "dotted",
                    size = 2.7,
                    box.padding = 0.35, point.padding = 0.2,
                    force = 4, force_pull = 0.2,
                    max.overlaps = Inf,
                    min.segment.length = 0,
                    xlim = c(last_date + 20, NA)) +
    scale_x_date(
        expand = expansion(mult = c(0.02, 0.15)),
        breaks = all_breaks,
        labels = custom_labels
    ) +
    labs(
        title = "Monthly Food CPI by Canadian Province, 2017–2025",
        subtitle = "Food CPI (2002 = 100). Canada highlighted in red. Dashed line indicates July 2023 Grocery Rebate.",
        x = NULL,
        y = "Food CPI",
        caption = "Source: Statistics Canada, Table 18-10-0004-01"
    ) +
    theme_minimal(base_size = 11) +
    theme(
        text = element_text(family = ""),
        plot.title = element_text(face = "bold", size = 13, hjust = 0,
                                  margin = margin(b = 3)),
        plot.subtitle = element_text(size = 9, colour = "grey35", hjust = 0,
                                     margin = margin(b = 12)),
        plot.caption = element_text(size = 7.5, colour = "grey50", hjust = 1,
                                    margin = margin(t = 10)),
        panel.grid.minor = element_blank(),
        panel.grid.major.x = element_blank(),
        panel.grid.major.y = element_line(colour = "grey88", linewidth = 0.25),
        axis.text = element_text(colour = "grey30", size = 9),
        axis.title.y = element_text(size = 9, margin = margin(r = 8)),
        plot.margin = margin(12, 70, 8, 8)
    )
