# ============================================
# OPTIMIZED ARIMAX SCENARIO FORECASTING
# USING COEFFICIENT-BASED FORECASTING
# ============================================

library(dplyr)
library(forecast)
library(parallel)
library(foreach)
library(doParallel)

# ============================================
# 1. SIMULATE HISTORICAL DATA
# ============================================

set.seed(123)

dates_hist <- seq(as.Date("2020-01-01"), as.Date("2025-03-01"), by = "month")
n_hist <- length(dates_hist)

historical_data <- data.frame(
  date = dates_hist,
  apple = 1000 + cumsum(rnorm(n_hist, 2, 1)),
  banana = 100 + cumsum(rnorm(n_hist, 0.5, 0.5)),
  grapes = 150 + cumsum(rnorm(n_hist, 0.3, 0.3)),
  oranges = 200 + cumsum(rnorm(n_hist, 1, 0.5)),
  cherries = 80 + cumsum(rnorm(n_hist, 0.4, 0.4))
)

historical_data$response_var <- 50 + 
  0.02 * historical_data$apple + 
  0.1 * historical_data$banana + 
  0.05 * historical_data$grapes + 
  0.03 * historical_data$oranges + 
  0.08 * historical_data$cherries +
  rnorm(n_hist, 0, 2)

# ============================================
# 2. SIMULATE ACTUAL DATA
# ============================================

dates_actual <- seq(as.Date("2025-04-01"), as.Date("2026-01-01"), by = "month")
n_actual <- length(dates_actual)

set.seed(456)
actual_data <- data.frame(
  date = dates_actual,
  response_var = 85 + cumsum(rnorm(n_actual, -0.5, 1))
)

# ============================================
# 3. DEFINE ALL VARIABLE COMBINATIONS
# ============================================

all_vars <- c("apple", "banana", "grapes", "oranges", "cherries")

all_combinations <- list()
combo_id <- 1

for (k in 1:length(all_vars)) {
  combos <- combn(all_vars, k, simplify = FALSE)
  for (combo in combos) {
    all_combinations[[combo_id]] <- combo
    combo_id <- combo_id + 1
  }
}

n_combinations <- length(all_combinations)

# ============================================
# 4. DEFINE SCENARIO GRID
# ============================================

pct_values <- c(-0.5, -1, -1.5, -2, -2.5, -3, -5, -10, -20, -30, -40, -50)

# ============================================
# 5. HELPER FUNCTIONS
# ============================================

get_scenarios_for_combo <- function(combo, pct_values) {
  grid_list <- list()
  for (var in combo) {
    grid_list[[paste0(var, "_pct")]] <- pct_values
  }
  expand.grid(grid_list)
}

project_regressors <- function(last_values, pct_changes, n_months_total, n_forecast_months, vars_used) {
  proj <- matrix(NA, nrow = n_forecast_months, ncol = length(vars_used))
  colnames(proj) <- vars_used
  for (var in vars_used) {
    pct_col <- paste0(var, "_pct")
    mult <- (1 + pct_changes[[pct_col]] / 100)^(1 / n_months_total)
    for (m in 1:n_forecast_months) {
      proj[m, var] <- last_values[[var]] * mult^m
    }
  }
  return(proj)
}

# ============================================
# 6. SET UP PARAMETERS
# ============================================

last_row <- tail(historical_data, 1)
last_values <- list(
  apple = last_row$apple,
  banana = last_row$banana,
  grapes = last_row$grapes,
  oranges = last_row$oranges,
  cherries = last_row$cherries
)

n_months_total <- 10
n_forecast_months <- 10
forecast_horizon <- 10

actual_10m <- head(actual_data$response_var, forecast_horizon)
sum_actual <- sum(actual_10m)

n_cores <- detectCores() - 1

# ============================================
# 7. MAIN FUNCTION: OPTIMIZED METHOD
# ============================================

run_optimized <- function() {
  
  all_results <- vector("list", n_combinations)
  
  cat("Starting OPTIMIZED method...\n")
  cat("Total combinations:", n_combinations, "\n")
  cat("Using", n_cores, "cores\n\n")
  
  for (combo_idx in 1:n_combinations) {
    
    vars_used <- all_combinations[[combo_idx]]
    combo_name <- paste(vars_used, collapse = " + ")
    expand_combo <- get_scenarios_for_combo(vars_used, pct_values)
    n_scenarios <- nrow(expand_combo)
    
    cat("Combo", combo_idx, "/", n_combinations, ":", combo_name, "\n")
    cat("  Scenarios:", n_scenarios, "\n")
    
    # Fit ARIMAX model
    xreg_hist <- as.matrix(historical_data[, vars_used, drop = FALSE])
    arimax_model <- auto.arima(historical_data$response_var, xreg = xreg_hist, seasonal = FALSE)
    
    # Extract coefficients ONCE
    coefs <- coef(arimax_model)
    reg_coefs <- coefs[vars_used]
    intercept <- ifelse("intercept" %in% names(coefs), coefs["intercept"], 0)
    
    cat("  Coefficients:", paste(names(reg_coefs), "=", round(reg_coefs, 4), collapse = ", "), "\n")
    cat("  Intercept:", round(intercept, 4), "\n")
    
    # Start parallel cluster
    cl <- makeCluster(n_cores)
    registerDoParallel(cl)
    
    clusterExport(cl, c(
      "reg_coefs", "intercept", "last_values", "n_months_total", "n_forecast_months",
      "forecast_horizon", "sum_actual", "expand_combo", "vars_used", "project_regressors"
    ), envir = environment())
    
    combo_start <- Sys.time()
    
    results_combo <- foreach(i = 1:n_scenarios, .combine = rbind) %dopar% {
      
      pct_changes <- as.list(expand_combo[i, , drop = FALSE])
      xreg_forecast <- project_regressors(last_values, pct_changes, n_months_total, n_forecast_months, vars_used)
      
      # FAST: Manual forecast using coefficients
      forecasts <- as.numeric(xreg_forecast %*% reg_coefs) + intercept
      
      sum_forecast <- sum(head(forecasts, forecast_horizon))
      raw_error <- (sum_forecast - sum_actual) / sum_actual
      abs_error <- abs(raw_error)
      
      # Build result row
      result_row <- data.frame(
        combo_id = combo_idx,
        combo_name = paste(vars_used, collapse = " + "),
        n_vars = length(vars_used),
        scenario_id = i,
        sum_forecast = sum_forecast,
        sum_actual = sum_actual,
        raw_error = raw_error,
        abs_error = abs_error
      )
      
      # Add pct columns
      result_row$apple_pct <- ifelse("apple" %in% vars_used, pct_changes$apple_pct, NA)
      result_row$banana_pct <- ifelse("banana" %in% vars_used, pct_changes$banana_pct, NA)
      result_row$grapes_pct <- ifelse("grapes" %in% vars_used, pct_changes$grapes_pct, NA)
      result_row$oranges_pct <- ifelse("oranges" %in% vars_used, pct_changes$oranges_pct, NA)
      result_row$cherries_pct <- ifelse("cherries" %in% vars_used, pct_changes$cherries_pct, NA)
      
      result_row
    }
    
    stopCluster(cl)
    
    combo_end <- Sys.time()
    combo_time <- round(difftime(combo_end, combo_start, units = "secs"), 2)
    
    cat("  Time:", combo_time, "secs\n\n")
    
    all_results[[combo_idx]] <- results_combo
  }
  
  cat("Done! Combining results...\n")
  do.call(rbind, all_results)
}

# ============================================
# 8. RUN IT
# ============================================

cat("============================================\n")
cat("OPTIMIZED ARIMAX SCENARIO FORECASTING\n")
cat("============================================\n\n")

start_time <- Sys.time()
results <- run_optimized()
end_time <- Sys.time()

total_time <- difftime(end_time, start_time, units = "secs")

# ============================================
# 9. RESULTS
# ============================================

# Sort by absolute error
results_sorted <- results[order(results$abs_error), ]

cat("\n============================================\n")
cat("RESULTS SUMMARY\n")
cat("============================================\n")
cat("Total combinations:", n_combinations, "\n")
cat("Total scenarios:", nrow(results), "\n")
cat("Total time:", round(total_time, 2), "seconds\n")

# Best by combination
cat("\n=== BEST ERROR BY VARIABLE COMBINATION ===\n")
best_by_combo <- results %>%
  group_by(combo_id, combo_name, n_vars) %>%
  summarise(
    best_abs_error = min(abs_error),
    mean_abs_error = mean(abs_error),
    mean_raw_error = mean(raw_error),
    n_scenarios = n(),
    .groups = "drop"
  ) %>%
  arrange(best_abs_error)

print(best_by_combo)

# Top 20 overall
cat("\n=== TOP 20 SCENARIOS ===\n")
print(head(results_sorted[, c("combo_name", "apple_pct", "banana_pct", "grapes_pct", 
                               "oranges_pct", "cherries_pct", "raw_error", "abs_error")], 20))

# Best overall
cat("\n=== BEST OVERALL SCENARIO ===\n")
best <- results_sorted[1, ]
cat("Variables:", best$combo_name, "\n")
cat("Apple %:", best$apple_pct, "\n")
cat("Banana %:", best$banana_pct, "\n")
cat("Grapes %:", best$grapes_pct, "\n")
cat("Oranges %:", best$oranges_pct, "\n")
cat("Cherries %:", best$cherries_pct, "\n")
cat("Raw Error:", round(best$raw_error * 100, 2), "%\n")
cat("Abs Error:", round(best$abs_error * 100, 2), "%\n")

# ============================================
# 10. SAVE RESULTS
# ============================================

write.csv(results_sorted, "results_optimized_sorted.csv", row.names = FALSE)
write.csv(best_by_combo, "best_by_combination.csv", row.names = FALSE)

cat("\nResults saved to:\n")
cat("- results_optimized_sorted.csv\n")
cat("- best_by_combination.csv\n")
