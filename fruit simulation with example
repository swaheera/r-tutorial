# ---- 6. Build the grid of coherent strategies ---------------------------------
section("6. Build coherent strategy grid")

get_fc <- function(s) base |> filter(series == s) |> select(origin, date, model, fc)

A  <- get_fc(FA)      |> rename(m_a = model, a   = fc)
B  <- get_fc(FB)      |> rename(m_b = model, b   = fc)
Tt <- get_fc("total") |> rename(m_t = model, tot = fc)
S  <- get_fc("share") |> rename(m_s = model, s   = fc)

key   <- c("origin", "date")
cross <- function(x, y) inner_join(x, y, by = key, relationship = "many-to-many")  # all model pairs

grid <- bind_rows(
  cross(A, B) |>
    transmute(origin, date, strategy = S_AB, m_a, m_b,
              combo = paste0(FA, ":", m_a, " | ", FB, ":", m_b),
              !!FA := a, !!FB := b, total = a + b),
  cross(Tt, A) |>
    transmute(origin, date, strategy = S_TA, m_t, m_a,
              combo = paste0("total:", m_t, " | ", FA, ":", m_a),
              !!FA := a, !!FB := tot - a, total = tot),
  cross(Tt, B) |>
    transmute(origin, date, strategy = S_TB, m_t, m_b,
              combo = paste0("total:", m_t, " | ", FB, ":", m_b),
              !!FA := tot - b, !!FB := b, total = tot),
  cross(Tt, S) |>
    transmute(origin, date, strategy = S_TS, m_t, m_s,
              combo = paste0("total:", m_t, " | share:", m_s),
              !!FA := tot * s, !!FB := tot * (1 - s), total = tot)
)

combo_parts <- distinct(grid, strategy, combo, m_t, m_a, m_b, m_s)
print(count(combo_parts, strategy, name = "n_combos"))
log_msg("Total combos: %d", nrow(combo_parts))

grid_long <- grid |>
  pivot_longer(all_of(series_lvls), names_to = "series", values_to = "fc") |>
  left_join(actuals, by = c("date", "series"))

# ---- 7. Score all combos -------------------------------------------------------
section("7. Score all combos")

metrics <- score_fc(grid_long, strategy, combo, series)

# a combo is a "single model" pipeline if every component uses the same model name
same_model <- function(...) {
  m <- cbind(...)
  apply(m, 1, function(r) {
    r <- r[!is.na(r)]
    if (length(unique(r)) == 1) r[1] else NA_character_
  })
}

# overall score per combo: average of the 6 MAPEs (3 series x monthly/yearly), equal weights.
# Change the weighting here if e.g. total matters more than fruit B.
overall <- metrics |>
  group_by(strategy, combo) |>
  summarise(score = mean((monthly_mape + yearly_mape) / 2), .groups = "drop") |>
  left_join(combo_parts, by = c("strategy", "combo")) |>
  mutate(single_model = same_model(m_t, m_a, m_b, m_s)) |>
  arrange(score)

summary_tbl <- metrics |>
  pivot_wider(names_from = series, values_from = c(monthly_mape, yearly_mape)) |>
  left_join(select(overall, strategy, combo, single_model, score), by = c("strategy", "combo")) |>
  arrange(score)

log_msg("Scored %d combos, of which %d are single-model pipelines",
        nrow(overall), sum(!is.na(overall$single_model)))

# helper: print clear winner or near ties
report_ties <- function(cands, label) {
  best <- cands$score[1]
  ties <- filter(cands, score <= best * (1 + TIE_TOL))
  if (nrow(ties) == 1) {
    log_msg("%s: clear winner %s (score %.2f)", label, cands$combo[1], best)
  } else {
    log_msg("%s: no clear winner, %d candidates within %.0f%% of best score (%.2f):",
            label, nrow(ties), TIE_TOL * 100, best)
    print(select(ties, any_of(c("single_model", "strategy", "combo", "score"))), n = Inf)
  }
}

