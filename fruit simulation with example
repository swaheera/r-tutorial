# =============================================================================
# Fruit sales forecasting: combinatorial grid of COHERENT forecast strategies
#
# Every strategy produces fruit A, fruit B and total with total = A + B:
#   1. A + B          : forecast A and B (each its own model); total = A + B
#   2. total - A      : forecast total and A; B = total - A
#   3. total - B      : forecast total and B; A = total - B
#   4. total x A share: forecast total and A's share; A = total * share, B = total * (1 - share)
#
# PART 1 - best combination: components may use different models (e.g. ARIMA for total, ETS for A)
# PART 2 - best single model: the same model is used for every component (easier to explain)
#
# Metrics per series: monthly MAPE and yearly MAPE (|sum actual - sum fc| / sum actual),
# from rolling-origin CV with a 12-month horizon.
# =============================================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(forecast)
library(ranger)
library(xgboost)

# =============================================================================
# SIMULATED DEMO DATA - delete this block when using your own data
# =============================================================================
set.seed(123)

sim_dates <- seq(as.Date("2019-01-01"), as.Date("2026-09-01"), by = "month")
sim_t     <- seq_along(sim_dates)
sim_mon   <- as.integer(format(sim_dates, "%m"))

# population: ~1.5%/yr growth + a 2% step in mid-2022 (e.g. immigration wave)
sim_pop <- round(1e6 * exp(0.015 * sim_t / 12) *
                   (1 + 0.02 * (sim_dates >= as.Date("2022-07-01"))) *
                   (1 + rnorm(length(sim_t), 0, 0.001)))

# per-capita sales: own trend + seasonality + noise
apple_pc  <- 0.020 * (1 + 0.020 * sim_t / 12) * (1 + 0.15 * sin(2 * pi * (sim_mon - 3) / 12)) *
  exp(rnorm(length(sim_t), 0, 0.04))
banana_pc <- 0.015 * (1 + 0.010 * sim_t / 12) * (1 + 0.10 * cos(2 * pi * (sim_mon - 7) / 12)) *
  exp(rnorm(length(sim_t), 0, 0.05))

# long format: date, population, fruit, sales (sales only from 2020-04)
df <- bind_rows(
  tibble(date = sim_dates, population = sim_pop, fruit = "apple",  sales = sim_pop * apple_pc),
  tibble(date = sim_dates, population = sim_pop, fruit = "banana", sales = sim_pop * banana_pc)
) |>
  mutate(sales = if_else(date < as.Date("2020-04-01"), NA_real_, round(sales))) |>
  arrange(date, fruit)

cat("Simulated demo data 'df':", nrow(df), "rows\n")
# ============================ end of simulated data ============================

# ---- 0a. Data config: edit these to match your data ---------------------------
# Expected input: long format, one row per date x fruit, monthly dates without gaps.
DF_NAME   <- "df"              # name of your data frame object (as a string)
DATE_COL  <- "date"            # date column (Date, or something as.Date() can parse)
POP_COL   <- "population"      # population column
FRUIT_COL <- "fruit"           # column holding the fruit name
SALES_COL <- "sales"           # sales column
FRUIT_A   <- "apple"           # value in FRUIT_COL for the first fruit
FRUIT_B   <- "banana"          # value in FRUIT_COL for the second fruit

# ---- 0b. Model / CV settings ----------------------------------------------------
H       <- 12    # forecast horizon (months)
INITIAL <- 36    # months in the first training window
STEP    <- 3     # months between forecast origins
WINDOW  <- NULL  # NULL = expanding window (train from first month); a number (e.g. 36) = sliding window
TIE_TOL <- 0.02  # candidates within 2% of the best score count as "near ties"
TOP_K   <- 20    # number of top combos used to count which individual models show up most

log_msg <- function(...) cat(format(Sys.time(), "%H:%M:%S"), "|", sprintf(...), "\n")
section <- function(title) cat("\n==== ", title, " ", strrep("=", max(0, 60 - nchar(title))), "\n", sep = "")
ym      <- function(x) format(x, "%Y-%m")

FA <- FRUIT_A
FB <- FRUIT_B
stopifnot(FA != FB,
          !any(c(FA, FB) %in% c("date", "population", "total", "share", "pop_yoy")))

# labels used in tables and plots
S_AB <- paste(FA, "+", FB)
S_TA <- paste("total -", FA)
S_TB <- paste("total -", FB)
S_TS <- paste("total x", FA, "share")
strategy_cols <- setNames(c("steelblue", "darkgreen", "orange", "purple"), c(S_AB, S_TA, S_TB, S_TS))
series_lvls   <- c(FA, FB, "total")

# ---- 2. Read input and prepare series ------------------------------------------
section("2. Read input and prepare series")

raw <- get(DF_NAME)
missing_cols <- setdiff(c(DATE_COL, POP_COL, FRUIT_COL, SALES_COL), names(raw))
if (length(missing_cols) > 0) stop("Columns not found in ", DF_NAME, ": ", paste(missing_cols, collapse = ", "))

# map user columns onto internal names
dat <- raw |>
  transmute(date       = as.Date(.data[[DATE_COL]]),
            population = as.numeric(.data[[POP_COL]]),
            fruit      = as.character(.data[[FRUIT_COL]]),
            sales      = as.numeric(.data[[SALES_COL]]))

found <- unique(dat$fruit)
if (!all(c(FA, FB) %in% found)) stop("Fruit values not found. Available: ", paste(found, collapse = ", "))
dat <- filter(dat, fruit %in% c(FA, FB))

log_msg("'%s': %d rows | dates %s to %s | sales from %s",
        DF_NAME, nrow(dat), ym(min(dat$date)), ym(max(dat$date)),
        ym(min(dat$date[!is.na(dat$sales)])))
print(head(filter(dat, !is.na(sales)), 6))

# population: one value per date
pop_df <- dat |>
  group_by(date) |>
  summarise(population = first(na.omit(population)), .groups = "drop")

# sales: one column per fruit
wide <- dat |>
  select(date, fruit, sales) |>
  pivot_wider(names_from = fruit, values_from = sales, values_fn = sum) |>
  full_join(pop_df, by = "date") |>
  arrange(date) |>
  mutate(total    = .data[[FA]] + .data[[FB]],
         share    = .data[[FA]] / total,                   # share of fruit A in total
         pop_yoy  = population / lag(population, 12) - 1, # uses population history before sales start
         sales_ok = !is.na(.data[[FA]]) & !is.na(.data[[FB]]))

make_series <- function(s) {
  wide |>
    transmute(date, pop = population, pop_yoy, sales_ok, y = .data[[s]]) |>
    mutate(y_pc     = y / pop,            # per capita
           pc_lag12 = lag(y_pc, 12)) |>   # same month last year
    filter(sales_ok) |>                   # same months for every series, so CV folds line up
    mutate(t      = row_number(),
           month  = as.integer(format(date, "%m")),
           growth = y_pc / pc_lag12)      # YoY growth of per-capita value (ML target)
}

series_list <- sapply(c(FA, FB, "total", "share"), make_series, simplify = FALSE)
for (s in names(series_list)) {
  d <- series_list[[s]]
  log_msg("%-8s: %d months (%s to %s), mean = %.3g", s, nrow(d), ym(min(d$date)), ym(max(d$date)), mean(d$y))
}

# ---- 3. Models ---------------------------------------------------------------
# Each model: function(train, test) -> numeric forecast of length nrow(test).
# NOTE: test-period population is taken as known (in production, use a population projection).

to_ts <- function(x, d) {
  ts(x, frequency = 12,
     start = c(as.integer(format(d$date[1], "%Y")), as.integer(format(d$date[1], "%m"))))
}

ml_features <- c("month", "pop_yoy", "t")
ml_train    <- function(tr) filter(tr, !is.na(growth), !is.na(pop_yoy))

# models for sales levels (fruit A, fruit B, total)
sales_models <- list(
  snaive       = function(tr, te) snaive(to_ts(tr$y, tr), h = nrow(te))$mean,
  ets          = function(tr, te) forecast(ets(to_ts(tr$y, tr)), h = nrow(te))$mean,
  arima        = function(tr, te) forecast(auto.arima(to_ts(tr$y, tr)), h = nrow(te))$mean,
  arima_pop    = function(tr, te) {
    fit <- auto.arima(to_ts(tr$y, tr), xreg = tr$pop)
    forecast(fit, xreg = te$pop)$mean
  },
  ets_percap   = function(tr, te) forecast(ets(to_ts(tr$y_pc, tr)), h = nrow(te))$mean * te$pop,
  arima_percap = function(tr, te) forecast(auto.arima(to_ts(tr$y_pc, tr)), h = nrow(te))$mean * te$pop,
  lm_logpop    = function(tr, te) {
    fit <- lm(log(y) ~ log(pop) + t + factor(month), data = tr)
    exp(predict(fit, newdata = te))
  },
  rf_growth    = function(tr, te) {
    fit <- ranger(growth ~ month + pop_yoy + t, data = ml_train(tr), num.trees = 500, seed = 1)
    predict(fit, te[, ml_features])$predictions * te$pc_lag12 * te$pop
  },
  xgb_growth   = function(tr, te) {
    tr  <- ml_train(tr)
    X   <- function(d) as.matrix(d[, ml_features])
    fit <- xgb.train(params  = list(objective = "reg:squarederror", eta = 0.05, max_depth = 3),
                     data    = xgb.DMatrix(X(tr), label = tr$growth),
                     nrounds = 200, verbose = 0)
    predict(fit, xgb.DMatrix(X(te))) * te$pc_lag12 * te$pop
  }
)

# models for fruit A's share (a proportion, so no population scaling).
# Names that match a sales model (snaive, ets, arima) let the share strategy count as a single-model pipeline.
share_models <- list(
  snaive    = function(tr, te) snaive(to_ts(tr$y, tr), h = nrow(te))$mean,
  ets       = function(tr, te) forecast(ets(to_ts(tr$y, tr)), h = nrow(te))$mean,
  arima     = function(tr, te) forecast(auto.arima(to_ts(tr$y, tr)), h = nrow(te))$mean,
  lm_season = function(tr, te) predict(lm(y ~ t + factor(month), data = tr), newdata = te)
)

# ---- 4. Rolling-origin CV: base forecasts per series --------------------------
section("4. Cross-validation (base forecasts)")
# Expanding window: train on months 1..o. Sliding window: train on the last WINDOW months up to o.
# Forecast the next H months, then move the origin by STEP.

run_cv <- function(d, model_list, name, h = H, initial = INITIAL, step = STEP, window = WINDOW) {
  stopifnot(h <= 12)  # ML models use 12-month lags; h <= 12 keeps them leak-free
  origins <- seq(initial, nrow(d) - h, by = step)
  log_msg("[%s] %s window | %d folds | %d models",
          name, if (is.null(window)) "expanding" else paste0("sliding ", window, "-month"),
          length(origins), length(model_list))
  out <- list()
  for (i in seq_along(origins)) {
    o     <- origins[i]
    start <- if (is.null(window)) 1 else max(1, o - window + 1)
    tr    <- d[start:o, ]
    te    <- d[(o + 1):(o + h), ]
    fc <- lapply(names(model_list), function(m) {
      tryCatch(as.numeric(model_list[[m]](tr, te)),
               error = function(e) {
                 log_msg("  ! [%s] %s failed on fold %d: %s", name, m, i, conditionMessage(e))
                 rep(NA_real_, nrow(te))
               })
    })
    names(fc) <- names(model_list)
    if (all(c("ets_percap", "arima_pop", "xgb_growth") %in% names(fc))) {
      fc$avg3 <- rowMeans(cbind(fc$ets_percap, fc$arima_pop, fc$xgb_growth))  # simple model average
    }
    out[[i]] <- tibble(origin = d$date[o], date = te$date, as_tibble(fc))
    log_msg("[%s] fold %2d/%d | train %s to %s (%d mo) | test %s to %s",
            name, i, length(origins), ym(tr$date[1]), ym(tr$date[nrow(tr)]), nrow(tr),
            ym(te$date[1]), ym(te$date[h]))
  }
  bind_rows(out) |>
    pivot_longer(-c(origin, date), names_to = "model", values_to = "fc")
}

base <- bind_rows(
  lapply(c(FA, FB, "total"),
         function(s) run_cv(series_list[[s]], sales_models, s) |> mutate(series = s)),
  run_cv(series_list[["share"]], share_models, "share") |> mutate(series = "share")
)
log_msg("Base forecasts: %d rows", nrow(base))

# ---- 5. Individual models, each on its own series (diagnostic) ----------------
section("5. Individual models on their own series")

actuals <- wide |>
  select(date, all_of(c(FA, FB)), total, share) |>
  pivot_longer(-date, names_to = "series", values_to = "actual")

# per fold: monthly MAPE and yearly APE; then average over folds
score_fc <- function(x, ...) {
  x |>
    group_by(..., origin) |>
    summarise(monthly = mean(abs(actual - fc) / actual) * 100,
              yearly  = abs(sum(actual) - sum(fc)) / sum(actual) * 100,
              .groups = "drop") |>
    group_by(...) |>
    summarise(monthly_mape = mean(monthly), yearly_mape = mean(yearly), .groups = "drop")
}

model_metrics <- base |>
  left_join(actuals, by = c("date", "series")) |>
  score_fc(series, model) |>
  mutate(avg_mape = (monthly_mape + yearly_mape) / 2) |>
  group_by(series) |>
  arrange(avg_mape, .by_group = TRUE) |>
  mutate(rank = row_number()) |>
  ungroup()

print(model_metrics, n = Inf)
cat("\nBest individual model per series:\n")
print(filter(model_metrics, rank == 1))

p_models <- ggplot(model_metrics, aes(monthly_mape, yearly_mape)) +
  geom_point(aes(colour = rank == 1), size = 3) +
  geom_text(aes(label = model), vjust = -0.9, size = 3) +
  scale_colour_manual(values = c(`FALSE` = "grey40", `TRUE` = "red"), guide = "none") +
  facet_wrap(~ factor(series, levels = c(series_lvls, "share")), scales = "free") +
