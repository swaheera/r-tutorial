# Each point = one CV fold: a 12-month forecast made at that origin, scored against actuals.
# Rows: monthly / yearly MAPE. Columns: fruit A / fruit B / total.
winner_lbl <- c(setNames("Best single model", best_single_combo),
                setNames("Best combination", best_combo))  # if identical, "Best combination" wins

time_df <- grid_long |>
  filter(combo %in% names(winner_lbl)) |>
  group_by(combo, series, origin) |>
  summarise(`Monthly MAPE (%)` = mean(abs(actual - fc) / actual) * 100,
            `Yearly MAPE (%)`  = abs(sum(actual) - sum(fc)) / sum(actual) * 100,
            .groups = "drop") |>
  pivot_longer(c(`Monthly MAPE (%)`, `Yearly MAPE (%)`), names_to = "metric", values_to = "mape") |>
  mutate(series = factor(series, levels = series_lvls),
         winner = unname(winner_lbl[combo]))

cat("\nMAPE per fold for the winner(s):\n")
print(time_df |>
        select(winner, origin, series, metric, mape) |>
        pivot_wider(names_from = c(series, metric), values_from = mape) |>
        arrange(winner, origin), width = Inf)

p_time <- ggplot(time_df, aes(origin, mape, colour = winner)) +
  geom_line() +
  geom_point(size = 2) +
  scale_colour_manual(values = c("Best combination" = "red", "Best single model" = "steelblue")) +
  facet_grid(metric ~ series, scales = "free_y", switch = "y") +
  labs(x = "Forecast origin (last month of training data)", y = NULL, colour = NULL,
       title = "Winners over time",
       subtitle = paste0("Red = ", best_combo, "   |   Blue = ", best_single_combo,
                         "\nEach point = error of the 12-month forecast made at that origin")) +
  theme_bw() +
  theme(strip.placement = "outside", legend.position = "bottom")
print(p_time)

section("Done")
log_msg("Part 1 winner (best combination) : %s [%s]", best_combo, overall$strategy[1])
log_msg("Part 2 winner (best single model): %s [%s]", best_single_combo, single_best$strategy[1])
