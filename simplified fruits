library(dplyr)
library(forecast)

set.seed(42)

# --- Simulate monthly data over 10 years ---
n <- 120
dates <- seq.Date(from = as.Date("2014-01-01"), by = "month", length.out = n)

population <- arima.sim(model = list(ar = 0.7), n = n) + 100
noise <- arima.sim(model = list(ar = 0.5, ma = 0.3), n = n)

apple_sales <- numeric(n)
apple_sales[1:12] <- NA
for (i in 13:n) {
  apple_sales[i] <- 500 + 0.8 * population[i-1] + 0.5 * population[i-3] + 0.3 * population[i-6] + noise[i]
}

mydf <- data.frame(
  date = dates,
  apple_sales = apple_sales,
  population = population
)

# --- Single window function ---
fit_single_window <- function(df, 
                               train_start, 
                               train_end, 
                               test_start, 
                               test_end,
                               target_col = "apple_sales",
                               pop_col = "population",
                               n_lags = 12,
                               scenario_min = -3,
                               scenario_max = 3,
                               scenario_step = 0.1) {
  
  training_period <- paste(train_start, "to", train_end)
  testing_period <- paste(test_start, "to", test_end)
  
  df <- df %>% arrange(date)
  for (i in 1:n_lags) {
    df[[paste0("pop_lag", i)]] <- lag(df[[pop_col]], i)
  }
  
  lag_cols <- paste0("pop_lag", 1:n_lags)
  scenarios <- seq(scenario_min, scenario_max, by = scenario_step)
  
  train_df <- df %>%
    filter(date >= as.Date(train_start) & date <= as.Date(train_end)) %>%
    filter(complete.cases(select(., all_of(lag_cols))))
  
  test_df <- df %>%
    filter(date >= as.Date(test_start) & date <= as.Date(test_end)) %>%
    filter(complete.cases(select(., all_of(lag_cols))))
  
  n_test <- nrow(test_df)
  
  if (n_test == 0) return(NULL)
  
  pop_start <- df %>% filter(date == as.Date(test_start)) %>% pull(!!sym(pop_col))
  pop_end <- df %>% filter(date == as.Date(test_end)) %>% pull(!!sym(pop_col))
  true_scenario <- ((pop_end - pop_start) / pop_start) * 100
  
  total_real <- sum(test_df[[target_col]])
  
  all_combos <- lapply(1:n_lags, function(k) combn(lag_cols, k, simplify = FALSE))
  all_combos <- unlist(all_combos, recursive = FALSE)
  
  n_models <- length(all_combos)
  
  fit_single_model <- function(model_idx, xreg_cols) {
    
    model_name <- paste(xreg_cols, collapse = "+")
    xreg_train <- as.matrix(train_df[, xreg_cols, drop = FALSE])
    
    tryCatch({
      model <- auto.arima(train_df[[target_col]], xreg = xreg_train)
      
      coefs <- coef(model)
      xreg_coefs <- coefs[names(coefs) %in% xreg_cols]
      all_positive <- all(xreg_coefs > 0)
      
      total_forecasts <- numeric(length(scenarios))
      
      scenario_results <- lapply(seq_along(scenarios), function(s_idx) {
        
        scenario_pct <- scenarios[s_idx]
        
        cat("Model", model_idx, "/", n_models, "| Scenario:", scenario_pct, "% | Window:", training_period, "\n")
        
        xreg_test_base <- as.matrix(test_df[1, xreg_cols, drop = FALSE])
        
        growth_factors <- 1 + (scenario_pct / 100) * ((1:n_test - 1) / (n_test - 1))
        
        xreg_test_scenario <- matrix(
          rep(as.numeric(xreg_test_base), each = n_test) * growth_factors,
          nrow = n_test,
          ncol = length(xreg_cols)
        )
        colnames(xreg_test_scenario) <- xreg_cols
        
        test_forecast <- as.numeric(forecast(model, xreg = xreg_test_scenario)$mean)
        test_actual <- test_df[[target_col]]
        test_dates <- test_df$date
        
        total_forecasts[s_idx] <<- sum(test_forecast)
        
        monthly_ape <- abs((test_actual - test_forecast) / test_actual) * 100
        avg_monthly_mape <- mean(monthly_ape, na.rm = TRUE)
        
        yearly_df <- data.frame(
          year = format(test_dates, "%Y"),
          forecast = test_forecast,
          real = test_actual
        ) %>%
          group_by(year) %>%
          summarise(
            year_forecast = sum(forecast),
            year_real = sum(real),
            .groups = "drop"
          ) %>%
          mutate(yearly_pe = (year_forecast - year_real) / year_real * 100)
        
        avg_yearly_mape <- mean(abs(yearly_df$yearly_pe), na.rm = TRUE)
        
        data.frame(
          model = model_name,
          n_lags_used = length(xreg_cols),
          scenario = scenario_pct,
          true_scenario = true_scenario,
          scenario_diff = true_scenario - scenario_pct,
          month = test_dates,
          real = test_actual,
          forecast = test_forecast,
          total_real = total_real,
          total_forecast = sum(test_forecast),
          avg_monthly_mape = avg_monthly_mape,
          avg_yearly_mape = avg_yearly_mape,
          all_coef_positive = all_positive,
          training_period = training_period,
          testing_period = testing_period,
          stringsAsFactors = FALSE
        )
      })
      
      model_df <- do.call(rbind.data.frame, scenario_results)
      
      is_monotonic <- all(diff(total_forecasts) > 0)
      model_df$monotonic <- ifelse(is_monotonic, "yes", "no")
      
      model_df
      
    }, error = function(e) {
      NULL
    })
  }
  
  result_list <- lapply(seq_along(all_combos), function(i) {
    fit_single_model(i, all_combos[[i]])
  })
  
  result_list <- Filter(Negate(is.null), result_list)
  
  if (length(result_list) == 0) return(NULL)
  
  do.call(rbind.data.frame, result_list)
}

# --- Define windows (April 2020 to Oct 2025) ---
windows <- list(
  list(train_start = "2020-04-01", train_end = "2021-03-31", test_start = "2021-04-01", test_end = "2022-03-31"),
  list(train_start = "2020-04-01", train_end = "2022-03-31", test_start = "2022-04-01", test_end = "2023-03-31"),
  list(train_start = "2020-04-01", train_end = "2023-03-31", test_start = "2023-04-01", test_end = "2024-03-31"),
  list(train_start = "2020-04-01", train_end = "2024-03-31", test_start = "2024-04-01", test_end = "2025-03-31"),
  list(train_start = "2020-04-01", train_end = "2025-03-31", test_start = "2025-04-01", test_end = "2025-10-01")
)

# --- Run all windows ---
results_df <- do.call(rbind.data.frame, lapply(windows, function(w) {
  fit_single_window(
    df = mydf,
    train_start = w$train_start,
    train_end = w$train_end,
    test_start = w$test_start,
    test_end = w$test_end,
    n_lags = 4,
    scenario_min = -3,
    scenario_max = 3,
    scenario_step = 0.5
  )
}))

# --- Find models monotonic in ALL windows ---
monotonic_all_windows <- results_df %>%
  group_by(model, scenario, training_period, testing_period) %>%
  slice(1) %>%
  ungroup() %>%
  group_by(model) %>%
  filter(all(monotonic == "yes")) %>%
  ungroup()

# --- Final summary table ---
summary_table <- monotonic_all_windows %>%
  select(
    model,
    train_window = training_period,
    test_window = testing_period,
    total_year_actual = total_real,
    total_year_forecast = total_forecast,
    year_mape = avg_yearly_mape,
    scenario,
    true_scenario,
    monotonic
  ) %>%
  arrange(model, test_window, scenario)

print(summary_table)
