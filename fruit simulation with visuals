# uncertainty plot: dot = average over folds, bars = BAND spread across folds
plot_unc <- function(d, label_col, title, subtitle, caption, lims) {
  ggplot(d, aes(monthly_mape, yearly_mape, colour = is_winner)) +
    geom_segment(aes(x = monthly_mape, xend = monthly_mape, y = y_lo, yend = y_hi), alpha = 0.6) +
    geom_segment(aes(x = m_lo, xend = m_hi, y = yearly_mape, yend = yearly_mape), alpha = 0.6) +
    geom_point(size = 2.6) +
    geom_text_repel(aes(label = .data[[label_col]]), size = 2.9, show.legend = FALSE,
                    max.overlaps = Inf, min.segment.length = 0) +
    scale_colour_manual(values = c(`TRUE` = "red", `FALSE` = "grey30"),
                        labels = c(`TRUE` = "Winner", `FALSE` = "Others"), name = NULL) +
    scale_xy +
    coord_cartesian(xlim = lims$x, ylim = lims$y) +
    facet_wrap(~ series) +
    labs(x = "Monthly MAPE", y = "Yearly MAPE", title = title, subtitle = subtitle, caption = caption) +
    theme_fc
}
