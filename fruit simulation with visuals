report_pop <- function(combo_name, label) {
  row <- filter(overall, combo == combo_name)
  cat(sprintf("\n%s: %s\n  (%s; its population effect follows from the two models below)\n",
              label, combo_name, derived_note[[row$strategy]]))
  parts <- c(m_t = row$m_t, m_a = row$m_a, m_b = row$m_b, m_s = row$m_s)
  for (r in names(parts)[!is.na(parts)]) {
    cat("  -", describe_pop_effect(parts[[r]], unname(role_lbl[r])), "\n")
  }
}

