# =============================================================================
# Fruit sales forecasting: combinatorial grid of COHERENT forecast strategies
#
# Every strategy produces fruit A, fruit B and total with total = A + B:
#   1. A + B          : forecast A and B (each its own model); total = A + B
#   2. total - A      : forecast total and A; B = total - A
#   3. total - B      : forecast total and B; A = total - B
#   4. total x A share: forecast total and A's share; A = total * share, B = total * (1 - share)
#
# Every candidate in Part 1 and Part 2 is one of these coherent pairs, so total = A + B always holds.
# PART 1 - best combination: the two models in a pair may differ (e.g. ARIMA for total, ETS for A)
# PART 2 - best single model: both models in the pair are the same (easier to explain)
# Section 5 (each model on its own series) is a diagnostic only - those forecasts are NOT coherent.
#
# Metrics per series: monthly MAPE and yearly MAPE (|sum actual - sum fc| / sum actual),
# from rolling-origin CV with a 12-month horizon.
# =============================================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(ggrepel)
library(forecast)
library(ranger)
library(xgboost)

