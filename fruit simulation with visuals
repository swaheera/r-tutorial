section("2. Read input and prepare series")

raw <- get(DF_NAME)
missing_cols <- setdiff(c(DATE_COL, POP_COL, FRUIT_COL, SALES_COL), names(raw))
if (length(missing_cols) > 0) stop("Columns not found in ", DF_NAME, ": ", paste(missing_cols, collapse = ", "))

# map user columns onto internal names
dat <- raw |>
  transmute(date       = as.Date(.data[[DATE_COL]]),
            population = as.numeric(.data[[POP_COL]]),
            fruit      = as.character(.data[[FRUIT_COL]]),
            sales      = as.numeric(.data[[SALES_COL]]))

found <- unique(dat$fruit)
if (!all(c(FA, FB) %in% found)) stop("Fruit values not found. Available: ", paste(found, collapse = ", "))
dat <- filter(dat, fruit %in% c(FA, FB))

log_msg("'%s': %d rows | dates %s to %s | sales from %s",
        DF_NAME, nrow(dat), ym(min(dat$date)), ym(max(dat$date)),
        ym(min(dat$date[!is.na(dat$sales)])))
print(head(filter(dat, !is.na(sales)), 6))

# population: one value per date
pop_df <- dat |>
  group_by(date) |>
  summarise(population = first(na.omit(population)), .groups = "drop")

# sales: one column per fruit
wide <- dat |>
  select(date, fruit, sales) |>
  pivot_wider(names_from = fruit, values_from = sales, values_fn = sum) |>
  full_join(pop_df, by = "date") |>
  arrange(date) |>
  mutate(total    = .data[[FA]] + .data[[FB]],
         share    = .data[[FA]] / total,                   # share of fruit A in total
         pop_yoy  = population / lag(population, 12) - 1, # uses population history before sales start
         sales_ok = !is.na(.data[[FA]]) & !is.na(.data[[FB]]))

make_series <- function(s) {
  wide |>
    transmute(date, pop = population, pop_yoy, sales_ok, y = .data[[s]]) |>
    mutate(pop_lag12 = lag(pop, 12),      # population same month last year
           y_lag12   = lag(y, 12),        # value same month last year
           y_pc      = y / pop,           # per capita
           pc_lag12  = lag(y_pc, 12)) |>  # per capita same month last year
    filter(sales_ok) |>                   # same months for every series, so CV folds line up
    mutate(t      = row_number(),
           month  = as.integer(format(date, "%m")),
           growth = y_pc / pc_lag12)      # YoY growth of per-capita value (ML target)
}

series_list <- sapply(c(FA, FB, "total", "share"), make_series, simplify = FALSE)
for (s in names(series_list)) {
  d <- series_list[[s]]
  log_msg("%-8s: %d months (%s to %s), mean = %.3g", s, nrow(d), ym(min(d$date)), ym(max(d$date)), mean(d$y))
}
