section("Population effect in the winning models")
# Each component model of the winner(s) is refitted on ALL available data and its population term reported.

fmt_p <- function(p) if (p < 0.001) "p < 0.001" else sprintf("p = %.3f", p)
sig   <- function(p) if (p < 0.05) "statistically significant at 5%" else "NOT statistically significant at 5%"

describe_pop_effect <- function(model, s) {
  d         <- series_list[[s]]
  last_pop  <- tail(d$pop, 1)
  avg_sales <- mean(tail(d$y, 12))                     # current level: average of the last 12 months
  ex        <- if (is.null(POP_EXAMPLE)) signif(0.01 * last_pop, 2) else POP_EXAMPLE
  ex_pct    <- 100 * ex / last_pop
  hdr       <- sprintf("%s model for %s:", model, s)

  if (s == "share") return(paste(hdr, "share model - does not use population."))

  if (model == "lm_logpop") {
    fit <- lm(log(y) ~ log(pop) + t + factor(month), data = d)
    co  <- summary(fit)$coefficients["log(pop)", ]
    ci  <- confint(fit)["log(pop)", ]
    eff <- avg_sales * ((1 + ex / last_pop)^c(co[1], ci) - 1)
    return(sprintf(paste0(
      "%s population elasticity = %.2f (95%% CI %.2f to %.2f, %s, %s).\n",
      "    -> Holding trend and season fixed, 1%% more population goes with about %.2f%% more %s sales.\n",
      "    -> %s more people (%.1f%% of the current %s) -> about %s more %s sales per month ",
      "(95%% CI %s to %s), at the current level of ~%s per month. The same number fewer people -> roughly that much less."),
      hdr, co[1], ci[1], ci[2], fmt_p(co[4]), sig(co[4]), co[1], s,
      fmt_num(ex), ex_pct, fmt_num(last_pop), fmt_num(eff[1]), s, fmt_num(eff[2]), fmt_num(eff[3]), fmt_num(avg_sales)))
  }

  if (model == "lm_growth") {
    fit <- lm(log(y / y_lag12) ~ log(1 + pop_yoy), data = filter(d, !is.na(y_lag12), !is.na(pop_yoy)))
    nm  <- "log(1 + pop_yoy)"
    co  <- summary(fit)$coefficients[nm, ]
    ci  <- confint(fit)[nm, ]
    eff <- avg_sales * ((1 + ex / last_pop)^c(co[1], ci) - 1)
    return(sprintf(paste0(
      "%s growth effect b = %.2f (95%% CI %.2f to %.2f, %s, %s).\n",
      "    -> If population is 1%% higher than 12 months earlier (instead of unchanged), %s sales vs the same month last year are about %.2f%% higher.\n",
      "    -> If population is %s higher than at this time last year (vs no change), monthly %s sales are about %s higher ",
      "(95%% CI %s to %s); %s lower -> roughly that much less.\n",
      "    -> With no population change, %s sales would grow about %.1f%% per year."),
      hdr, co[1], ci[1], ci[2], fmt_p(co[4]), sig(co[4]), s, co[1],
      fmt_num(ex), s, fmt_num(eff[1]), fmt_num(eff[2]), fmt_num(eff[3]), fmt_num(ex),
      s, 100 * (exp(coef(fit)[1]) - 1)))
  }

  if (model == "arima_pop") {
    fit <- aa(to_ts(d$y, d), xreg = d$pop)
    k   <- grep("xreg", names(coef(fit)), value = TRUE)[1]
    b   <- coef(fit)[k]
    se  <- sqrt(diag(fit$var.coef))[k]
    p   <- 2 * pnorm(-abs(b / se))
    return(sprintf(paste0(
      "%s %s; population coefficient = %.4f sales per person per month (SE %.4f, %s, %s).\n",
      "    -> %s more people -> about %s more %s sales per month (95%% CI %s to %s); the same number fewer -> that much less.\n",
      "    -> If the model differences the data, this links month-to-month changes in population to changes in sales."),
      hdr, tryCatch(as.character(fit), error = function(e) "ARIMA"), b, se, fmt_p(p), sig(p),
      fmt_num(ex), fmt_num(b * ex), s, fmt_num((b - 1.96 * se) * ex), fmt_num((b + 1.96 * se) * ex)))
  }

  if (model %in% c("ets_percap", "arima_percap")) {
    return(sprintf(paste0(
      "%s forecasts sales per person, so sales move one-for-one with population by assumption (not estimated, no p-value).\n",
      "    -> %s more people (%.1f%%) -> about %s more %s sales per month at the current level."),
      hdr, fmt_num(ex), ex_pct, fmt_num(avg_sales * ex / last_pop), s))
  }
  if (model %in% c("rf_growth", "xgb_growth")) {
    return(paste(hdr, "ML model using population growth vs last year as an input; no single coefficient or p-value."))
  }
  if (model == "avg3") {
    return(paste(hdr, "average of ets_percap, arima_pop and xgb_growth - see those models for the population effect."))
  }
  paste(hdr, "univariate model - does not use population.")
}

