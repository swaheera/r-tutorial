pred_c1  <- inv_logit(as.numeric(fc_c1$mean))
real_c1  <- test_c1$prop
mape_c1  <- mean(abs((pred_c1 - real_c1) / real_c1))

cat("Predicted props:", round(pred_c1, 4), "\n")
cat("Real props:     ", round(real_c1, 4), "\n")
cat("Avg MAPE:       ", mape_c1, "\n\n")

