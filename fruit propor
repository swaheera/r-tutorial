library(dplyr)
library(forecast)

# =============================================================================
# CONFIG
# =============================================================================

CONFIG <- list(
  df_name    = "mydf",
  date_col   = "date",
  target_col = "prop",        # will be created as apple / total
  min_train  = 24,            # start with 24 months of training
  h          = 12             # always forecast 12 months ahead
)

# =============================================================================
# DATA SETUP (simulated — replace with your own)
# =============================================================================

set.seed(42)
n <- 67
dates <- seq.Date(from = as.Date("2020-04-01"), by = "month", length.out = n)
total <- rpois(n, 1000)
apple <- rbinom(n, size = total, prob = 0.3 + cumsum(rnorm(n, 0, 0.005)))

mydf <- data.frame(
  date  = dates,
  apple = apple,
  banana = total - apple,
  total = total
)

# Create prop
mydf$prop <- mydf$apple / mydf$total

# =============================================================================
# HELPERS
# =============================================================================

logit     <- function(p) log(p / (1 - p))
inv_logit <- function(x) 1 / (1 + exp(-x))

# =============================================================================
# PART 1: EXPANDING-WINDOW FORECAST
# =============================================================================

cat("##############################################\n")
cat("# PART 1: EXPANDING-WINDOW FORECAST          #\n")
cat("##############################################\n\n")

df        <- get(CONFIG$df_name)
df        <- df %>% arrange(.data[[CONFIG$date_col]])
min_train <- CONFIG$min_train
h         <- CONFIG$h
n_total   <- nrow(df)

max_train_end <- n_total - 1

results <- list()

for (train_end in min_train:max_train_end) {

  test_start <- train_end + 1
  test_end   <- min(train_end + h, n_total)
  n_test     <- test_end - test_start + 1

  train_data <- df[1:train_end, ]
  test_data  <- df[test_start:test_end, ]

  y_train <- logit(train_data[[CONFIG$target_col]])

  fit <- tryCatch(auto.arima(y_train), error = function(e) NULL)
  if (is.null(fit)) next

  fc <- tryCatch(forecast(fit, h = n_test), error = function(e) NULL)
  if (is.null(fc)) next

  pred_prop <- inv_logit(as.numeric(fc$mean))
  real_prop <- test_data[[CONFIG$target_col]]

  avg_mape <- mean(abs((pred_prop - real_prop) / real_prop))

  train_window <- paste(train_data[[CONFIG$date_col]][1], "to",
                        train_data[[CONFIG$date_col]][train_end])
  test_window  <- paste(test_data[[CONFIG$date_col]][1], "to",
                        test_data[[CONFIG$date_col]][n_test])

  results[[length(results) + 1]] <- data.frame(
    train_window = train_window,
    test_window  = test_window,
    avg_mape     = avg_mape,
    stringsAsFactors = FALSE
  )
}

if (length(results) == 0) stop("No results produced.\n")

results_df <- do.call(rbind, results)

cat("Expanding-window forecast complete. Total rows:", nrow(results_df), "\n\n")
print(results_df)
cat("\n")

# =============================================================================
# PART 2: INDIVIDUAL CHECKS
# =============================================================================

cat("##############################################\n")
cat("# PART 2: INDIVIDUAL CHECKS                  #\n")
cat("##############################################\n\n")

# ----- CHECK 1: Train on first 24 months, test next 12 -----

