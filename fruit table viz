library(tidyverse)
library(gt)

# =============================================================================
# DATA SETUP — aggregate all_results to CUMULATIVE TOTALS over each test period
# =============================================================================

# Sum actuals and forecasts across all months in each window/scenario,
# and grab the true pop growth rate from the last month (end-of-period growth)
df_summed <- all_results %>%
  mutate(
    scenario_num = as.numeric(gsub("%", "", scenario))
  ) %>%
  group_by(training_period, testing_period, scenario_num) %>%
  summarise(
    sum_true_total             = sum(true_total,             na.rm = TRUE),
    sum_true_apple             = sum(true_apple,             na.rm = TRUE),
    sum_true_banana            = sum(true_banana,            na.rm = TRUE),
    sum_fc_total               = sum(total_forecast,         na.rm = TRUE),
    sum_fc_apple               = sum(apple_forecast,         na.rm = TRUE),
    sum_fc_banana_method1      = sum(banana_method1_forecast, na.rm = TRUE),
    sum_fc_banana_method2      = sum(banana_method2_forecast, na.rm = TRUE),
    # true pop growth rate: take from the last month (cumulative growth over period)
    true_pop_growth_num        = as.numeric(gsub("%", "", last(true_pop_growth_rate_pct))),
    .groups = "drop"
  )

# Pivot into long format with one row per (window, scenario, response)
# so that each response type can get its own table
df_long <- bind_rows(
  df_summed %>% transmute(
    response         = "total",
    training_period, testing_period,
    scenario         = scenario_num,
    true_scenario    = true_pop_growth_num,
    total_real       = sum_true_total,
    total_forecast   = sum_fc_total
  ),
  df_summed %>% transmute(
    response         = "apples",
    training_period, testing_period,
    scenario         = scenario_num,
    true_scenario    = true_pop_growth_num,
    total_real       = sum_true_apple,
    total_forecast   = sum_fc_apple
  ),
  df_summed %>% transmute(
    response         = "banana_method1",
    training_period, testing_period,
    scenario         = scenario_num,
    true_scenario    = true_pop_growth_num,
    total_real       = sum_true_banana,
    total_forecast   = sum_fc_banana_method1
  ),
  df_summed %>% transmute(
    response         = "banana_method2",
    training_period, testing_period,
    scenario         = scenario_num,
    true_scenario    = true_pop_growth_num,
    total_real       = sum_true_banana,
    total_forecast   = sum_fc_banana_method2
  )
)

