library(DiagrammeR)

# ---------- CONFIG ----------
sA <- "A"; sB <- "B"
cA <- "gray92"; cB <- "gray92"
# ----------------------------

grViz(sprintf("
digraph g {
  layout = dot
  rankdir = LR
  size = '3,2'              // cap drawing size (inches)
  ratio = compress
  nodesep = 0.5  ranksep = 0.8
  node [shape=circle, style=filled, color=black, penwidth=0.8,
        fontname='Times-Roman', fontsize=14, fixedsize=true, width=0.7]
  edge [color=black, penwidth=0.8, arrowsize=0.7]

  sA[label='%s', fillcolor='%s']
  sB[label='%s', fillcolor='%s']

  sA->sA  sB->sB
  sA->sB  sB->sA
}",
sA,cA, sB,cB), width = 400, height = 250)

