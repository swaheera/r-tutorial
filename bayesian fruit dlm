MIN_TRAIN_YEARS <- 2

LAGS            <- c(3, 6, 12)

LOG_XREG        <- FALSE

SCENARIO_MIN    <- -3
SCENARIO_MAX    <-  3
SCENARIO_STEP   <-  0.1

TOLERANCE_PP    <- 1.0

# --- MCMC --------------------------------------------------------------------
MCMC_ITER       <- 6000
MCMC_WARMUP     <- 2000
MCMC_CHAINS     <- 4
MCMC_THIN       <- 1
MCMC_SEED       <- 123

# --- Priors ------------------------------------------------------------------
SLOPE_PRIOR_MU  <- 0
SLOPE_PRIOR_SD  <- 5
AR_PRIOR_SD     <- 0.5
SIGMA_OBS_SCALE <- 10     # half-t scale for observation noise
SIGMA_ST_SCALE  <- 2      # half-t scale for state noise (smaller = smoother)

# --- Adaptation --------------------------------------------------------------
ADAPT_INTERVAL  <- 100
TARGET_ACCEPT   <- 0.25

cat("=== Configuration ===\n")
cat("  Approach:     Bayesian DLM (state-space) with pure R MCMC\n")
cat("  Options:      1) total + logit(share)   2) apple + banana separately\n")
cat("  Monotonicity: truncated-normal priors (lower = 0) on population-lag slopes\n")
