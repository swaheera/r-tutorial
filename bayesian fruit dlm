################################################################################
# Bayesian Dynamic Linear Model — Fruit Sales
# *** Pure R MCMC (no Stan, no brms, no QuickJSR) ***
#
# Two forecasting options run side-by-side:
#   Option 1 ("total+share"):
#     DLM on total_sales ~ lagged pop, local level + AR(1)
#     DLM on logit(apple_share) ~ lagged pop, local level + AR(1)
#     apple = total × inv_logit(share), banana = total × (1 − share)
#
#   Option 2 ("separate"):
#     DLM on apple_sales ~ lagged pop, local level + AR(1)
#     DLM on banana_sales ~ lagged pop, local level + AR(1)
#     (no coherence guarantee: apple + banana ≠ total in general)
#
# State-space form (for each series):
#   Observation:  y[t] = mu[t] + b' X[t] + e[t],    e[t] ~ N(0, sigma_obs^2)
#   State:        mu[t] = mu[t-1] + phi*(mu[t-1] - mu[t-2]) + w[t],
#                                                     w[t] ~ N(0, sigma_state^2)
#   This gives a local-linear-trend with AR(1) momentum on the level.
#
# Priors:
#   b[k]       ~ N(slope_mu, slope_sd) truncated at 0   (monotonicity)
#   phi        ~ N(0, ar_sd) truncated to (-1, 1)
#   sigma_obs  ~ Half-t(3, 0, 10)
#   sigma_state~ Half-t(3, 0, scale_state)
#   mu[0]      ~ N(y[1], sd(y))
#
# Sampler: Metropolis-within-Gibbs with adaptive proposals
#   - Forward-filter backward-sample (FFBS) for the latent states
#   - MH updates for static parameters (b, phi, sigma_obs, sigma_state)
#
# Dependencies: tidyverse, zoo   (base R only for MCMC)
################################################################################

library(tidyverse)
library(zoo)

set.seed(42)

# ══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

