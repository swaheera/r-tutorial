# FORECAST GENERATORS
# ══════════════════════════════════════════════════════════════════════════════

#' Generate DLM forecasts from posterior draws
#' For lag model: uses draws_static (b, phi, sigma_obs, sigma_state) + draws_mu
dlm_forecast_lag <- function(draws_static, draws_mu, X_new, K, h) {
  n_draws <- nrow(draws_static)
  N_train <- ncol(draws_mu)
  y_pred  <- matrix(NA_real_, nrow = n_draws, ncol = h)

  for (d in 1:n_draws) {
    b           <- draws_static[d, 1:K]
    phi         <- draws_static[d, K + 1]
    sigma_obs   <- draws_static[d, K + 2]
    sigma_state <- draws_static[d, K + 3]

    mu_last  <- draws_mu[d, N_train]
    mu_prev  <- if (N_train >= 2) draws_mu[d, N_train - 1] else mu_last

    reg_new <- as.numeric(X_new %*% b)

    mu_cur <- mu_last
    mu_prv <- mu_prev

    for (t in 1:h) {
      drift  <- mu_cur + phi * (mu_cur - mu_prv)
      mu_new <- drift + rnorm(1, 0, sigma_state)
      y_pred[d, t] <- mu_new + reg_new[t] + rnorm(1, 0, sigma_obs)
      mu_prv <- mu_cur
      mu_cur <- mu_new
    }
  }
  return(y_pred)
}

#' Forecast from null DLM
dlm_forecast_null <- function(draws_static, draws_mu, h) {
  n_draws <- nrow(draws_static)
  N_train <- ncol(draws_mu)
  y_pred  <- matrix(NA_real_, nrow = n_draws, ncol = h)

  for (d in 1:n_draws) {
    phi         <- draws_static[d, "phi"]
    sigma_obs   <- draws_static[d, "sigma_obs"]
    sigma_state <- draws_static[d, "sigma_state"]

    mu_cur <- draws_mu[d, N_train]
    mu_prv <- if (N_train >= 2) draws_mu[d, N_train - 1] else mu_cur

    for (t in 1:h) {
      drift  <- mu_cur + phi * (mu_cur - mu_prv)
      mu_new <- drift + rnorm(1, 0, sigma_state)
      y_pred[d, t] <- mu_new + rnorm(1, 0, sigma_obs)
      mu_prv <- mu_cur
      mu_cur <- mu_new
    }
  }
  return(y_pred)
}

