# ══════════════════════════════════════════════════════════════════════════════
# DLM MCMC ENGINE
# ══════════════════════════════════════════════════════════════════════════════
#
# State-space model:
#   y[t] = mu[t] + X[t,] %*% b + e[t],        e ~ N(0, sigma_obs^2)
#   mu[t] = mu[t-1] + phi*(mu[t-1]-mu[t-2]) + w[t],  w ~ N(0, sigma_state^2)
#
# Parameters to sample: b (K slopes, >= 0), phi, sigma_obs, sigma_state
# Latent states: mu[1:N]  (sampled via FFBS)
#
# Strategy:
#   1. Given (b, phi, sigma_obs, sigma_state): run FFBS to draw mu[1:N]
#   2. Given mu[1:N]: update (b, phi, sigma_obs, sigma_state) via MH
# ══════════════════════════════════════════════════════════════════════════════

#' Forward-filter backward-sample for local-level with AR(1) drift
#' Returns a draw of mu[1:N]
ffbs <- function(y, X, b, phi, sigma_obs, sigma_state, mu0, P0) {
  N <- length(y)
  K <- length(b)
  reg <- as.numeric(X %*% b)   # regression component

  # Residuals after removing regression
  z <- y - reg

  # Forward filter
  # State: alpha[t] = (mu[t], mu[t-1])'   (2-dim state for AR(1) drift)
  # Transition: alpha[t] = T * alpha[t-1] + R * w[t]
  #   T = [[1+phi, -phi], [1, 0]]
  #   R = [[1], [0]]
  # Observation: z[t] = [1, 0] * alpha[t] + e[t]

  TT <- matrix(c(1 + phi, 1, -phi, 0), nrow = 2, ncol = 2)
  RR <- matrix(c(1, 0), nrow = 2, ncol = 1)
  ZZ <- matrix(c(1, 0), nrow = 1, ncol = 2)

  Q <- matrix(sigma_state^2, 1, 1)
  H <- sigma_obs^2

  # Storage for filter
  a_filt <- matrix(0, N, 2)     # filtered state mean
  P_filt <- array(0, c(2, 2, N))  # filtered state covariance
  a_pred <- matrix(0, N, 2)
  P_pred <- array(0, c(2, 2, N))

  # Initialize: alpha[0] ~ N(a0, P0_mat)
  a0 <- c(mu0, mu0)
  P0_mat <- diag(c(P0, P0))

  for (t in 1:N) {
    # Predict
    if (t == 1) {
      at <- TT %*% a0
      Pt <- TT %*% P0_mat %*% t(TT) + RR %*% Q %*% t(RR)
    } else {
      at <- TT %*% a_filt[t - 1, ]
      Pt <- TT %*% P_filt[, , t - 1] %*% t(TT) + RR %*% Q %*% t(RR)
    }
    a_pred[t, ] <- at
    P_pred[, , t] <- Pt

    # Update
    v <- z[t] - ZZ %*% at
    F_t <- ZZ %*% Pt %*% t(ZZ) + H
    K_t <- Pt %*% t(ZZ) / as.numeric(F_t)

    a_filt[t, ] <- at + K_t * as.numeric(v)
    P_filt[, , t] <- Pt - K_t %*% ZZ %*% Pt
    # Symmetrize
    P_filt[, , t] <- (P_filt[, , t] + t(P_filt[, , t])) / 2
  }

  # Backward sample
  alpha <- matrix(0, N, 2)

  # Draw alpha[N]
  L <- tryCatch(chol(P_filt[, , N]), error = function(e) NULL)
  if (is.null(L)) L <- diag(sqrt(pmax(diag(P_filt[, , N]), 1e-10)), 2)
  alpha[N, ] <- a_filt[N, ] + t(L) %*% rnorm(2)

  for (t in (N - 1):1) {
    # Smoother gain
    Pt1_pred <- P_pred[, , t + 1]
    Pt1_inv  <- tryCatch(solve(Pt1_pred), error = function(e) diag(1e-6, 2))
    Gt <- P_filt[, , t] %*% t(TT) %*% Pt1_inv

    a_sm <- a_filt[t, ] + Gt %*% (alpha[t + 1, ] - a_pred[t + 1, ])
    P_sm <- P_filt[, , t] - Gt %*% Pt1_pred %*% t(Gt)
    P_sm <- (P_sm + t(P_sm)) / 2

    L <- tryCatch(chol(P_sm), error = function(e) NULL)
    if (is.null(L)) L <- diag(sqrt(pmax(diag(P_sm), 1e-10)), 2)
    alpha[t, ] <- a_sm + t(L) %*% rnorm(2)
  }

  return(alpha[, 1])   # mu[1:N]
}

#' Log-prior for DLM parameters
log_prior_dlm <- function(b, phi, sigma_obs, sigma_state, K,
                          slope_mu, slope_sd, ar_sd,
                          sig_obs_scale, sig_st_scale) {
  if (any(b < 0)) return(-Inf)
  if (abs(phi) >= 1) return(-Inf)
  if (sigma_obs <= 0 || sigma_state <= 0) return(-Inf)

  lp <- 0

  # Slopes: truncated normal
  for (k in 1:K) {
    lp <- lp + dnorm(b[k], slope_mu, slope_sd, log = TRUE) -
      pnorm(0, slope_mu, slope_sd, lower.tail = FALSE, log.p = TRUE)
  }

  # phi: truncated normal on (-1, 1)
  lp <- lp + dnorm(phi, 0, ar_sd, log = TRUE) -
    log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd))

  # sigma_obs: half-t(3, 0, scale)
  lp <- lp + dt(sigma_obs / sig_obs_scale, df = 3, log = TRUE) -
    log(sig_obs_scale) + log(2)

  # sigma_state: half-t(3, 0, scale)
  lp <- lp + dt(sigma_state / sig_st_scale, df = 3, log = TRUE) -
    log(sig_st_scale) + log(2)

  return(lp)
}

#' Log-likelihood given latent states mu[1:N]
log_lik_dlm <- function(y, X, b, mu, sigma_obs) {
  reg <- as.numeric(X %*% b)
  sum(dnorm(y, mean = mu + reg, sd = sigma_obs, log = TRUE))
}

#' Log density of state transitions
log_state_density <- function(mu, phi, sigma_state) {
  N <- length(mu)
  lp <- dnorm(mu[1], 0, sigma_state * 5, log = TRUE)  # diffuse init
  if (N >= 2) {
    lp <- lp + dnorm(mu[2], mu[1], sigma_state, log = TRUE)
  }
  for (t in 3:N) {
    drift <- mu[t - 1] + phi * (mu[t - 1] - mu[t - 2])
    lp <- lp + dnorm(mu[t], drift, sigma_state, log = TRUE)
  }
  return(lp)
}

#' Run one DLM MCMC chain
run_dlm_chain <- function(y, X, K, n_iter, n_warmup, thin, seed,
                          slope_mu, slope_sd, ar_sd,
                          sig_obs_scale, sig_st_scale,
                          chain_id = 1, print_every = 500) {
  set.seed(seed + chain_id)
  N <- length(y)

  n_static  <- K + 3   # b[1..K], phi, sigma_obs, sigma_state
  param_names <- c(paste0("b", 1:K), "phi", "sigma_obs", "sigma_state")
  n_keep <- floor((n_iter - n_warmup) / thin)

  draws_static <- matrix(NA_real_, nrow = n_keep, ncol = n_static)
  colnames(draws_static) <- param_names
  draws_mu <- matrix(NA_real_, nrow = n_keep, ncol = N)  # latent states

  # Initialize
  b           <- abs(rnorm(K, slope_mu, 0.5))
  phi         <- runif(1, -0.2, 0.2)
  sigma_obs   <- sd(y) * 0.3
  sigma_state <- sd(y) * 0.05
  mu          <- as.numeric(stats::filter(y - as.numeric(X %*% b),
                                          rep(1/5, 5), sides = 2))
  mu[is.na(mu)] <- mean(y, na.rm = TRUE)

  # Proposal SDs
  prop_sd <- c(rep(0.01, K), 0.02, sd(y) * 0.005, sd(y) * 0.002)
  names(prop_sd) <- param_names

  accept_count <- rep(0L, n_static)
  total_count  <- rep(0L, n_static)
  adapt_acc    <- rep(0L, n_static)
  adapt_tot    <- rep(0L, n_static)

  draw_idx <- 0

  for (iter in 1:n_iter) {

    # ── Step 1: FFBS for latent states mu[1:N] ──
    mu0 <- mean(y[1:min(3, N)])
    P0  <- var(y) * 4
    mu <- tryCatch(
      ffbs(y, X, b, phi, sigma_obs, sigma_state, mu0, P0),
      error = function(e) mu   # keep old if FFBS fails
    )

    # ── Step 2: MH updates for static parameters ──
    cur_ll <- log_lik_dlm(y, X, b, mu, sigma_obs) +
      log_state_density(mu, phi, sigma_state) +
      log_prior_dlm(b, phi, sigma_obs, sigma_state, K,
                    slope_mu, slope_sd, ar_sd, sig_obs_scale, sig_st_scale)

    # Update b[k]
    for (k in 1:K) {
      pidx <- k
      b_star <- b
      b_star[k] <- rnorm(1, b[k], prop_sd[pidx])
      if (b_star[k] >= 0) {
        ll_star <- log_lik_dlm(y, X, b_star, mu, sigma_obs) +
          log_state_density(mu, phi, sigma_state) +
          log_prior_dlm(b_star, phi, sigma_obs, sigma_state, K,
                        slope_mu, slope_sd, ar_sd, sig_obs_scale, sig_st_scale)
        if (log(runif(1)) < (ll_star - cur_ll)) {
          b <- b_star; cur_ll <- ll_star
          accept_count[pidx] <- accept_count[pidx] + 1
          adapt_acc[pidx] <- adapt_acc[pidx] + 1
        }
      }
      total_count[pidx] <- total_count[pidx] + 1
      adapt_tot[pidx] <- adapt_tot[pidx] + 1
    }

    # Update phi
    pidx <- K + 1
    phi_star <- rnorm(1, phi, prop_sd[pidx])
    if (abs(phi_star) < 1) {
      ll_star <- log_lik_dlm(y, X, b, mu, sigma_obs) +
        log_state_density(mu, phi_star, sigma_state) +
        log_prior_dlm(b, phi_star, sigma_obs, sigma_state, K,
                      slope_mu, slope_sd, ar_sd, sig_obs_scale, sig_st_scale)
      if (log(runif(1)) < (ll_star - cur_ll)) {
        phi <- phi_star; cur_ll <- ll_star
        accept_count[pidx] <- accept_count[pidx] + 1
        adapt_acc[pidx] <- adapt_acc[pidx] + 1
      }
    }
    total_count[pidx] <- total_count[pidx] + 1
    adapt_tot[pidx] <- adapt_tot[pidx] + 1

    # Update sigma_obs
    pidx <- K + 2
    so_star <- rnorm(1, sigma_obs, prop_sd[pidx])
    if (so_star > 0) {
      ll_star <- log_lik_dlm(y, X, b, mu, so_star) +
        log_state_density(mu, phi, sigma_state) +
        log_prior_dlm(b, phi, so_star, sigma_state, K,
                      slope_mu, slope_sd, ar_sd, sig_obs_scale, sig_st_scale)
      if (log(runif(1)) < (ll_star - cur_ll)) {
        sigma_obs <- so_star; cur_ll <- ll_star
        accept_count[pidx] <- accept_count[pidx] + 1
        adapt_acc[pidx] <- adapt_acc[pidx] + 1
      }
    }
    total_count[pidx] <- total_count[pidx] + 1
    adapt_tot[pidx] <- adapt_tot[pidx] + 1

    # Update sigma_state
    pidx <- K + 3
    ss_star <- rnorm(1, sigma_state, prop_sd[pidx])
    if (ss_star > 0) {
      ll_star <- log_lik_dlm(y, X, b, mu, sigma_obs) +
        log_state_density(mu, phi, ss_star) +
        log_prior_dlm(b, phi, sigma_obs, ss_star, K,
                      slope_mu, slope_sd, ar_sd, sig_obs_scale, sig_st_scale)
      if (log(runif(1)) < (ll_star - cur_ll)) {
        sigma_state <- ss_star; cur_ll <- ll_star
        accept_count[pidx] <- accept_count[pidx] + 1
        adapt_acc[pidx] <- adapt_acc[pidx] + 1
      }
    }
    total_count[pidx] <- total_count[pidx] + 1
    adapt_tot[pidx] <- adapt_tot[pidx] + 1

    # ── Adapt during warmup ──
    if (iter <= n_warmup && iter %% ADAPT_INTERVAL == 0) {
      for (p in 1:n_static) {
        rate <- adapt_acc[p] / max(adapt_tot[p], 1)
        if (rate < TARGET_ACCEPT * 0.8) prop_sd[p] <- prop_sd[p] * 0.7
        else if (rate > TARGET_ACCEPT * 1.5) prop_sd[p] <- prop_sd[p] * 1.4
      }
      adapt_acc[] <- 0L; adapt_tot[] <- 0L
    }

    # ── Store ──
    if (iter > n_warmup && (iter - n_warmup) %% thin == 0) {
      draw_idx <- draw_idx + 1
      draws_static[draw_idx, ] <- c(b, phi, sigma_obs, sigma_state)
      draws_mu[draw_idx, ]     <- mu
    }

    # ── Progress ──
    if (iter %% print_every == 0) {
      rates <- round(accept_count / pmax(total_count, 1) * 100, 1)
      phase <- if (iter <= n_warmup) "warmup" else "sampling"
      cat(sprintf("    chain %d | iter %5d / %d (%s) | accept%%: %s\n",
                  chain_id, iter, n_iter, phase,
                  paste(param_names, "=", rates, collapse = "  ")))
    }
  }

  list(draws_static = draws_static[1:draw_idx, , drop = FALSE],
       draws_mu     = draws_mu[1:draw_idx, , drop = FALSE],
       accept_rate  = accept_count / pmax(total_count, 1))
}

#' Run multiple chains
run_dlm_mcmc <- function(y, X, K, n_iter, n_warmup, chains, thin, seed,
                         slope_mu, slope_sd, ar_sd,
                         sig_obs_scale, sig_st_scale,
                         label = "", print_every = 500) {
  cat(sprintf("  DLM MCMC [%s]: %d iter × %d chains\n", label, n_iter, chains))

  all_static <- list()
  all_mu     <- list()

  for (ch in 1:chains) {
    cat(sprintf("  -- Chain %d --\n", ch))
    result <- run_dlm_chain(y, X, K, n_iter, n_warmup, thin, seed,
                            slope_mu, slope_sd, ar_sd,
                            sig_obs_scale, sig_st_scale,
                            chain_id = ch, print_every = print_every)
    all_static[[ch]] <- result$draws_static
    all_mu[[ch]]     <- result$draws_mu
    cat(sprintf("    chain %d done: %d draws, accept = %s\n",
                ch, nrow(result$draws_static),
                paste(colnames(result$draws_static), "=",
                      round(result$accept_rate * 100, 1), collapse = "  ")))
  }

  combined_static <- do.call(rbind, all_static)
  combined_mu     <- do.call(rbind, all_mu)
  cat(sprintf("  Combined: %d draws\n", nrow(combined_static)))

  list(draws_static = combined_static, draws_mu = combined_mu)
}

#' Null DLM: local level + AR(1) drift, no regressors
run_dlm_null_chain <- function(y, n_iter, n_warmup, thin, seed,
                               ar_sd, sig_obs_scale, sig_st_scale,
                               chain_id = 1, print_every = 500) {
  # Same as lag model but K = 0 and X is empty
  # Parameters: phi, sigma_obs, sigma_state
  set.seed(seed + chain_id)
  N <- length(y)

  n_static <- 3
  param_names <- c("phi", "sigma_obs", "sigma_state")
  n_keep <- floor((n_iter - n_warmup) / thin)

  draws_static <- matrix(NA_real_, nrow = n_keep, ncol = n_static)
  colnames(draws_static) <- param_names
  draws_mu <- matrix(NA_real_, nrow = n_keep, ncol = N)

  phi         <- runif(1, -0.2, 0.2)
  sigma_obs   <- sd(y) * 0.3
  sigma_state <- sd(y) * 0.05
  mu          <- as.numeric(stats::filter(y, rep(1/5, 5), sides = 2))
  mu[is.na(mu)] <- mean(y, na.rm = TRUE)

  X_dummy <- matrix(0, N, 1)
  b_dummy <- 0

  prop_sd <- c(phi = 0.02, sigma_obs = sd(y) * 0.005, sigma_state = sd(y) * 0.002)
  accept_count <- rep(0L, 3); total_count <- rep(0L, 3)
  adapt_acc <- rep(0L, 3); adapt_tot <- rep(0L, 3)

  draw_idx <- 0

  for (iter in 1:n_iter) {
    # FFBS
    mu0 <- mean(y[1:min(3, N)]); P0 <- var(y) * 4
    mu <- tryCatch(
      ffbs(y, X_dummy, b_dummy, phi, sigma_obs, sigma_state, mu0, P0),
      error = function(e) mu
    )

    cur_ll <- sum(dnorm(y, mu, sigma_obs, log = TRUE)) +
      log_state_density(mu, phi, sigma_state) +
      dnorm(phi, 0, ar_sd, log = TRUE) -
      log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd)) +
      dt(sigma_obs / sig_obs_scale, 3, log = TRUE) - log(sig_obs_scale) + log(2) +
      dt(sigma_state / sig_st_scale, 3, log = TRUE) - log(sig_st_scale) + log(2)

    # phi
    phi_s <- rnorm(1, phi, prop_sd["phi"])
    if (abs(phi_s) < 1) {
      ll_s <- sum(dnorm(y, mu, sigma_obs, log = TRUE)) +
        log_state_density(mu, phi_s, sigma_state) +
        dnorm(phi_s, 0, ar_sd, log = TRUE) -
        log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd)) +
        dt(sigma_obs / sig_obs_scale, 3, log = TRUE) - log(sig_obs_scale) + log(2) +
        dt(sigma_state / sig_st_scale, 3, log = TRUE) - log(sig_st_scale) + log(2)
      if (log(runif(1)) < (ll_s - cur_ll)) {
        phi <- phi_s; cur_ll <- ll_s
        accept_count[1] <- accept_count[1] + 1; adapt_acc[1] <- adapt_acc[1] + 1
      }
    }
    total_count[1] <- total_count[1] + 1; adapt_tot[1] <- adapt_tot[1] + 1

    # sigma_obs
    so_s <- rnorm(1, sigma_obs, prop_sd["sigma_obs"])
    if (so_s > 0) {
      ll_s <- sum(dnorm(y, mu, so_s, log = TRUE)) +
        log_state_density(mu, phi, sigma_state) +
        dnorm(phi, 0, ar_sd, log = TRUE) -
        log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd)) +
        dt(so_s / sig_obs_scale, 3, log = TRUE) - log(sig_obs_scale) + log(2) +
        dt(sigma_state / sig_st_scale, 3, log = TRUE) - log(sig_st_scale) + log(2)
      if (log(runif(1)) < (ll_s - cur_ll)) {
        sigma_obs <- so_s; cur_ll <- ll_s
        accept_count[2] <- accept_count[2] + 1; adapt_acc[2] <- adapt_acc[2] + 1
      }
    }
    total_count[2] <- total_count[2] + 1; adapt_tot[2] <- adapt_tot[2] + 1

    # sigma_state
    ss_s <- rnorm(1, sigma_state, prop_sd["sigma_state"])
    if (ss_s > 0) {
      ll_s <- sum(dnorm(y, mu, sigma_obs, log = TRUE)) +
        log_state_density(mu, phi, ss_s) +
        dnorm(phi, 0, ar_sd, log = TRUE) -
        log(pnorm(1, 0, ar_sd) - pnorm(-1, 0, ar_sd)) +
        dt(sigma_obs / sig_obs_scale, 3, log = TRUE) - log(sig_obs_scale) + log(2) +
        dt(ss_s / sig_st_scale, 3, log = TRUE) - log(sig_st_scale) + log(2)
      if (log(runif(1)) < (ll_s - cur_ll)) {
        sigma_state <- ss_s; cur_ll <- ll_s
        accept_count[3] <- accept_count[3] + 1; adapt_acc[3] <- adapt_acc[3] + 1
      }
    }
    total_count[3] <- total_count[3] + 1; adapt_tot[3] <- adapt_tot[3] + 1

    # Adapt
    if (iter <= n_warmup && iter %% ADAPT_INTERVAL == 0) {
      for (p in 1:3) {
        rate <- adapt_acc[p] / max(adapt_tot[p], 1)
        if (rate < TARGET_ACCEPT * 0.8) prop_sd[p] <- prop_sd[p] * 0.7
        else if (rate > TARGET_ACCEPT * 1.5) prop_sd[p] <- prop_sd[p] * 1.4
      }
      adapt_acc[] <- 0L; adapt_tot[] <- 0L
    }

    if (iter > n_warmup && (iter - n_warmup) %% thin == 0) {
      draw_idx <- draw_idx + 1
      draws_static[draw_idx, ] <- c(phi, sigma_obs, sigma_state)
      draws_mu[draw_idx, ] <- mu
    }

    if (iter %% print_every == 0) {
      rates <- round(accept_count / pmax(total_count, 1) * 100, 1)
      phase <- if (iter <= n_warmup) "warmup" else "sampling"
      cat(sprintf("    chain %d | iter %5d / %d (%s) | accept%%: %s\n",
                  chain_id, iter, n_iter, phase,
                  paste(param_names, "=", rates, collapse = "  ")))
    }
  }

  list(draws_static = draws_static[1:draw_idx, , drop = FALSE],
       draws_mu = draws_mu[1:draw_idx, , drop = FALSE],
       accept_rate = accept_count / pmax(total_count, 1))
}

run_dlm_null <- function(y, n_iter, n_warmup, chains, thin, seed,
                         ar_sd, sig_obs_scale, sig_st_scale,
                         label = "", print_every = 500) {
  cat(sprintf("  DLM Null MCMC [%s]: %d iter × %d chains\n", label, n_iter, chains))
  all_static <- list(); all_mu <- list()
  for (ch in 1:chains) {
    cat(sprintf("  -- Chain %d --\n", ch))
    r <- run_dlm_null_chain(y, n_iter, n_warmup, thin, seed,
                            ar_sd, sig_obs_scale, sig_st_scale,
                            chain_id = ch, print_every = print_every)
    all_static[[ch]] <- r$draws_static
    all_mu[[ch]] <- r$draws_mu
    cat(sprintf("    chain %d done: %d draws\n", ch, nrow(r$draws_static)))
  }
  list(draws_static = do.call(rbind, all_static),
       draws_mu = do.call(rbind, all_mu))
}

