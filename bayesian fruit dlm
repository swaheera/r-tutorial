  fc_null_banana <- dlm_forecast_null(null_banana$draws_static, null_banana$draws_mu, h)

  # Option 1 null point estimates
  o1_null_total  <- colMeans(fc_null_total)
  o1_null_share  <- colMeans(inv_logit(fc_null_logit))
  o1_null_apple  <- o1_null_total * o1_null_share
  o1_null_banana <- o1_null_total * (1 - o1_null_share)

  # Option 2 null point estimates
  o2_null_apple  <- colMeans(fc_null_apple)
  o2_null_banana <- colMeans(fc_null_banana)
  o2_null_total  <- o2_null_apple + o2_null_banana
  o2_null_share  <- o2_null_apple / o2_null_total

  make_row <- function(f_idx, test_fy, test_months, test_years, model_name,
                       actual_total, fc_total, actual_apple, fc_apple,
                       actual_banana, fc_banana, actual_share, fc_share,
