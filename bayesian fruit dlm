    o1_fc_share  <- colMeans(inv_logit(d_logit))
    o1_fc_apple  <- o1_fc_total * o1_fc_share
    o1_fc_banana <- o1_fc_total * (1 - o1_fc_share)

    ri1 <- ri1 + 1
    rows_opt1[[ri1]] <- make_row(f_idx, test_fy, test_months, test_years, model_label,
                                 actual_total, o1_fc_total, actual_apple, o1_fc_apple,
                                 actual_banana, o1_fc_banana, actual_share, o1_fc_share,
                                 scen_pct, true_growth_pct)

    # Option 2
    d_apple  <- dlm_forecast_lag(lag_apple$draws_static, lag_apple$draws_mu, X_new_s, K, h)
    d_banana <- dlm_forecast_lag(lag_banana$draws_static, lag_banana$draws_mu, X_new_s, K, h)

    scen_draws_opt2_apple[[as.character(scen_pct)]]  <- d_apple
    scen_draws_opt2_banana[[as.character(scen_pct)]] <- d_banana

    o2_fc_apple  <- colMeans(d_apple)
    o2_fc_banana <- colMeans(d_banana)
    o2_fc_total  <- o2_fc_apple + o2_fc_banana
    o2_fc_share  <- o2_fc_apple / o2_fc_total

    ri2 <- ri2 + 1
    rows_opt2[[ri2]] <- make_row(f_idx, test_fy, test_months, test_years, model_label,
                                 actual_total, o2_fc_total, actual_apple, o2_fc_apple,
                                 actual_banana, o2_fc_banana, actual_share, o2_fc_share,
                                 scen_pct, true_growth_pct)

    if (s %% 10 == 0) {
      cat(sprintf("    scenario %d / %d (%.0f%%)\n", s, n_scenarios, s / n_scenarios * 100))
    }
  }

  # ── MONOTONICITY CHECK ─────────────────────────────────────────────────

  check_scens <- seq(SCENARIO_MIN, SCENARIO_MAX, by = 1)
  check_labels <- as.character(check_scens)

  for (opt_label in c("Option 1 (total+share)", "Option 2 (separate)")) {
    cat(sprintf("\n  === Monotonicity: %s, Fold %d ===\n", opt_label, f_idx))
    all_mono <- TRUE

    for (i in 2:length(check_labels)) {
      lo <- check_labels[i - 1]; hi <- check_labels[i]

      if (opt_label == "Option 1 (total+share)") {
        if (!(lo %in% names(scen_draws_opt1_total)) ||
            !(hi %in% names(scen_draws_opt1_total))) next
        diff_total <- scen_draws_opt1_total[[hi]] - scen_draws_opt1_total[[lo]]
        d_apple_hi <- scen_draws_opt1_total[[hi]] * inv_logit(scen_draws_opt1_logit[[hi]])
        d_apple_lo <- scen_draws_opt1_total[[lo]] * inv_logit(scen_draws_opt1_logit[[lo]])
      } else {
        if (!(lo %in% names(scen_draws_opt2_apple)) ||
            !(hi %in% names(scen_draws_opt2_apple))) next
        diff_total <- (scen_draws_opt2_apple[[hi]] + scen_draws_opt2_banana[[hi]]) -
          (scen_draws_opt2_apple[[lo]] + scen_draws_opt2_banana[[lo]])
        d_apple_hi <- scen_draws_opt2_apple[[hi]]
        d_apple_lo <- scen_draws_opt2_apple[[lo]]
      }

      n_cells <- length(diff_total)
      nv_t <- sum(diff_total < 0)
      nv_a <- sum((d_apple_hi - d_apple_lo) < 0)

      cat(sprintf("    %3s%% vs %3s%%: total viol = %d/%d (%.2f%%), apple viol = %d/%d (%.2f%%)\n",
                  hi, lo, nv_t, n_cells, 100 * nv_t / n_cells,
                  nv_a, n_cells, 100 * nv_a / n_cells))
      if (nv_t > 0 || nv_a > 0) all_mono <- FALSE
    }

    if (all_mono) cat("    PASS: Perfect monotonicity.\n")
    else cat("    NOTE: Minor violations from state noise; mu is guaranteed monotone.\n")

    if (opt_label == "Option 1 (total+share)") {
      mono_results_opt1[[f_idx]] <- list(fold = f_idx, all_mono = all_mono)
    } else {
      mono_results_opt2[[f_idx]] <- list(fold = f_idx, all_mono = all_mono)
    }
  }

  fold_elapsed <- as.numeric(difftime(Sys.time(), t_start, units = "mins"))
  cat(sprintf("\n  Fold %d complete. Elapsed: %.1f min\n", f_idx, fold_elapsed))

  monthly_results_opt1[[f_idx]] <- do.call(rbind, rows_opt1)
  monthly_results_opt2[[f_idx]] <- do.call(rbind, rows_opt2)
}

elapsed_total <- as.numeric(difftime(Sys.time(), t_start, units = "mins"))
cat(sprintf("\n\nAll folds done in %.1f min.\n\n", elapsed_total))

# ══════════════════════════════════════════════════════════════════════════════
# 5. BUILD TABLES (for each option)
# ══════════════════════════════════════════════════════════════════════════════

build_tables <- function(monthly_results, option_label, mono_results) {

  cat(sprintf("\n%s\n  TABLES — %s\n%s\n", strrep("#", 60), option_label, strrep("#", 60)))

  table1 <- do.call(rbind, monthly_results)
  rownames(table1) <- NULL

  cat("TABLE 1 (monthly):", nrow(table1), "rows\n")
  cat("  Sample (first 10):\n")
  print(head(table1, 10), row.names = FALSE)

  table2 <- aggregate(
    cbind(actual_total, forecast_total, actual_apple, forecast_apple,
          actual_banana, forecast_banana) ~
      fold + fiscal_year + model + scenario + true_scenario + scenario_diff,
    data = table1, FUN = sum
  )
  table2$yearly_mape_total  <- round(abs(table2$actual_total - table2$forecast_total) /
                                       abs(table2$actual_total) * 100, 3)
  table2$yearly_mape_apple  <- round(abs(table2$actual_apple - table2$forecast_apple) /
                                       abs(table2$actual_apple) * 100, 3)
  table2$yearly_mape_banana <- round(abs(table2$actual_banana - table2$forecast_banana) /
                                       abs(table2$actual_banana) * 100, 3)
  table2 <- table2[order(table2$yearly_mape_total), ]
  rownames(table2) <- NULL

  cat("\nTABLE 2 (yearly):", nrow(table2), "rows\n")
  cat("  Sample (first 10):\n")
  print(head(table2, 10), row.names = FALSE)

  in_band <- table2[abs(table2$scenario_diff) <= TOLERANCE_PP, ]
  if (nrow(in_band) > 0) {
    yearly_rank <- aggregate(
      cbind(yearly_mape_total, yearly_mape_apple, yearly_mape_banana) ~ model,
      data = in_band, FUN = mean, na.rm = TRUE
    )
    yearly_rank[] <- lapply(yearly_rank, function(x) if (is.numeric(x)) round(x, 3) else x)

    t1_band <- table1[abs(table1$scenario_diff) <= TOLERANCE_PP, ]
    monthly_rank <- aggregate(
      cbind(mape_total, mape_apple, mape_banana) ~ model,
      data = t1_band, FUN = mean, na.rm = TRUE
    )
    names(monthly_rank) <- c("model", "monthly_mape_total", "monthly_mape_apple",
                             "monthly_mape_banana")
    monthly_rank[] <- lapply(monthly_rank, function(x) if (is.numeric(x)) round(x, 3) else x)

    table3 <- merge(yearly_rank, monthly_rank, by = "model")
    table3 <- table3[order(table3$yearly_mape_total), ]
    rownames(table3) <- NULL

    cat(sprintf("\nTABLE 3: Model Ranking within +/- %.1f pp (%d models)\n",
                TOLERANCE_PP, nrow(table3)))
    print(table3, row.names = FALSE)

    cat(sprintf("\n========== SUMMARY [%s] ==========\n", option_label))
    best <- table3[1, ]
    cat(sprintf(">>> Best model: %s\n", best$model))
    cat(sprintf("    Yearly  — total: %.3f%%  apple: %.3f%%  banana: %.3f%%\n",
                best$yearly_mape_total, best$yearly_mape_apple, best$yearly_mape_banana))

    null_row <- table3[table3$model == "null", ]
    if (nrow(null_row) > 0) {
      null_rank <- which(table3$model == "null")
      cat(sprintf("    Null model: #%d / %d  (total MAPE: %.3f%%)\n",
                  null_rank, nrow(table3), null_row$yearly_mape_total))
      if (null_rank > 1) {
        improv <- round((null_row$yearly_mape_total - best$yearly_mape_total) /
                          null_row$yearly_mape_total * 100, 1)
        cat(sprintf("    Improvement vs null: %.1f%%\n", improv))
      }
    }

    cat("\n  MONOTONICITY:\n")
    for (mr in mono_results) {
      if (!is.null(mr)) {
        cat(sprintf("    Fold %d: %s\n", mr$fold,
                    if (mr$all_mono) "PASS" else "Minor violations"))
      }
    }
  }

  invisible(list(table1 = table1, table2 = table2))
}

res_opt1 <- build_tables(monthly_results_opt1,
                         "Option 1: total + logit(share)", mono_results_opt1)
res_opt2 <- build_tables(monthly_results_opt2,
                         "Option 2: apple + banana separately", mono_results_opt2)

cat("\n\n========== OPTION COMPARISON ==========\n")
cat("  Option 1 (total + share): Guarantees coherence (apple + banana = total)\n")
cat("  Option 2 (separate):      No coherence, but each series modeled independently\n")
cat("  Both options enforce monotonicity via truncated priors on population slopes.\n")

cat("\nScript complete.\n")
