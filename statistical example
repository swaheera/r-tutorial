# =============================================================================
# DRAWING HELPERS  (inches from the TOP-LEFT of a 13.333 x 7.5 in page)
# =============================================================================
W <- 13.333; H <- 7.5
X  <- function(x) unit(x, "in"); Y <- function(y) unit(H - y, "in"); IN <- function(v) unit(v, "in")
PT <- function(pt) pt / 0.75

box <- function(x, y, w, h, fill = NA, line = NA, lwd_pt = 0, r = 0) {
  gp <- gpar(fill = fill, col = if (lwd_pt > 0) line else NA, lwd = PT(max(lwd_pt, 0.01)))
  if (r > 0) grid.roundrect(X(x), Y(y), IN(w), IN(h), r = IN(r), just = c("left", "top"), gp = gp)
  else       grid.rect(X(x), Y(y), IN(w), IN(h), just = c("left", "top"), gp = gp)
}
seg <- function(x0, y0, x1, y1, col = RULE, lwd_pt = 1.5)
  grid.segments(X(x0), Y(y0), X(x1), Y(y1), gp = gpar(col = col, lwd = PT(lwd_pt)))

text_w <- function(label, size, bold = FALSE)
  convertWidth(grobWidth(textGrob(label, gp = gpar(fontsize = size, fontfamily = FONT,
               fontface = if (bold) "bold" else "plain"))), "in", valueOnly = TRUE)
fit_size <- function(label, size, bold, avail) {
  avail <- max(avail, 0.01); tw <- text_w(label, size, bold)
  if (tw > avail) size * avail / tw else size
}
# every boxed label shrinks (never grows) until it fits its box, on any device/font
txt <- function(label, x, y, w = 0, h = 0, size = 12, bold = FALSE, col = INK,
                align = "left", valign = "middle", fit = TRUE, pad = 0.04) {
  label <- as.character(label)
  if (fit && w > 0) size <- fit_size(label, size, bold, w - 2 * pad)
  if (fit && h > 0) size <- min(size, 72 * h / 1.05)
  hx <- switch(align, left = x, center = x + w / 2, right = x + w)
  vy <- switch(valign, top = y, middle = y + h / 2, bottom = y + h)
  grid.text(label, X(hx), Y(vy),
            just = c(if (align == "center") "centre" else align, if (valign == "middle") "centre" else valign),
            gp = gpar(fontsize = size, fontface = if (bold) "bold" else "plain", col = col, fontfamily = FONT))
}
rich <- function(pieces, x, y_mid, size, max_w = Inf) {
  total <- sum(sapply(pieces, function(p) text_w(p$text, size, isTRUE(p$bold))))
  if (total > max_w) size <- size * max_w / total
  for (p in pieces) {
    grid.text(p$text, X(x), Y(y_mid), just = c("left", "centre"),
              gp = gpar(fontsize = size, fontface = if (isTRUE(p$bold)) "bold" else "plain",
                        col = p$col, fontfamily = FONT))
    x <- x + text_w(p$text, size, isTRUE(p$bold))
  }
}
wrap <- function(s, width, size, bold = FALSE) {
  words <- strsplit(s, " ", fixed = TRUE)[[1]]; lines <- character(0); cur <- ""
  for (wd in words) {
    cand <- if (cur == "") wd else paste(cur, wd)
    if (cur != "" && text_w(cand, size, bold) > width) { lines <- c(lines, cur); cur <- wd } else cur <- cand
  }
  c(lines, cur)
}
para <- function(s, x, y, w, size, col = INK, lh = 1.25) {
  lines <- wrap(s, w - 0.08, size)
  for (i in seq_along(lines)) txt(lines[i], x, y + (i - 1) * size * lh / 72, w, size * lh / 72, size, FALSE, col, "left", "top")
}
ball <- function(x, y, d, num, lwd_pt = 0.5, size = 6) {
  cl <- jar_color[num]
  grid.circle(X(x + d / 2), Y(y + d / 2), IN(d / 2), gp = gpar(fill = BALL_FILL[[cl]], col = BALL_LINE[[cl]], lwd = PT(lwd_pt)))
  txt(num, x, y, d, d, size = size, bold = TRUE, align = "center", pad = d * 0.12)
}
ring <- function(x, y, d, col = RING_COL, lwd_pt = 2.5)
  grid.circle(X(x + d / 2), Y(y + d / 2), IN(d / 2 + 0.025), gp = gpar(fill = NA, col = col, lwd = PT(lwd_pt)))
title <- function(s) txt(s, 0.4, 0.25, 12.5, 0.6, size = 28, bold = TRUE, valign = "top")

# jar; returns geometry plus a function giving each ball's position
draw_jar <- function(jx, bt, dj, lid_off, lid_h, neck_h, num_size, ring_balls = integer(0)) {
  jw <- 10.5 * dj + 0.16; bh <- 9 * dj * 0.87 + dj + 0.16; jb <- bt + bh
  pos <- function(i) { s <- jar_slot[i]; rw <- s %/% 10; cc <- s %% 10
    c(jx + 0.08 + cc * dj + if (rw %% 2 == 1) dj / 2 else 0, jb - 0.08 - dj - rw * dj * 0.87) }
  box(jx + jw * 0.14, bt - lid_off, jw * 0.72, lid_h, fill = MUTED, r = 0.05)
  box(jx + jw * 0.18, bt - neck_h, jw * 0.64, neck_h, fill = GLASS, line = GLASS_LINE, lwd_pt = 1)
  box(jx, bt, jw, bh, fill = GLASS, line = GLASS_LINE, lwd_pt = 1, r = 0.2)
  for (i in seq_len(N_POP)) { p <- pos(i); ball(p[1], p[2], dj, i, size = num_size) }
  for (i in ring_balls) { p <- pos(i); ring(p[1], p[2], dj) }
  list(jw = jw, jb = jb)
}
callout <- function(x, y, w) {
  box(x, y, w, 0.62, fill = DARK, r = 0.08)
  txt("Sampling without replacement", x, y + 0.09, w, 0.24, 13, TRUE, "#FFFFFF", "center", pad = 0.12)
  txt("no ball can appear twice in the same sample", x, y + 0.33, w, 0.2, 10.5, FALSE, "#E6E8EF", "center", pad = 0.12)
}
jar_caption <- function() {
  n_t <- sum(jar_color == "g"); n_r <- sum(jar_color == "r"); n_b <- sum(jar_color == "b")
  if (TWO_COLOURS) sprintf("%d balls: %d blue \u00b7 %d red", N_POP, n_t, n_r + n_b)
  else             sprintf("%d balls: %d green \u00b7 %d red \u00b7 %d blue", N_POP, n_t, n_r, n_b)
}

# =============================================================================
# SLIDE 1 (drawn in stages)
#   rows_shown:   how many sample-size rows are visible (0-4)
#   first_count:  how many samples of the first row (n = 5) are visible
# =============================================================================
draw_slide1 <- function(rows_shown = 4, first_count = N_SAMPLES) {
  grid.newpage()
  title(sprintf("Goal: estimate the %% of %s balls in the jar from a sample", TARGET))
  revealing <- rows_shown == 1 && first_count < N_SAMPLES && first_count > 0
  newest    <- if (revealing) samples[["5"]][first_count, ] else integer(0)

  jx <- 0.4
  j <- draw_jar(jx, bt = 1.78, dj = 0.232, lid_off = 0.42, lid_h = 0.17, neck_h = 0.25, num_size = 6.5,
                ring_balls = if (SHOW_DRAWN_IN_JAR) newest else integer(0))
  txt("Population: the whole jar", jx, 0.98, j$jw, 0.32, 16, TRUE, align = "center")
  txt(jar_caption(), jx, j$jb + 0.1, j$jw, 0.25, 12, FALSE, MUTED, "center")
  txt(sprintf("Truth: %d%% %s", TRUTH, TARGET), jx, j$jb + 0.36, j$jw, 0.4, 20, TRUE, align = "center")
  callout(jx, j$jb + 0.85, j$jw)
  para(sprintf(paste("Each grey square is one sample: a handful of numbered balls taken from the jar.",
                     "The %% %s in the handful is our estimate. The balls go back before the next sample."), TARGET),
       jx, j$jb + 1.6, j$jw, 12)
  seg(3.05, 1.0, 3.05, 7.25)

  tx0 <- 3.2; tx1 <- 12.95; cellW <- (tx1 - tx0) / 15; d <- 0.106
  hdH <- 0.13; ftH <- 0.17; headH <- 0.24; gapRow <- 0.13
  y <- 0.92
  for (ri in seq_along(SIZES)) {
    n <- SIZES[ri]; m <- samples[[as.character(n)]]; st <- stats[[as.character(n)]]
    rr <- n / 5; trayH <- hdH + rr * d + ftH + 0.03
    if (ri <= rows_shown) {
      count <- if (ri == 1) first_count else N_SAMPLES
      if (ri > 1) seg(tx0, y - gapRow / 2 - 0.01, tx1, y - gapRow / 2 - 0.01)
      pieces <- list(list(text = sprintf("30 samples of size n = %d", n), bold = TRUE, col = INK))
      if (count == N_SAMPLES)                                   # the mean only makes sense once all 30 are in
        pieces <- c(pieces, list(list(text = "   sample mean: ", col = MUTED),
                                 list(text = sprintf("%s%% %s", fmt1(mean(st$pct)), TARGET), bold = TRUE, col = INK)))
      rich(pieces, tx0 + 0.02, y + (headH - 0.04) / 2, 13, max_w = tx1 - tx0 - 0.04)
      for (si in seq_len(count)) {
        cx <- tx0 + ((si - 1) %% 15) * cellW
        cy <- y + headH + ((si - 1) %/% 15) * (trayH + 0.03)
        is_new <- HIGHLIGHT_NEW && revealing && ri == 1 && si == count
        box(cx + 0.015, cy, cellW - 0.03, trayH, fill = GREY,
            line = if (is_new) NEW_LINE else GREY_LINE, lwd_pt = if (is_new) 2 else 0.5, r = 0.03)
        txt(sprintf("Sample #%d", si), cx + 0.015, cy + 0.01, cellW - 0.03, hdH, 6, FALSE, MUTED, "center")
        bx <- cx + (cellW - 5 * d) / 2
        for (k in seq_len(n))
          ball(bx + ((k - 1) %% 5) * d + 0.004, cy + hdH + 0.01 + ((k - 1) %/% 5) * d + 0.004,
               d - 0.008, m[si, k], lwd_pt = 0.25, size = 4.5)
        txt(sprintf("%d%% %s", round(st$pct[si]), TARGET), cx + 0.015, cy + hdH + 0.01 + rr * d,
            cellW - 0.03, ftH, 7, TRUE, align = "center")
      }
    }
    y <- y + headH + 2 * (trayH + 0.03) + gapRow        # keep every row in its final place
  }
}

# =============================================================================
# SLIDE 2 - worked example for n = 5
# =============================================================================
draw_slide2 <- function() {
  grid.newpage()
  title("Worked example: the 30 samples of size n = 5")
  m <- samples[["5"]]; st <- stats[["5"]]
  jx <- 0.4
  j <- draw_jar(jx, bt = 1.6, dj = 0.215, lid_off = 0.36, lid_h = 0.15, neck_h = 0.22, num_size = 6)
  txt("Population: the whole jar", jx, 0.92, j$jw, 0.3, 14, TRUE, align = "center")
  txt(sprintf("Truth: %d%% %s", TRUTH, TARGET), jx, j$jb + 0.1, j$jw, 0.4, 20, TRUE, align = "center")
  callout(jx, j$jb + 0.65, j$jw)
  seg(2.95, 1.0, 2.95, 7.25)

  X0 <- 3.15; X1 <- 12.95; gap <- 0.4
  bw <- (X1 - X0 - gap * (length(MARGINS) - 1)) / length(MARGINS)
  ROWS <- 5; cellW <- bw / 6; d <- 0.145
  hdH <- 0.2; ftH <- 0.26; trayH <- hdH + d + ftH + 0.06; rowGap <- 0.2
  for (qi in seq_along(MARGINS)) {
    t <- MARGINS[qi]; bx0 <- X0 + (qi - 1) * (bw + gap); ok_ids <- within_ids(st, t)
    if (qi > 1) seg(bx0 - gap / 2, 1.0, bx0 - gap / 2, 7.25)
    txt(sprintf("Within \u00b1%d%% of truth?", t), bx0, 0.92, bw, 0.34, 18, TRUE)
    txt(sprintf("How many samples have %d%% to %d%% %s?", max(0, TRUTH - t), TRUTH + t, TARGET), bx0, 1.28, bw, 0.3, 14)
    txt(sprintf("%d of 30", length(ok_ids)), bx0, 1.6, bw, 0.45, 26, TRUE, ORANGE_TXT)
    for (si in seq_len(N_SAMPLES)) {
      ok <- si %in% ok_ids
      cx <- bx0 + ((si - 1) %/% ROWS) * cellW                # columns of 5: #1-5 down the first column
      cy <- 2.2 + ((si - 1) %% ROWS) * (trayH + rowGap)
      box(cx + 0.02, cy, cellW - 0.04, trayH, fill = if (ok) HIT_FILL else GREY,
          line = if (ok) HIT_LINE else GREY_LINE, lwd_pt = if (ok) 1 else 0.5, r = 0.04)
      txt(sprintf("Sample #%d", si), cx + 0.02, cy + 0.01, cellW - 0.04, hdH, 8, FALSE, if (ok) HIT_TXT else MUTED, "center")
      bx <- cx + (cellW - 5 * d) / 2
      for (k in 1:5) ball(bx + (k - 1) * d + 0.005, cy + hdH + 0.025, d - 0.01, m[si, k], lwd_pt = 0.3, size = 5.5)
      txt(sprintf("%d%% %s", round(st$pct[si]), TARGET), cx + 0.02, cy + hdH + d + 0.04, cellW - 0.04, ftH, 9, TRUE, align = "center")
    }
  }
}

# =============================================================================
# SLIDE 3 - summary table
# =============================================================================
draw_slide3 <- function() {
  grid.newpage()
  title("How many of the 30 samples at different sample sizes missed the truth?")
  x0 <- 0.4; y0 <- 1.2; colW <- c(1.53, rep((12.53 - 1.53) / length(MARGINS), length(MARGINS)))
  headH <- 0.75; rowH <- 1.25; pad <- 0.14; colX <- x0 + c(0, cumsum(colW))
  tint <- function(p) { t <- p / 100; rgb(255 - 2 * t, 255 - 59 * t, 255 - 105 * t, maxColorValue = 255) }
  cell <- function(ci, y, h, fill) box(colX[ci], y, colW[ci], h, fill = fill, line = "#FFFFFF", lwd_pt = 1)

  cell(1, y0, headH, INK)
  txt("Sample size", colX[1] + pad, y0, colW[1] - 2 * pad, headH, 16, TRUE, "#FFFFFF")
  for (j in seq_along(MARGINS)) {
    cell(j + 1, y0, headH, INK)
    txt(sprintf("Missed the truth by more than \u00b1%d%%", MARGINS[j]), colX[j + 1], y0, colW[j + 1], headH, 17, TRUE, "#FFFFFF", "center")
  }
  for (ri in seq_along(SIZES)) {
    n <- SIZES[ri]; st <- stats[[as.character(n)]]; y <- y0 + headH + (ri - 1) * rowH
    cell(1, y, rowH, "#FFFFFF")
    txt(sprintf("n = %d", n), colX[1] + pad, y, colW[1] - 2 * pad, rowH, 20, TRUE)
    for (j in seq_along(MARGINS)) {
      out <- missed_ids(st, MARGINS[j]); p <- round(100 * length(out) / N_SAMPLES)
      cell(j + 1, y, rowH, tint(p))
      lst <- if (length(out) == 0) "No samples" else if (length(out) == N_SAMPLES) "All 30 samples" else
        paste0(if (length(out) > 1) "Samples " else "Sample ", paste0("#", out, collapse = ", "))
      lines <- wrap(lst, colW[j + 1] - 2 * pad, 11)
      big_h <- 22 * 1.2 / 72; small_h <- 11 * 1.25 / 72
      top <- y + (rowH - (big_h + length(lines) * small_h)) / 2
      txt(sprintf("%d of 30", length(out)), colX[j + 1], top, colW[j + 1], big_h, 22, TRUE, align = "center")
      for (k in seq_along(lines))
        txt(lines[k], colX[j + 1], top + big_h + (k - 1) * small_h, colW[j + 1], small_h, 11, FALSE, "#4A4F60", "center")
    }
  }
}

