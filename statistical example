row_stats <- function(m) {
  hits <- rowSums(matrix(jar_color[m] == "g", nrow = nrow(m)))
  pct  <- 100 * hits / ncol(m)
  data.frame(sample = seq_len(nrow(m)), hits = hits, pct = pct, err = pct - TRUTH)
}
stats      <- lapply(samples, row_stats)
missed_ids <- function(st, margin) st$sample[abs(st$err) >  margin + 1e-9]
within_ids <- function(st, margin) st$sample[abs(st$err) <= margin + 1e-9]
fmt1       <- function(v) as.character(round(v, 1))

