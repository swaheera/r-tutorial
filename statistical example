frames <- c(
  list(function() draw_slide1(rows_shown = 0)),
  lapply(seq_len(ONE_BY_ONE), function(k) { force(k); function() draw_slide1(rows_shown = 1, first_count = k) }),
  list(function() draw_slide1(rows_shown = 1, first_count = N_SAMPLES),
       function() draw_slide1(rows_shown = 2),
       function() draw_slide1(rows_shown = 3),
       function() draw_slide1(rows_shown = 4))
)
files <- c(sprintf("slide1_frame%02d.png", seq_along(frames)), "slide2.png", "slide3.png")
pages <- c(frames, list(draw_slide2, draw_slide3))

if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
open_png <- function(path) {
  if (capabilities("cairo")) png(path, width = W, height = H, units = "in", res = PNG_DPI, type = "cairo")
  else                       png(path, width = W, height = H, units = "in", res = PNG_DPI)
}
saved <- character(0)
for (i in seq_along(pages)) {
  path <- file.path(OUT_DIR, files[i])
  open_png(path); pages[[i]](); invisible(dev.off())
  saved <- c(saved, normalizePath(path))
}
pdf_path <- file.path(OUT_DIR, "all_slides.pdf")
pdf(pdf_path, width = W, height = H)
for (f in pages) f()
invisible(dev.off())
saved <- c(saved, normalizePath(pdf_path))
results$files <- saved

