sample_tables <- lapply(SIZES, function(n) {
  m <- samples[[as.character(n)]]; st <- stats[[as.character(n)]]
  df <- data.frame(n = n, sample = st$sample,
                   balls = apply(m, 1, function(r) paste(r, collapse = ", ")),
                   target_balls = st$hits,
                   estimate_pct = round(st$pct, 1),
                   off_by_pct = round(abs(st$err), 1))
  for (mg in MARGINS) df[[sprintf("within_%d", mg)]] <- abs(st$err) <= mg + 1e-9
  df
})
